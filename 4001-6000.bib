@CONFERENCE{Musker2025,
	author = {Musker, Sam},
	title = {Transparent AI Without Deception, Limitation, and Guidance},
	year = {2025},
	journal = {ETHICS 2025 - 2025 IEEE International Symposium on Ethics in Engineering, Science, and Technology: Emerging Technologies, Ethics, and Social Justice},
	pages = {},
	doi = {10.1109/ETHICS65148.2025.11098293},
	url = {https://www.scopus.com/pages/publications/105014496844?origin=resultslist},
	affiliations = {Department of Computer Science, Brown University, Providence, United States},
	abstract = {Requiring transparency from experts can backfire, resulting in experts inventing misleading or false justifications for the public (deception) or changing decisions to suboptimal ones that are more easily defended (limitation or guidance). Onora O’Neill and C. Thi Nguyen claim this dynamic occurs with human experts, and multiple authors have applied the same argument to transparent AI. However, little analysis has been done to evaluate whether the argument applies to transparent AI. In this paper we remedy this by examining the extent to which their argument applies to contemporary approaches to transparent AI. We show that many contemporary approaches to enhancing AI transparency, especially post-hoc interpretability methods, are not vulnerable to this dynamic: this is because they do not incentivize changes in AI outputs or alter the deployed version of a model. Nevertheless we show that these problems could in theory or in practice arise in some AI systems, for example in LLMs trained with Reinforcement Learning from Human Feedback over reasoning traces. Deception, limitation, and guidance are therefore not ubiquitous problems in many contemporary approaches to AI transparency, but do pose challenges for certain system designs. ©2025 IEEE.},
	author_keywords = {AI Ethics; Interpretability; Transparent AI},
	keywords = {Artificial intelligence; Systems analysis; AI ethic; AI systems; Human expert; Interpretability; Multiple authors; Reinforcement learnings; Transparent AI; Transparency},
	editor = {Cheong M. and Herkert J. and Zhu Q. and Love H.A.},
