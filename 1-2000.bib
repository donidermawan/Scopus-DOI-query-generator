@CONFERENCE{Komal2025920,
	author = {Komal, Maria and Väänänen, Kaisa},
	title = {Advancing Transparency and Understandability of Urban AI through Interactive Public Displays: Advancing Understandability and Transparency of Urban AI},
	year = {2025},
	journal = {OZCHI 2025 - Proceedings of the 37th Australian Conference on Human-Computer Interaction},
	pages = {920 - 927},
