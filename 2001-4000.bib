	affiliations = {National Taitung University, Computer Science and Information Engineering, Taitung, 950309, Taiwan; Xi’an University of Technology, School of Computer Science and Engineering, Xi’an, 710048, China; National Cheng Kung University, Department of Engineering Science, Tainan, 70142, Taiwan},
	abstract = {As many countries face the challenges of an aging population and declining birth rates, the demand for labor, particularly for assisting the elderly, is increasing. Traditional robots, being standardized products, require engineers to adjust parameters to fit the unique lifestyle of each household, which is time-consuming and inconvenient. However, with the rapid development of artificial intelligence and consumer electronics, there is a growing need for home robots with smarter interfaces to achieve the goal of intelligent living. This paper proposes a home robot based on a trustworthy AI framework, integrated with large language models (LLM). These LLM can perform natural language processing and object recognition, allowing users to control the robot’s operations through natural language commands. This innovation further advances consumer electronics. The robot’s arm can remember these actions and operate according to instructions. Additionally, the robot arm is equipped with monitoring functions, capable of overseeing the operation of other robots and using cameras to detect errors. This development is significant in the field of consumer electronics. The robot also uses Long Short-Term Memory (LSTM) networks to predict the motion paths of the robotic arm, ensuring smooth and efficient operation. This integration of AI and robotics aims to enhance the adaptability and functionality of home robots, making them more suitable for the diverse needs of modern households, improving the quality of life for the elderly, and driving innovation in the consumer electronics field. © 1975-2011 IEEE.},
	author_keywords = {consumer electronics; intelligent automation; large language model; long short-term memory; robotic arm; Trustworthy AI},
	keywords = {Industrial robots; Intelligent robots; Aging population; Home robot; Intelligent automation; Language model; Large language model; Model-based OPC; Natural languages; Robot arms; Short term memory; Trustworthy AI; Robotic arms},
	correspondence_address = {M.-Y. Chen; National Cheng Kung University, Department of Engineering Science, Tainan, 70142, Taiwan; email: mychen119@gs.ncku.edu.tw},
