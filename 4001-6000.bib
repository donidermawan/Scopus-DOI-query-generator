@CONFERENCE{Broomfield202522134,
	author = {Broomfield, Julius and Gibbs, Tom and Kosak-Hine, Ethan and Ingebretsen, George and Nasir, Tia and Zhang, Jason and Iranmanesh, Reihaneh and Pieri, Sara and Rabbany, Reihaneh and Pelrine, Kellin},
	title = {The Structural Safety Generalization Problem},
	year = {2025},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	pages = {22134 - 22173},
