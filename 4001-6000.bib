@CONFERENCE{Alang2025,
	author = {Alang, Karan and Devaraju, Pooja and Tuniki, Raghavender Reddy and Tiwari, Ankur and Sharma, Prateek},
	title = {Explainability-Preserving Compression: Algorithmic Design for Responsible Lightweight AI},
	year = {2025},
	journal = {2025 3rd World Conference on Communication and Computing, WCONF 2025},
	pages = {},
	doi = {10.1109/WCONF64849.2025.11233609},
	url = {https://www.scopus.com/pages/publications/105029735211?origin=resultslist},
	affiliations = {Cupertino, 95014, CA, United States; Kyle, 78640, TX, United States; Celina, 75009, TX, United States; Toronto, M2K 2C2, ON, Canada; Los Angeles, 91214, CA, United States},
	abstract = {Model compression methods have gained popularity with the increase in the need to deploy AI models on edge devices and more resource-constrained settings due to the need to reduce memory, bandwidth and power consumption in these resources. Yet, such approaches are at the cost of interpretability in the compressed model, which is of primary concern in safety-and regulation-sensitive systems. In this paper, the framework that incorporates metric of explainability directly into general compression pipeline is proposed and is called Explainability-Preserving Compression (EPC). We suggest algorithmic approaches that optimize model sparsity, and post-hoc interpretability in a joint manner without loss of predictive accuracy. Our methodology is based on saliency-directed pruning and explainability-sensitive knowledge distillation, which make the models with fewer parameters have important explainability components. The large range of experiments on vision and tabular datasets shows that EPC significantly reduces the model size, by up to an 85 percent reduction, but retains more than 90 percent of the model fidelity in the alignment of feature attributions to those of the original model. The given design presents the basis of responsible lightweight AI, which will make transparent and trustworthy deployment of AI on the limited platforms possible.  © 2025 IEEE.},
	author_keywords = {Explainable AI; Interpretability; Knowledge Distillation; Lightweight Models; Model Compression; Responsible AI; Saliency Maps},
	keywords = {Artificial intelligence; Bandwidth compression; Compaction; Large datasets; Algorithmic design; Compression methods; Explainable AI; Interpretability; Knowledge distillation; Lightweight model; Memory bandwidths; Model compression; Responsible AI; Saliency map; Distillation},
