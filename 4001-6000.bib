@CONFERENCE{Zowghi2025558,
	author = {Zowghi, Didar},
	title = {On the Role of Transparency in Building Inclusive and Trustworthy AI Systems},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 33rd International Requirements Engineering Conference Workshops, REW 2025},
	pages = {558 - 559},
	doi = {10.1109/REW66121.2025.00082},
	url = {https://www.scopus.com/pages/publications/105020982077?origin=resultslist},
	affiliations = {CSIRO's Data61, Eveleigh, Sydney, Australia},
	abstract = {Transparency is widely acknowledged as a foundation of responsible, inclusive, and trustworthy artificial intelligence (AI). This talk examines how transparency requirements can be articulated and operationalised throughout the AI system lifecycle. As a case study, I draw on the Australian Government's mandate requiring public agencies to publish AI transparency statements. Based on an analysis of 100 such statements, I highlight the breadth and depth of interpretations and reveal key patterns and gaps in how transparency is currently understood and communicated. I argue that core practices from requirements engineering; especially continuous stakeholder engagement; can provide a structured foundation for embedding transparency and inclusion into the design, development, and governance of AI systems. This approach moves beyond superficial compliance and toward transparency as a socio-technical commitment grounded in shared understanding and traceable justification.  © 2025 IEEE.},
	author_keywords = {artificial intelligence; transparency},
	keywords = {Artificial intelligence; Life cycle; Requirements engineering; Artificial intelligence systems; Case-studies; Design development; Embedding transparencies; In-buildings; Key Patterns; Public agencies; Requirement engineering; Stakeholder engagement; System lifecycle; Transparency},
	correspondence_address = {D. Zowghi; CSIRO's Data61, Sydney, Eveleigh, Australia; email: Didar.Zowghi@data61.csiro.au},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833153834-7},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Requir. Eng. Conf. Workshops, REW},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Wang20251361,
	author = {Wang, Yunjia and Buysse, Laure and Vanoost, Dries and Pissoort, Davy and Boydens, Jeroen and Verbeke, Mathias},
	title = {AMLOP: A Framework for the Operational Safety Assurance of Machine Learning Leveraging Model Monitoring},
	year = {2025},
	journal = {Proceedings - 2025 IEEE Conference on Artificial Intelligence, CAI 2025},
	pages = {1361 - 1368},
	doi = {10.1109/CAI64502.2025.00248},
	url = {https://www.scopus.com/pages/publications/105011262748?origin=resultslist},
	affiliations = {Department of Computer Science, Dtai, M-Group, Ku Leuven, Belgium; Flanders Make@KU Leuven, Belgium; Department of Electrical Engineering, WaveCoRE, M-Group, Ku Leuven, Belgium; Department of Computer Science, DistriNet, M-Group, Ku Leuven, Belgium},
	abstract = {In recent years, machine learning (ML), including deep learning, has been adopted in various safety-critical domains, such as healthcare, manufacturing, communications and transportation. Despite safety practices implemented during model design and development, unique ML challenges, such as data corruption, data drift, and data anomalies or novelties, can emerge after model deployment. These challenges underscore a pivotal concern: ensuring the operational safety of ML models. Currently standards such as ISO/IEC TR 5469 and IEC 61508 lack comprehensive guidelines for managing these post-deployment challenges across the full ML lifecycle. Moreover, the inherent complexity and lack of transparency in various ML models further contribute to this issue. To bridge this gap, we propose AMLOP, a comprehensive, sevenstage framework specifically designed to assure ML operational safety through systematic model monitoring. This framework is based on four ML monitoring architectures, offering systematic guidance for implementing ML runtime monitoring effectively. The framework's efficacy is demonstrated through a case study on 5G network slicing, presenting its potential to enhance ML operational safety. This framework aligns with global standardization efforts, providing clear guidance toward achieving safe, trustworthy, and robust ML deployments.  © 2025 IEEE.},
	author_keywords = {AI standards; deep learning; machine learning; ML monitoring; safety assurance},
	keywords = {ISO Standards; Learning systems; Life cycle; Safety engineering; AI standard; Deep learning; Leveraging model; Machine learning models; Machine learning monitoring; Machine-learning; Model monitoring; Operational safety; Safety assurance; Deep learning},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833152400-5},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Conf. Artif. Intell., CAI},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access}
}

