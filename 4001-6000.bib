	title = {Fairness-Aware AI in Education: Detecting and Reducing Bias in Student Assessment Systems},
	year = {2025},
	journal = {2025 10th International Conference on Information Technology Trends, ITT 2025},
	pages = {94 - 99},
	doi = {10.1109/ITT69610.2025.11352922},
	url = {https://www.scopus.com/pages/publications/105033624787?origin=resultslist},
	affiliations = {Computer Information Science, Higher Colleges of Technology, Sharjah, United Arab Emirates},
	abstract = {—Artificial intelligence (AI) is increasingly used in education to predict student outcomes, yet concerns remain regarding fairness across demographic and socioeconomic groups. This study develops a fairness-aware predictive framework using the Open University Learning Analytics Dataset (OULAD). A preprocessing pipeline was applied to construct demographic, engagement, and assessment features, and both Logistic Regression and Random Forest models were evaluated. Random Forest achieved the best baseline performance (accuracy = 0.902, recall = 0.933, ROC-AUC = 0.965), but fairness analysis revealed substantial disparities, with students lacking prior qualifications and from lower socioeconomic deciles consistently disadvantaged (disparate impact ratio = 0.25). Two mitigation strategies were examined: pre-processing reweighing preserved accuracy while modestly reducing error rate disparities, and post-processing thresholding substantially improved demographic parity (difference reduced from 0.53 to 0.33; disparate impact ratio raised to 0.45) at the cost of reduced recall. The results highlight the trade-off between predictive sensitivity and equity, underscoring the importance of embedding fairness in educational AI systems. ©2025 IEEE.},
