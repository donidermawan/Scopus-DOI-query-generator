@ARTICLE{Bennett20253283,
	author = {Bennett, S.J. and Catanzariti, Benedetta and Tollon, Fabio},
	title = {“Everybody knows what a pothole is”: representations of work and intelligence in AI practice and governance},
	year = {2025},
