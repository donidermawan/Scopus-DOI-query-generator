@ARTICLE{Fabeyo2025127,
	author = {Fabeyo, Stephen},
	title = {Explainable AI in employment decision-making: a systematic review of transparency methods in hiring algorithms},
	year = {2025},
	journal = {Issues in Information Systems},
	volume = {26},
	number = {3},
	pages = {127 - 135},
	doi = {10.48009/3_iis_2025_2025_110},
