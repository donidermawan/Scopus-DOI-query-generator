	title = {Algorithms and Teacher Autonomy: Pedagogical Resistances to EdTech Standardization in the Age of Generative AI; [Algoritmos y autonomía docente: Resistencias pedagógicas ante la estandarización EdTech en la era de la IA generativa]},
