@ARTICLE{Lushka202585,
	author = {Lushka, Ina},
	title = {Regulating Artificial Intelligence in Democratic Societies: Legal Challenges and Ethical Imperatives for Peace, Development, and Integration},
	year = {2025},
	journal = {Interdisciplinary Journal of Research and Development},
