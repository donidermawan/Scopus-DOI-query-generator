@ARTICLE{Gardner-McTaggart20265043,
	author = {Gardner-McTaggart, Alexander and Blyth, Carmen},
	title = {Ontological capture: AI, childhood, and the algorithmic governance of becoming},
	year = {2026},
	journal = {AI and Society},
	volume = {41},
	number = {5},
	pages = {5043 - 5055},
	doi = {10.1007/s00146-025-02807-8},
	url = {https://www.scopus.com/pages/publications/105026308891?origin=resultslist},
	affiliations = {School of Education and English, University of Nottingham Ningbo China, Ningbo, China},
	abstract = {This article interrogates how algorithmic infrastructures and AI reshape social life through childhood, civic identity, and education. Drawing on Anders’ account of Promethean shame, Baudrillard’s notion of simulation, and Debord’s critique of the spectacle, we argue that predictive platforms do not merely mediate experience but reconstitute its ontological conditions. Attention, temporality, and civic judgement are increasingly compressed into machinic rhythms, producing what we term the algorithmic citizen: a subject habituated to obedience by design. Situating this analysis within debates on digital citizenship, anticipatory governance, and stratified civic subjectivities, we extend prior research on compliance and exclusion into the terrain of ontological capture. In response, the paper develops a stewardship model of leadership, foregrounding silence, ecological embeddedness, and arts-based practices as forms of ontological repair. We conclude by outlining practices of resistance (non-instrumental play, embodied storytelling, and pedagogies of wonder), that sustain civic imagination against algorithmic capture. Our intervention reframes AI in education not as a technical matter but as a societal and ontological problem: what kinds of subjects and futures are being produced in algorithmic societies? © The Author(s) 2025.},
	author_keywords = {Algorithmic governance; Algorithmic subjectivity; Childhood and AI; Digital citizenship; Educational leadership; Ontological capture},
	keywords = {Artificial intelligence; Government data processing; Algorithmic governance; Algorithmic subjectivity; Algorithmics; Childhood and AI; Condition; Digital citizenships; Educational leadership; Ontological capture; Social life; Ontology},
