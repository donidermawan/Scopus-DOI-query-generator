	affiliations = {Universiti Sains Malaysia, School of Management, Penang, 11800, Malaysia},
	abstract = {Artificial intelligence (AI) governance has emerged as a crucial mechanism in ensuring transparency and accountability in corporate digital transformation, particularly in the context of environmental, social, and governance (ESG) disclosures. This study aims to investigate the impact of AI governance mechanisms on ESG disclosure quality using a simulation-based quantitative approach. Synthetic datasets were generated to represent governance features such as transparency, audit rigour, bias monitoring, and feedback loops, and were analysed using advanced machine learning models implemented in Python (Google Colab). Regression analysis with Random Forest, XGBoost, and Artificial Neural Networks (ANN) demonstrated strong predictive accuracy, with the ANN achieving the lowest error scores (MSE = 0.0025, RMSE = 0.0499, MAE = 0.0400), while classification models distinguished disclosure quality tiers effectively, with the Random Forest classifier achieving the highest accuracy (0.89) and F1-score (0.8887). The study concludes that AI governance features significantly shape ESG disclosure quality, providing methodological contributions by combining simulation and machine learning for robust analysis. It recommends extending the approach to hybrid designs using real-world datasets. The practical implication is that corporate boards and regulators can optimise ESG reporting by calibrating AI governance parameters. However, the study is limited by reliance on synthetic data, necessitating empirical validation for broader generalisation.  © 2025 IEEE.},
	author_keywords = {AI governance; digital transformation; ESG disclosure; machine learning; simulation-based methodology},
