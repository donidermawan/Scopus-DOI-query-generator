@CONFERENCE{Shivadekar20251147,
	author = {Shivadekar, Samit},
	title = {Red Teaming LLMs: A Stackelberg Game Approach to AI Safety},
	year = {2025},
	journal = {Proceedings of the 4th International Conference on Innovative Mechanisms for Industry Applications, ICIMIA 2025},
	pages = {1147 - 1154},
	doi = {10.1109/ICIMIA67127.2025.11200929},
	url = {https://www.scopus.com/pages/publications/105021958489?origin=resultslist},
	affiliations = {University Of Maryland, CSEE, Baltimore, MD, United States},
	abstract = {Artificial Intelligence (AI) models such as large language models (LLM) have demonstrated substantial advancements in recent years. Along with capabilities, researchers have started to study the potential risks of AI generated content. These risks encompass reflective bias, toxic outputs, factually incorrect information, and adversarial outputs. However, in these existing works the focus has primarily been on the assessment of AI models not on the analysis of adversarial use-cases of these models. Red teaming research has focused in considerable depth on the adversarial use-case of conventional AI models, however very few works explore in detail the game-theoretic aspects of the red-teaming task for LLMs. LLMs can provide responses to questions posed in natural language, necessitating exploration of ways in which uncommon or non-obvious questions could be generated. Constructing an effective ensemble policy that ensures diversity and uncertainty in the query responses from different LLMs is non-trivial, as it requires a game-theoretic formulation to evaluate the selection of policies. In this work, a novel red teaming game framework (RTG) for LLMs and the Game-Theoretic Red Teaming System (GRTS) solver to balance the textual LLM policies is proposed. GRTS is guaranteed to converge to a Nash equilibrium (NE) when inner iterations converge and also incorporates lie detection for robustness against gradient leakage. The effectiveness of GRTS is demonstrated in extensive experiments in query generation and diverse query selection tasks, as well as a case study showing GRTS-LLM could generate effective adversarial prompts to find zero-shot prompt injection attacks on internal systems of LLMs. © 2025 IEEE.},
	author_keywords = {Adversarial Robustness; AI Safety; Game Theory; GRTS; LLMs; Nash Equilibrium; NE; Red Teaming},
	keywords = {Artificial intelligence; Computation theory; Nash equilibrium; Natural language processing systems; Query processing; Safety engineering; Search engines; Adversarial robustness; Artificial intelligence safety; Game-theoretic; Game-theoretic red teaming system; Intelligence models; LLM; Nash equilibria; Red teaming; Game theory},
	correspondence_address = {S. Shivadekar; University Of Maryland, CSEE, Baltimore, United States; email: samit1@umbc.edu},
