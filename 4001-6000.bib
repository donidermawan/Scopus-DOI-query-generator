@CONFERENCE{Zhou2025537,
	author = {Zhou, Jiehan and Zhang, Hanwei and Feng, Tongtong and Xia, Xiuze},
	title = {Dependable Embodied Intelligence: Toward Trustworthy Integration of Large Language Models and World Models},
	year = {2025},
	journal = {Proceedings - 2025 12th International Conference on Dependable Systems and Their Applications, DSA 2025},
	pages = {537 - 539},
	doi = {10.1109/DSA66321.2025.00071},
	url = {https://www.scopus.com/pages/publications/105032985881?origin=resultslist},
	affiliations = {Shandong University of Science and Technology, Shandong, Qingdao, China; Saarland University, Saarbrücken, Germany; Tsinghua University, Beijing, China; Ocean University of China, Shandong, Qingdao, China},
	abstract = {The development of dependable Embodied Intelligence (EI) is a pivotal step toward transforming Artificial General Intelligence (AGI) into trustworthy physical agency. Unlike virtual AI systems, embodied agents, such as service robots and autonomous vehicles, must operate safely and predictably in dynamic environments, where errors have tangible consequences. Achieving this demands not only intelligence but also measurable dependability in safety, robustness, and accountability under frameworks like the EU AI Act [9]. Large Language Models (LLMs) and World Models (WMs) embody complementary paradigms of intelligence: LLMs provide semantic reasoning and task decomposition, while WMs enable causal prediction and grounded planning. Existing paradigms, i.e., LLM-EI and WM-EI, each face limitations: the former lacks physical grounding and adaptivity, while the latter struggles with abstraction and generalization. Integrating LLMs and WMs within embodied agents (LLM-WM-EI) unites semantic cognition with causal grounding, offering a stronger foundation for general-purpose autonomy. However, this integration introduces new dependability and security challenges. This work advances the discussion from integration to dependable integration, analyzing the emerging threat landscape of LLM-WM-EI systems and outlining principal directions for ensuring their trustworthy, reliable, and accountable operation.  © 2025 IEEE.},
