@ARTICLE{van Zoonen2026795,
	author = {van Zoonen, Ward and von Bonsdorff, Monika E. and van der Heijden, Beatrice I. J. M.},
	title = {Algorithmic surveillance and workers’ compliance: The role of trust, privacy concerns, and fairness in online crowdwork},
	year = {2026},
	journal = {Human Relations},
	volume = {79},
	number = {7},
	pages = {795 - 824},
	doi = {10.1177/00187267251379698},
	url = {https://www.scopus.com/pages/publications/105019344325?origin=resultslist},
	affiliations = {University of Jyväskylä, Finland; Vrije Universiteit, Netherlands; University of Jyväskylä, Finland; Radboud University, Netherlands; Open University of the Netherlands, Netherlands; Ghent University, Belgium; Business School, University of the Free State, South Africa; Kingston University, United Kingdom},
	abstract = {How do workers decide to comply with, alter, or resist algorithmic surveillance? We argue that decontextualization is a key, yet overlooked, mechanism that shapes workers’ responses to algorithmic surveillance. Research has widely critiqued algorithmic surveillance, focusing on diminished worker control and agency. However, the control-resistance mechanisms related to algorithmic surveillance are undertheorized and underexplored. We draw on socio-technical systems theory and micro-level legitimacy to examine mechanisms of surveillance and resistance in online crowdwork. Our findings, based on three-wave data from 435 European online crowdworkers, show that perceived algorithmic surveillance undermines trust and fairness, while increasing privacy concerns, which in turn inform workers’ intentions to comply, alter, or resist algorithmic surveillance. Perceived decontextualization moderates these relationships, exacerbating the adverse effects on trust and fairness while mitigating the effects on privacy concerns. These outcomes extend the view that individual outcomes are shaped by social and technical factors only by demonstrating that perceived decontextualization and micro-level legitimacy judgments—that is, trust, privacy concerns, and fairness—are important socio-technical mechanisms that also impact workers’ compliance. By highlighting the overlooked role of decontextualization in shaping resistance and compliance, this study challenges dominant control-centric narratives and offers a new lens on algorithmic governance. © The Author(s) 2025. This article is distributed under the terms of the Creative Commons Attribution 4.0 License (https://creativecommons.org/licenses/by/4.0/) which permits any use, reproduction and distribution of the work without further permission provided the original work is attributed as specified on the SAGE and Open Access pages (https://us.sagepub.com/en-us/nam/open-access-at-sage).},
	author_keywords = {algorithmic surveillance; compliance intentions; fairness; legitimacy judgments; online crowdwork; perceived decontextualization; privacy concerns; resistance intentions; trust},
	correspondence_address = {W. van Zoonen; Jyväskylä School of Business and Economics, University of Jyväskylä, Jyväskylä, Mattilanniemi 2, 40100, Finland; email: ward.w.vanzoonen@jyu.fi},
	publisher = {SAGE Publications Ltd},
	issn = {00187267},
	language = {English},
