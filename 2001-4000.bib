	coden = {EAAIE},
	language = {English},
	abbrev_source_title = {Eng Appl Artif Intell},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Laflamme2025481,
