@ARTICLE{Wang2025,
	author = {Wang, Xiaodong and Zhu, Zhao and Ma, Pengfei},
	title = {A Platform Service Supply Chain: Interaction Between AI Strategy Adoption and Pricing Mechanism Selection},
	year = {2025},
	journal = {Discrete Dynamics in Nature and Society},
	volume = {2025},
	number = {1},
	pages = {},
	doi = {10.1155/ddns/4433160},
	url = {https://www.scopus.com/pages/publications/105005450995?origin=resultslist},
	affiliations = {Department of Management Engineering, Inner Mongolia Vocational and Technical College of Communications, Inner Mongolia, Chifeng, 024005, China; CCTEG Shenyang Research Institute, Liaoning, Fushun, 113112, China; Procurement Center, CCTEG Shenyang Research Institute, Liaoning, Fushun, 113112, China},
	abstract = {In the operation of service-sharing platforms, artificial intelligence (AI) strategy may or may not be adopted, alongside different pricing mechanism. The interaction between a platform’s decision to adopt the AI strategy and pricing mechanism selection is a valuable area for research. This paper examines the implications of a platform adopting or not adopting the AI strategy, focusing on two mechanisms: service provider pricing and platform pricing. The findings indicate that when consumers have a high sensitivity to the level of intelligent services, the platform should adopt the AI strategy, which may negatively impact the profits of both service providers. Platform pricing is more beneficial for the platform and high-quality service providers, while it reduces the profits of the low-quality service provider. When consumers have a low sensitivity to the level of intelligent services, adopting the AI strategy is more advantageous for the high-quality service provider and the platform itself. In addition, when service providers determine the service prices and consumers have a high sensitivity to the level of intelligent service levels, the platform is inclined to adopt the AI strategy, which may adversely affect the profits of both service providers. Copyright © 2025 Xiaodong Wang et al. Discrete Dynamics in Nature and Society published by John Wiley & Sons Ltd.},
	author_keywords = {artificial intelligence; platform; pricing; service supply chain},
	correspondence_address = {Z. Zhu; CCTEG Shenyang Research Institute, Fushun, Liaoning, 113112, China; email: zhuzhao@syccri.com},
	publisher = {John Wiley and Sons Ltd},
	issn = {10260226},
	language = {English},
	abbrev_source_title = {Discrete Dyn. Nat. Soc.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Chan2025,
