	affiliations = {Florida Polytechnic University, Department of Computer Science, Lakeland, FL, United States; Florida Polytechnic University, Department of Data Science and Business Analytics, Lakeland, FL, United States},
	abstract = {Major Depressive Disorder (MDD) is a widespread mental health condition that profoundly affects individuals globally. Electroencephalography (EEG) signals have shown promise as biomarkers for MDD diagnosis, yet the adoption of machine learning models in clinical practice is often hindered by their lack of interpretability. This paper introduces the Context-Aware Electrode Weighting (CAEW) layer, a novel framework that dynamically adjusts the importance of different electrodes based on their relevance to the model's predictions. We demonstrate that this framework improves the accuracy of MDD diagnosis by allowing the model to better capture spatial relationships within EEG data. Furthermore, the CAEW provides intuitive visualizations that offer clear insights into the model's decision-making process, enabling healthcare professionals to understand which regions of the brain contribute most to the predictions. By enhancing both the accuracy and interpretability of EEG- based models, this paper aims to pave the way for more trustworthy AI -driven solutions in clinical MDD diagnosis. © 2025 IEEE.},
