@BOOK{Rokhshad2025165,
	author = {Rokhshad, Rata and Ducret, Maxime and Seifi, Sara and Mansouri, Melika and Schwendicke, Falk},
	title = {Artificial Intelligence: Limitations, Safety, and Regulatory Considerations in Dentistry},
	year = {2025},
	journal = {Artificial Intelligence for Oral Health Care: Applications and Future Prospects},
	pages = {165 - 171},
	doi = {10.1007/978-3-031-84047-0_11},
	url = {https://www.scopus.com/pages/publications/105006959984?origin=resultslist},
	affiliations = {Pediatric Dentistry Resident, Department of Pediatric Dentistry, Loma Linda School of Dentistry, Loma Linda, CA, United States; Topic Group Dental Diagnostics and Digital Dentistry, ITU/WHO Focus Group AI on Health, Berlin, Germany; Faculty of Odontology, University Claude Bernard Lyon 11, University of Lyon, Lyon, France; Student Research Committee, Faculty of Dentistry, Mazandaran University of Medical Sciences, Sari, Iran; School of Dentistry, Shahid Beheshti University of Medical Sciences, Tehran, Iran; Conservative Dentistry and Periodontology, LMU Klinikum, LMU, Munich, Germany},
	abstract = {New technologies like artificial intelligence (AI) have profound ethical implications. AI encompasses diverse capabilities that aim to mimic human intelligence through algorithmic techniques. Integrating AI into healthcare has gained traction and is particularly evident in dentistry, where AI adoption is on the rise. Across dentistry domains, ethics remains pivotal as AI finds multifaceted applications. AI analysis of radiographs and images yields clinically relevant insights. In orthodontics, AI identifies landmarks, classifies malocclusions, and forecasts growth trajectories. In cariology, AI aids in diagnosing and classifying carious lesions. In oral and maxillofacial surgery, AI enhances surgical planning and detects anomalies. While AI heralds promise in dentistry, it brings intricate ethical quandaries. Ethics examines human behavior’s morality, correctness, and potential harm. It encompasses normative ethics (appropriate actions, virtue ethics, consequentialism), meta-ethics (the essence of right and wrong), and applied ethics (principles in real-life situations). AI-based healthcare raises ethical concerns, including respect for autonomy, decision-making, privacy protection, accountability and responsibility, transparency, equity, diversity, prudence, solidarity, law and governance, sustainable development, and wellness. Resolving AI ethical issues requires health AI ethics guidelines encompassing applied, normative, and meta-ethics. Ethics principles include transparency, privacy, nonmaleficence, diversity, beneficence, responsibility, equity, patient autonomy, and justice. A robust framework is imperative to ensure AI safe and ethical application. This chapter overviews the ethical issues when AI is used in dentistry. It discusses the ethical questions and duties dental professionals face when using AI in their work. © The Editor(s) (if applicable) and The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	keywords = {Ethical technology; Surgery; Algorithmic techniques; Ethical implications; Ethical issues; Growth trajectories; Human intelligence; Intelligence analysis; Oral and maxillofacial surgeries; Regulatory considerations; Safety considerations; Surgical planning; Dentistry},
	publisher = {Springer Nature},
	isbn = {978-303184047-0; 978-303184046-3},
	language = {English},
	abbrev_source_title = {Artificial Intelligence for Oral Health Care: Applications and Future Prospects},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

