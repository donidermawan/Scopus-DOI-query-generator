	keywords = {Diagnosis; Diseases; Health care; Medical image processing; Algorithmic fairness; Algorithmics; Bias; Deep learning; Early diagnosis; Global health; Health equity; Health issues; Oral cancer; Oral cancer detection; Deep learning},
