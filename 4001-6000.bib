@CONFERENCE{Loganathan2025,
	author = {Loganathan, Manochitra and Sharifzadeh, Hamid and Keivanmarz, Ali},
	title = {Towards Improving Fairness in AI Systems: A Framework for Bias Mitigation},
	year = {2025},
	journal = {2025 IEEE Region 10 Symposium: Innovations in Technology: Shaping the Future, TENSYMP 2025},
	pages = {},
	doi = {10.1109/TENSYMP63728.2025.11145004},
	url = {https://www.scopus.com/pages/publications/105017118256?origin=resultslist},
	affiliations = {School of Computing, Unitec Institute of Technology, Auckland, New Zealand},
	abstract = {Artificial Intelligence (AI) is widely used in critical decision-making, but biases in training data can lead to unfair outcomes, particularly for historically marginalised groups. Ensuring fairness in AI is globally important, as biased decisions can exacerbate social and economic inequalities. While international policies promote fairness, structured approaches to achieving it remain limited, and the impact of data-balancing methods on fairness is not well understood. This research presents a structured framework for improving AI fairness using IBM's AI Fairness 360 (AIF360) toolkit, applied to the Adult Census Income dataset, a standard benchmark for fairness evaluation. Fairness is assessed using Statistical Parity Difference (SPD) and Disparate Impact (DI), alongside bias mitigation techniques such as Reweighing and Adversarial Debiasing (ADB), and Calibrated Equalised Odds (CEO). The paper also evaluates the impact of the Synthetic Minority Over-sampling Technique (SMOTE) variants on fairness. The framework is tested across multiple models, including Random Forest (RF), Extreme Gradient Boosting (XGBoost), Light Gradient Boosting Machine (LightGBM), and Tabular Neural Network (TabNet). Results show that the proposed framework significantly improves fairness without compromising model performance. However, certain SMOTE variants unintentionally increase disparities, emphasising the importance of applying targeted and systematic bias mitigation strategies in AI development. © 2025 IEEE.},
	author_keywords = {AI fairness; AIF360; Algorithmic bias; Artificial intelligence; Bias mitigation; SMOTE},
	keywords = {Balancing; Benchmarking; Decision making; Ethical technology; AI fairness 360; Algorithmic bias; Algorithmics; Artificial intelligence fairness; Artificial intelligence systems; Bias mitigation; Decisions makings; Gradient boosting; Synthetic minority over-sampling techniques; Training data; Artificial intelligence},
