	year = {2025},
	journal = {Proceedings - 2025 10th International Conference on Cyber Security and Information Engineering, ICCSIE 2025},
	pages = {290 - 294},
	doi = {10.1109/ICCSIE65832.2025.00055},
	url = {https://www.scopus.com/pages/publications/105033987919?origin=resultslist},
	affiliations = {Chongqing Special Equipment Inspection and Research Institute, Chongqing, China},
	abstract = {This study introduces a hybrid artificial intelligence (AI) framework that integrates digital radiographic (DR) imaging with deep learning to accurately analyze the impact resistance performance of pressure pipelines. Utilizing Convolutional Neural Networks (CNNs) for spatial feature extraction and Long Short-Term Memory (LSTM) networks for temporal sequence modeling, the framework effectively processes DR images for defect detection and impact resistance prediction. A synthetic numerical database was constructed using parameterized Abaqus simulations to replicate various defect geometries and dynamic impact conditions, providing robust training data. Graphics Processing Unit (GPU)-accelerated training, optimized with CUDA and mixed-precision techniques, reduced inference time by 65%, enabling real-time predictions. The framework achieved an accuracy of 89.7%, validated through ROC curve analysis, and demonstrated its ability to classify defects with high precision. SHapley Additive exPlanations (SHAP) analysis was incorporated to interpret model outputs, identifying porosity and defect geometry as critical factors influencing structural failure mechanisms. This integration ensures transparency and actionable insights for defect-driven failure analysis. By leveraging DR images as direct inputs, this framework eliminates the reliance on complex physical models, offering a scalable, efficient, and interpretable solution for real-time pipeline monitoring and structural health assessment in safety-critical environments. © 2025 IEEE.},
	author_keywords = {Defect Analysis; Digital Radiographic Testing; GPU Acceleration; Impact Resistance; Neural Networks; Structural Health Monitoring},
	keywords = {ABAQUS; Acceleration; Computer graphics; Convolutional neural networks; Deep learning; Defects; Digital radio; Failure (mechanical); Failure analysis; Graphics processing unit; Image analysis; Pipelines; Program processors; Radiography; Structural health monitoring; Defect analysis; Digital radiographic testing; Graphic processing unit acceleration; Graphics processing; Health monitoring; Impact resistance performance; Neural-networks; Processing units; Radiographic testing; Structural health; Impact resistance},
