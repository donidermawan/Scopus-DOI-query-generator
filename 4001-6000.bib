@CONFERENCE{Aurongzeb20251254,
	author = {Aurongzeb, Deeder},
	title = {Trustworthy AI for Resource-Constrained Edge: A Trust Degradation Mode Effect Analysis (TDMEA) Framework},
	year = {2025},
	journal = {2025 3rd International Conference on Foundation and Large Language Models, FLLM 2025},
	pages = {1254 - 1259},
