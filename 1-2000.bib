@ARTICLE{Ahsen2025,
	author = {Ahsen, Mehmet Eren and Ayvaci, Mehmet U. S. and Mookerjee, Radha and Stolovitzky, Gustavo},
	title = {Economics of AI and human task sharing for decision making in screening mammography},
	year = {2025},
	journal = {Nature Communications },
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41467-025-57409-1},
	url = {https://www.scopus.com/pages/publications/86000348244?origin=resultslist},
	affiliations = {Department of Business Administration, University of Illinois at Urbana-Champaign, Champaign, United States; Department of Biomedical and Translational Sciences, University of Illinois at Urbana-Champaign, Champaign, United States; Jindal School of Management, University of Texas at Dallas, Richardson, United States; Department of Pathology, NYU Grossman School of Medicine, New York, New York, NY, United States; Biomedical Data Sciences Hub, NYU Langone Health, New York, NY, United States},
	abstract = {The rising global incidence of breast cancer and the persistent shortage of specialized radiologists have heightened the demand for innovative solutions in mammography screening. Artificial intelligence (AI) has emerged as a promising tool to bridge this demand-supply gap, with potential applications ranging from full automation to integrated AI-human decision-making. This study evaluates the economic feasibility of incorporating artificial intelligence (AI) into mammography screening within healthcare settings, considering full or partial integration. To evaluate the economic viability, we employ an optimization model specifically designed to minimize mammography screening costs. This model considers three distinct approaches when interpreting mammograms: automation strategy utilizing AI exclusively, delegation strategy involving the selective allocation of tasks between radiologists and AI, and the expert-alone strategy relying solely on radiologist decisions. Our findings underscore the significance of disease prevalence in relation to the trade-off between costs associated with false positives (e.g., follow-up expenses) and false negatives (e.g., litigation costs stemming from missed diagnoses) in shaping the AI strategy for healthcare organizations. We backtest our approach using data from an AI contest in which participants aimed to match or surpass radiologists’ performance in assessing screening mammograms for women. The contest data supports the optimality of the delegation strategy, potentially leading to cost savings of 17.5% to 30.1% compared to relying solely on human experts. Our research provides guidance for healthcare organizations considering AI integration in mammography screening, with broader implications for work design and human-AI hybrid solutions in various fields. © The Author(s) 2025.},
	keywords = {Artificial Intelligence; Breast Neoplasms; Decision Making; Early Detection of Cancer; Female; Humans; Mammography; Mass Screening; Middle Aged; Radiologists; artificial intelligence; cancer; decision making; disease prevalence; health care; research work; womens health; Article; artificial intelligence; automation; breast cancer; clinical decision making; clinical practice; controlled study; cost control; crowdsourcing; false negative result; false positive result; female; health care cost; health care organization; health economics; human; law suit; major clinical study; mammography; missed diagnosis; prediction; prevalence; radiologist; task sharing; breast tumor; decision making; diagnostic imaging; early cancer diagnosis; economics; mass screening; middle aged; procedures},
