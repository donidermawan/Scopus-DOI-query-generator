@CONFERENCE{Syed2025,
	author = {Syed, Toqeer Ali and Almutairi, Mishal Ateeq and Moaty, Mahmoud Abdel},
	title = {Cross-Agent Multimodal Provenance-Aware Framework for Robust Prompt Injection Defense in Large Language and Vision-Language Models},
	year = {2025},
	journal = {International Conference on Computer and Applications, ICCA 2025 - Proceedings},
	pages = {},
	doi = {10.1109/ICCA66035.2025.11430791},
	url = {https://www.scopus.com/pages/publications/105037000522?origin=resultslist},
	affiliations = {Islamic University of Madinah, Faculty of Computer and Information System, Madinah, Saudi Arabia; Arab Open University-Bahrain, Faculty of Computer and Information System, Faculty of Computer Science, A'Ali, Bahrain},
	abstract = {Large Language Models (LLMs), VisionLanguage Models (VLMs), and new agentic AI systems (e.g., LangChain and GraphChain) allow autonomous systems to reason and plan, and to coordinate between an assortment of tools and agents. Nevertheless, this feature also brings vulnerability to multimodal prompt injection (PI) attacks, in which hidden or malicious instructions that are embedded in text, images, metadata, or interagent messages can spread throughout the agent graph, triggering unintended behavior or policy violation, or corrupting a state. To mitigate these threats, this paper will present a Cross-Agent Multimodal Provenance-Aware Defense Framework that will sanitize any user- or agent-generated prompts and validate the output of the LLM independently, prior to their delivery to downstream nodes. The framework incorporates a text sanitizer agent, visual sanitizer agent and an output validator agent which are synchronized by a provenance ledger which documents modality, source and trust metadata throughout the agent network. The architecture implements ordered trust boundaries, so that an injected instruction cannot spread out via LangChain- or GraphChain-style workflows. There are better multimodal PI detection accuracy, lower trust leakage between agents, and more stable agentic execution pathways, all of which are experimentalized. This framework can build secure, interpretable, and reliable agentic AI systems by augmenting the established provenance tracking and validation systems to multi-agent orchestration. © 2025 IEEE.},
	author_keywords = {AI Safety; LLM Security; Multi-Agent Systems; Prompt Injection; Provenance Tracking; Trust Validation},
	keywords = {Autonomous agents; Intelligent agents; Metadata; Network security; Visual languages; AI safety; AI systems; Language model; Large language model security; Model security; Multi-modal; Multiagent systems (MASs); Prompt injection; Provenance tracking; Trust validation; Multi agent systems},
	correspondence_address = {T.A. Syed; Islamic University of Madinah, Faculty of Computer and Information System, Madinah, Saudi Arabia; email: toqeer@iu.edu.sa},
