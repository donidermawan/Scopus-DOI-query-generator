	title = {No-Code Edge Artificial Intelligence Frameworks Comparison Using a Multi-Sensor Predictive Maintenance Dataset},
	year = {2025},
	journal = {Big Data and Cognitive Computing},
	volume = {9},
	number = {6},
	pages = {},
	doi = {10.3390/bdcc9060145},
	url = {https://www.scopus.com/pages/publications/105009300382?origin=resultslist},
	affiliations = {Robotics and Technology of Computers Laboratory, ETSII-EPS, Universidad de Sevilla, Sevilla, 41004, Spain; Smart Computer Systems Research and Engineering Laboratory (SCORE), I3US, Universidad de Sevilla, Sevilla, 41012, Spain},
	abstract = {Edge Computing (EC) is one of the proposed solutions to address the problems that the industry is facing when implementing Predictive Maintenance (PdM) implementations that can benefit from Edge Artificial Intelligence (Edge AI) systems. In this work, we have compared six of the most popular no-code Edge AI frameworks in the market. The comparison considers economic cost, the number of features, usability, and performance. We used a combination of the analytic hierarchy process (AHP) and the technique for order performance by similarity to the ideal solution (TOPSIS) to compare the frameworks. We consulted ten independent experts on Edge AI, four employed in industry and the other six in academia. These experts defined the importance of each criterion by deciding the weights of TOPSIS using AHP. We performed two different classification tests on each framework platform using data from a public dataset for PdM on biomedical equipment. Magnetometer data were used for test 1, and accelerometer data were used for test 2. We obtained the F1 score, flash memory, and latency metrics. There was a high level of consensus between the worlds of academia and industry when assigning the weights. Therefore, the overall comparison ranked the analyzed frameworks similarly. NanoEdgeAIStudio ranked first when considering all weights and industry only weights, and Edge Impulse was the first option when using academia only weights. In terms of performance, there is room for improvement in most frameworks, as they did not reach the metrics of the previously developed custom Edge AI solution. We identified some limitations that should be fixed to improve the comparison method in the future, like adding weights to the feature criteria or increasing the number and variety of performance tests. © 2025 by the authors.},
	author_keywords = {AHP; Edge AI; no-code; Predictive Maintenance; TOPSIS},
	keywords = {Analytic hierarchy process; Biomedical equipment; Edge computing; Flash memory; Predictive maintenance; Analytic hierarchy; Edge artificial intelligence; Framework comparisons; Hierarchy process; Ideal solutions; Multi sensor; No-code; Performance; Predictive maintenance; Technique for order performance by similarity to the ideal solution; Hierarchical systems},
