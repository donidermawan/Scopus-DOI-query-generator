@BOOK{Joshua2025459,
	author = {Joshua, Bapu J. and Saranya, N. and Chacko, Jose P. and Suresh, Kumar K. and Jayachandran, T. and Girimurugan, R. and Mallik, Biswadip Basu},
	title = {Safeguarding Security and Privacy in the Business Sector: The Role of AI and ML},
	year = {2025},
	journal = {Advanced Mathematics in Computing, Communication and Security},
	pages = {459 - 484},
	doi = {10.1002/9781394307302.ch21},
	url = {https://www.scopus.com/pages/publications/105026430447?origin=resultslist},
	affiliations = {Department of Electronics and Communication Engineering, Dr. Sivanthi Aditanar College of Engineering, Tamil Nadu, Tiruchendur, India; Department of Computer Science and Business Systems, Bannari Amman Institute of Technology, Tamil Nadu, Sathyamangalam, India; Department of Economics, St. Aloysius College, Kerala, Thrissur, India; Department of MBA, Panimalar Engineering College, Tamil Nadu, Chennai, India; Department of Electronics and Communication Engineering, Nandha Engineering College, Tamil Nadu, Perundurai, India; Department of Mechanical Engineering, Nandha College of Technology, Tamil Nadu, Perundurai, India; Department of Basic Science and Humanities, Institute of Engineering & Management (School of University of Engineering and Management), Kolkata, India},
	abstract = {The ethical responsibilities that businesses should bear when using generative artificial intelligence (AI) are discussed in this article. When businesses jump on the bandwagon for generative artificial intelligence solutions or fall for the “AI hype,” they put themselves at danger of cyberattacks. While generative AI solu-tions’ purported advantages have received a lot of attention, the dangers that come with using them have received far less attention. Worries that sufficient safeguards are being overlooked in the haste to incorporate generative AI are on the rise. Companies could be leaving themselves vulnerable to widespread and potentially disastrous cyber-attacks or breaches when they hastily invest in generative AI to stay ahead of the competition. Some of the major cyber security risks that generative AI models provide are the possibility of ‘backdoors,’ which might allow unauthorized access to user data, and the danger of ‘poisoned,’ which could cause AI models to produce inaccurate findings. We address the ethical responsibilities of incorporating generative AI into businesses in the light of these CS concerns by taking into account the concepts of justice, autonomy, non-maleficence, beneficence, and explicability. A company’s susceptibility to cyber security (CS) risks can be significantly impacted by two instances of ethical concern that we’ve identified: over-trust and over-reliance in generative Artificial Intelligence. According to the discussed moral obligations and ethical concerns, this study finishes by proposing a series of criteria for the ethical application of generative AI in commercial environments. The goal is to minimize cyber security risk. © 2026 Scrivener Publishing LLC.},
