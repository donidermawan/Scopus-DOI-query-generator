	title = {Reframing Financial Forecasting with Information Processing Theory: A Conceptual AI Framework},
	year = {2025},
	journal = {2025 IEEE 16th Annual Information Technology, Electronics and Mobile Communication Conference, IEMCON 2025},
	pages = {28 - 33},
	doi = {10.1109/IEMCON67450.2025.11381263},
	url = {https://www.scopus.com/pages/publications/105034708443?origin=resultslist},
	affiliations = {University of North Texas, Denton, TX, United States},
	abstract = {Deep learning methods such as Bidirectional LSTM (BiLSTM) have been widely applied to financial forecasting [1], [2], [3], yet most studies focus on predictive accuracy and technical optimization. Less attention has been given to the conceptual foundations of how AI systems process financial information and support decision-making. This paper introduces a conceptual framework for stock forecasting grounded in Information Processing Theory (IPT). We adapt IPT stages of attention, encoding, storage, and retrieval to describe how a forecasting pipeline can be structured around three layers: a Data Layer for OHLCV time series and engineered indicators, a Machine Learning Layer using BiLSTM-based modeling, and an AI Analyst Layer that communicates structured outputs for decision support. By aligning this architecture with IPT, we argue that AI forecasting systems can be understood as structured information processors that parallel aspects of human reasoning while contributing to, rather than replacing, analyst expertise. The framework provides a theoretical basis for considering issues such as transparency, interpretability, and reliance, and establishes a foundation for future empirical investigations of AI applications in finance. © 2025 IEEE.},
