	pages = {740 - 744},
	doi = {10.1109/AEECA65693.2025.00134},
	url = {https://www.scopus.com/pages/publications/105035024416?origin=resultslist},
	affiliations = {Beijing Xingyun Digital Technology Co., Ltd, Beijing, China},
	abstract = {The rapid advancement of autonomous driving intensifies the demand for perception systems that are accurate, robust, and deployable in real time under diverse and challenging conditions. Existing real-time detectors, including You Only Look Once version 8 (YOLOv8), often struggle with small-object recall, calibration quality, and robustness in adverse environments, while transformer-based or Non-Maximum Suppression (NMS)-free models remain computationally costly for embedded deployment. To address these gaps, this study proposes an enhanced YOLOv8-based framework integrating a dynamic exposure, deghosting preprocessor, a Multi-Scale Hybrid Pyramid (MS-HP) neck with deformable receptive fields, and an uncertainty-aware joint loss function. Post-hoc temperature scaling and a trust-gating reliability module are employed to calibrate confidence scores and suppress overconfident false positives. Evaluated on nuScenes-camera, BDD100K, and Waymo Open datasets, the framework achieves state-of-the-art mean Average Precision (mAP) while maintaining real-time speed, improves small-object detection by up to 5.8%, and significantly reduces Expected Calibration Error (ECE) without notable latency overhead. Robustness tests confirm reduced performance degradation under noise, blur, and weather perturbations, and cross-dataset validation shows strong generalization. This work advances the design of embedded-friendly, trustworthy AI for autonomous driving, offering both academic insight into multi-scale deformable feature aggregation with reliability filtering and practical benefits for safer, more reliable intelligent transportation systems. © 2025 IEEE.},
	author_keywords = {autonomous driving; multi-scale feature fusion; real-time object detection; trustworthy AI; YOLOv8},
