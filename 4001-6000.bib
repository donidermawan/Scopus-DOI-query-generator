	title = {Alignment Problem as Cultural and Legal Challenge: Artificial Intelligence, Interpretability, and Searching for Sense; [Problem dostosowania jako wyzwanie kulturowe i prawne. Sztuczna inteligencja, interpretowalność i poszukiwanie sensu]},
	year = {2025},
	journal = {Studia Iuridica Lublinensia},
	volume = {34},
