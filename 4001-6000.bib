@CONFERENCE{Padmavathi2025,
	author = {Padmavathi, A. and Pandit, Bikrant and Khaitan, Gungun},
	title = {Lightweight Self-Consistency Voting Framework for Reliable Hallucination Detection in LLMs},
	year = {2025},
	journal = {2025 12th International Conference on Reliability, Infocom Technologies and Optimization ,Trends and Future Directions, ICRITO 2025},
	pages = {},
	doi = {10.1109/ICRITO66076.2025.11241896},
	url = {https://www.scopus.com/pages/publications/105029877027?origin=resultslist},
	affiliations = {Amrita Vishwa Vidyapeetham, Department of Computer Science and Engineering, Chennai, India},
	abstract = {Large Language Models(LLMs) such as ChatGPT have shown impressive ability in producing human-like text, but they continue to produce text that may sound realistic yet be completely false - an issue referred to as hallucination. Such mistakes can have serious consequences when such models are deployed for routine tasks such as responding to factual questions, helping with research, or providing recommendations in sensitive areas like law and health. This paper discusses a straightforward and useful solution: a light-weight self-consistency voting system aimed at reliably identifying hallucinations without the weight of sophisticated external fact-checking. On each input prompt, the system self-generates multiple responses and verifies their consistency, marking responses with significant contradiction as potential unreliable ones. In contrast to heavyweight detection techniques, this technique is easy to install, not reliant on external databases, and integrates natively as an add-on to any existing model without the need for access to its internal states. A proof-of-concept experiment on factual questions indicates that this consistency voting mechanism is able to effectively detect factually wrong outputs with little to no additional cost and overhead. This paper shows that a simple self-assessment is able to substantially enhance the reliability of LLMs for real-world deployment and provides a solid basis for constructing more responsible AI systems.  © 2025 IEEE.},
	author_keywords = {Fact Verification; Hallucination Detection; Large Language Models; Responsible AI; Self-Consistency},
	keywords = {Human computer interaction; Information systems; Information use; Fact verification; Hallucination detection; Human like; Language model; Large language model; Light weight; Responsible AI; Self-consistency; Sensitive area; Voting systems; Artificial intelligence},
	editor = {Shukla B. and Khatri S.K. and Agarwal R. and Soni K.M. and Singh A.V. and Jain S. and Gautam R. and Rastogi A. and Arora S.},
