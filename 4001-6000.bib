}

@CONFERENCE{Alkhudhayr20251199,
	author = {Alkhudhayr, Hanadi},
	title = {Privacy-Preserving IoT Systems with Explainable Artificial Intelligence for Energy-Efficient Smart Homes},
	year = {2025},
	journal = {2025 IEEE International Conference on Communication Networks and Computing, CNC 2025},
	pages = {1199 - 1205},
	doi = {10.1109/CNC68716.2025.11484973},
	url = {https://www.scopus.com/pages/publications/105038056742?origin=resultslist},
	affiliations = {King Abdulaziz University, Faculty of Computing and Information Technology, Department of Information Systems, Rabigh, 21911, Saudi Arabia},
	abstract = {The rapid advancement of Internet of Things (IoT) devices has transformed modern living by enabling intelligent, data-driven smart-home environments. Artificial Intelligence (AI) applications are increasingly central to achieving optimal energy use and accurate activity detection; however, concerns regarding privacy, transparency, and interpretability continue to hinder user adoption. This paper presents a privacy-preserving, explainable AI (XAI) framework that enhances both functional performance and consumer trust in IoT-based smart homes. A randomized controlled experiment was conducted across 50 households, stratified by size and energy consumption. The proposed system integrates edge-cloud AI with Differential Privacy (DP, ϵ = 1.0-2.0) and SHAP-based model explainability, employing Temporal Convolutional Networks (TCN) and Gradient-Boosted Decision Trees (GBDT) for temporal data modeling and classification. Statistical analyses using ANOVA and regression (α = 0.05) indicate an 11 % increase in classification accuracy (F1 = 0.78 → 0.89), a 17 % reduction in household energy consumption, and sub-145 ms inference latency. Post-deployment surveys show a 30 % increase in user trust, demonstrating that explainable privacy mechanisms can balance performance, efficiency, and ethical compliance. The framework provides a scalable, transparent, and responsible AI model for energy-efficient smart homes.  © 2025 IEEE.},
