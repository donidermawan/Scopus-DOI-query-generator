	pages = {},
	doi = {10.1109/ISAECT68904.2025.11318751},
	url = {https://www.scopus.com/pages/publications/105032674853?origin=resultslist},
	affiliations = {Manipal Institute of Technology, Manipal Academy of Higher Education, Karnataka, 576104, India; VIT-AP University, School of Electronics Engineering, Andhra Pradesh, Amaravati, 522241, India; Deemed to be University, Siddhartha Academy of Higher Education, Department of Computer Science and Engineering, Andhra Pradesh, Vijayawada, 520007, India; Andhra Loyola College (Autonomous), Department of Business Administration, Andhra Pradesh, Vijayawada, 520008, India},
	abstract = {Machine learning (ML) has revolutionized numerous domains by enabling systems to learn from vast data and make intelligent decisions. However, as ML systems are increasingly integrated into sensitive data-driven applications, concerns regarding data privacy are increasing. Critical challenges arise when users request the removal of their data from these applications. Traditional data removal approaches typically involve retraining models from scratch after excluding the targeted data, which is computationally expensive and operationally inefficient. To address this, machine unlearning is emerging as a promising solution, offering mechanisms to selectively and efficiently erase particular data samples without retraining the entire model. This is encouraged by regulatory frameworks, namely the General Data Protection Regulation (GDPR), which enforces the "Right to be Forgotten,"mandating that individuals can request the deletion of their data from digital systems. Thus, machine unlearning has gained significant attention in recent years. But a broad analysis of research trends in this domain has not received greater attention. Thus, this paper presents a systematic bibliometric analysis using Scopus data, examining scientific production, key publication sources, leading countries/institutions, top-cited papers, and keyword trends to reveal emerging research directions. © 2025 IEEE.},
	author_keywords = {Data Privacy; Deep Learning; Machine Unlearning; Responsible AI; Right to Be Forgotten},
	keywords = {Laws and legislation; Learning systems; Privacy-preserving techniques; Sensitive data; Data-driven applications; Deep learning; Intelligent decisions; Learn+; Machine learning systems; Machine unlearning; Machine-learning; Privacy preserving; Responsible AI; Right to be forgotten; Deep learning},
