	affiliations = {Maastricht University, Minderbroedersberg 4-6, Maastricht, 6211 LK, Netherlands; University of Naples Federico II, Via Porta di Massa, 1, Naples, 80133, Italy; Fondazione Mondo Digitale, Via del Quadraro 102, Rome, 00174, Italy; University of West Attica, Agiou Spiridonos 28, Egaleo, 122 43, Greece},
