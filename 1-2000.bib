@ARTICLE{Li2025656,
	author = {Li, Huayu and He, Zhengxiao and Chen, Xiwen and Zhang, Ci and Quan, Stuart F. and Killgore, William D. S. and Wung, Shu-Fen and Chen, Chen X. and Yuan, Geng and Lu, Jin and Li, Ao},
