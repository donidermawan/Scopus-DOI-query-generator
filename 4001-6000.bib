@CONFERENCE{Khan2025,
	author = {Khan, Muhammad Ismaeel and Arif, Aftab and Khan, Ali Raza A. and Hafeez, Ihtasham and Farooq, Umer},
	title = {Explainable AI for Compliance-Driven Security Incident Response},
	year = {2025},
	journal = {2nd Asian Conference on Intelligent Technologies, ACOIT 2025},
	pages = {},
	doi = {10.1109/ACOIT66109.2025.11436697},
