	keywords = {Artificial intelligence; Cost reduction; Decision making; Edge computing; Efficiency; Federated learning; Network security; Optimization; Privacy-preserving techniques; Trusted computing; Central servers; Communication efficiency; Communication frequency; Communication overheads; Interpretability; Learning frameworks; Model pruning; Privacy preserving; Responsible artificial intelligence; Trustworthy federated learning; Internet of things},
