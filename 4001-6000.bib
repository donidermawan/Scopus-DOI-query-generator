	year = {2025},
	journal = {International Conference on NexGen Networks and Cybernetics, IC2NC 2025 - Proceedings},
	pages = {496 - 502},
	doi = {10.1109/IC2NC67409.2025.11376383},
	url = {https://www.scopus.com/pages/publications/105035608189?origin=resultslist},
	affiliations = {Karpagam Academy of Higher Education, Department of Computer Science and Design, Coimbatore, India; Karpagam Academy of Higher Education, Department of Cyber Security, Coimbatore, India},
	abstract = {Agricultural productivity is often threatened by foliage diseases that weaken plant health and reduce yield quality. Manual inspection remains the standard practice for disease identification, yet it requires expert knowledge, consumes significant time, and is not readily available in rural farming contexts. Advanced artificial intelligence methods such as deep convolutional networks have shown promise in agricultural diagnostics, but many of these solutions are computationally intensive and unsuitable for low-resource environments. To bridge this gap, an integrated lightweight framework for guava leaf disease prediction and sustainable management has been developed. The system employs a compressed convolutional neural network combined with a probabilistic assessment module to enhance reliability while maintaining efficiency. The Guava Leaf Disease Dataset (GLDD) was utilized, with a curated subset of 2,500 images across four categories: anthracnose, healthy, insect bite, and scorch. Images are standardized through preprocessing techniques, including resizing, normalization, and augmentation, to strengthen model generalization. Experimental results indicate consistent classification performance above 85% accuracy, with each prediction generated in under three seconds on a standard laptop. Beyond detection, the framework provides actionable recommendations promoting eco-friendly treatments and reduced chemical reliance. These findings highlight the framework's practical value as a low-cost, accessible, and sustainable solution for both academic research and community-level agricultural applications. © 2025 IEEE.},
