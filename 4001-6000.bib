@ARTICLE{Li20262391,
	author = {Li, Zhichao and Lyu, Mengxue and Li, Lujia and Huang, Jilin},
	title = {The complex influence of scientific literacy on the perception of AI risks: nonlinear relationship, moderating factors, and mechanisms},
	year = {2026},
	journal = {Information Communication and Society},
	volume = {29},
	number = {8},
	pages = {2391 - 2411},
	doi = {10.1080/1369118X.2025.2565359},
	url = {https://www.scopus.com/pages/publications/105018181018?origin=resultslist},
	affiliations = {School of International and Public Affairs, Shanghai Jiao Tong University, Shanghai, China; School of Emergency Management, Shanghai Jiao Tong University, Shanghai, China; Key Laboratory of Urban Complex Risk Control and Resilience Governance, Shanghai Emergency Management Bureau, Shanghai, China},
	abstract = {This study is based on the improved Unified Theory of Acceptance and Use of Technology model (UTAUT). It explores how scientific literacy influences the public’s risk perception of artificial intelligence, with a focus on two key aspects: the mediating role of personal relevance and the moderating effects of four factors–technological familiarity, perceived safety, perceived transparency, and respect for scientific authority. Through a cross–sectional survey of the American public (N = 4769), this study reveals the non–linear association among personal interests, technological literacy, and risk perception. First, scientific literacy does not directly affect the public’s risk perception of artificial intelligence. Instead, it exerts an indirect influence through personal relevance–higher levels of personal relevance significantly reduce the public’s risk perception of artificial intelligence. Second, the pathway through which scientific literacy influences risk perception of artificial intelligence via personal relevance can only be activated when technological familiarity, perceived safety, perceived transparency, or respect for scientific authority reaches a high level. This indicates that contextual factors are essential for scientific literacy to play a role in reducing risk perception. Third, demographic variables such as age and education do not change the above significant relationships between variables. This study provides insights for stakeholders including policymakers, science communicators, technology enterprises, and educators, to advance an AI-enabled human-centric world and offer guidance for AI risk governance. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {artificial intelligence; human-centric AI; moderated mediation; personal relevance; Risk perception; technological literacy},
	correspondence_address = {J. Huang; School of International and Public Affairs, Shanghai Jiao Tong University, Shanghai, No.1954 Huashan Road, China; email: jilinhuang@sjtu.edu.cn},
	publisher = {Routledge},
