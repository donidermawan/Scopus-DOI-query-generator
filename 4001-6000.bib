@BOOK{Strang202548,
	author = {Strang, Kenneth David and Vajjhala, Narasimha Rao},
	title = {Unethical AI in democratic systems},
	year = {2025},
	journal = {AI and the Future of Democracy: Building Resilient and Inclusive Societies},
	pages = {48 - 61},
	doi = {10.1201/9781003594185-3},
	url = {https://www.scopus.com/pages/publications/105024281586?origin=resultslist},
	affiliations = {University of the Cumberlands, United States; Computer Science Department, American University in Bulgaria (AUBG), Bulgaria; Center for Information, Democracy, and Citizenship (CIDC), AUBG, Bulgaria; ACM and IEEE, Bulgaria; Center for Information, Democracy, and Citizenship (CIDC), AUBG, Project Management Institute (PMI), Bulgaria},
	abstract = {This chapter addresses the critical research question of identifying risks for unethical use of AI in democratic systems, with particular emphasis on underdeveloped, strained, or stressed societies. Using a critical analysis methodology combined with machine learning validation, we investigate how the ubiquitous nature of AI technology creates both opportunities and threats for democratic governance. Our analysis reveals five distinct categories of unethical AI applications that pose significant risks to democratic integrity: AI-disinformation, AI-electoral-interference, AI-HR-manipulation, AI-unethical-culture, and AI-privacy-invasion AI-electoral-interference represents direct threats to democratic processes through voter suppression, credential manipulation, and electoral outcome alteration. AI-HR-manipulation perpetuates systemic inequalities through biased recruitment and organizational decision-making processes. The AI-unethical-culture category reveals how AI can exploit cultural dimensions such as uncertainty avoidance index (UAI) and personality factors (OCEAN/HEXACO models) to manipulate public opinion at scale. Finally, AI-privacy-invasion demonstrates unprecedented surveillance capabilities that compromise individual privacy and political freedom. Our findings indicate that developing nations face heightened vulnerabilities due to limited technological infrastructure, reduced institutional safeguards, and cultural factors that increase susceptibility to AI manipulation. The convergence of AI accessibility through smartphones and democratic vulnerabilities creates particularly dangerous conditions for less developed societies. The chapter concludes with policy recommendations for strengthening democratic resilience against AI threats, including rapid response capabilities for disinformation detection, enhanced electoral cybersecurity, cultural-aware AI governance frameworks, and strengthened privacy protections. These findings contribute to the growing body of literature on AI governance and democratic security in an increasingly connected world. © 2026 Taylor & Francis Group, LLC.},
	keywords = {Artificial intelligence; Cybersecurity; Decision making; Differential privacy; Electronic voting; Ethical aspects; Social aspects; AI applications; AI Technologies; Critical analysis; Critical researches; Democratic process; Democratic systems; Machine-learning; Organizational decision making; Privacy invasions; Research questions; Risk assessment},
	publisher = {CRC Press},
	isbn = {978-104059681-4; 978-103297530-6},
	language = {English},
	abbrev_source_title = {AI and the Future of Democracy: Building Resilient and Incl. Societies},
	type = {Book chapter},
	publication_stage = {Final},
