	year = {2025},
	journal = {CINTI 2025 - IEEE 25th International Symposium on Computational Intelligence and Informatics, Proceedings},
	pages = {739 - 746},
	doi = {10.1109/CINTI67731.2025.11311842},
	url = {https://www.scopus.com/pages/publications/105032746051?origin=resultslist},
	affiliations = {Canterbury Christ Church University, Computing AI and Cyber security, Canterbury, United Kingdom},
	abstract = {Ambient Assisted Living (AAL) systems rely on intelligent vision-based models for human activity recognition to support elderly care and independent living. However, their adoption is often hindered by the lack of explainability in deep learning models. This paper presents an explainable artificial intelligence (XAI) framework that integrates Gradient-weighted Class Activation Mapping (Grad-CAM) with hybrid visualisation techniques to enhance interpretability and transparency in AAL image classification. Two baseline Convolutional Neural Network (CNN) models were initially developed but achieved limited accuracy (<30%), prompting the use of MobileNetV2 for improved feature extraction and efficiency. The proposed framework combines Grad-CAM with complementary methods - Saliency, Occlusion, Integrated Gradients, LIME, Simple Language Explanations, and Score-CAM - to visualise both correct and incorrect predictions. Experimental results on a 15-class human activity dataset show that Grad-CAM+Occlusion produced the most precise and localized heatmaps, achieving the highest visual-clarity score (5.96 on a 1-6 scale) among all hybrid techniques. The findings highlight the importance of hybrid explainability in building user-trustworthy AI systems for safety-critical healthcare applications. Future work will focus on extending this framework with multi-model explainability and human-in-the-loop validation for adaptive A A L environments. © 2025 IEEE.},
	author_keywords = {Ambient Assisted Living (AAL); Explainable Artificial Intelligence (XAI); Human Activity Recognition Grad-CAM; Human-Centred AI; MobileNetV2},
