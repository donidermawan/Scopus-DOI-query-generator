	affiliations = {Department of Library and Information Technology, Federal University of Technology, Akwa Ibom, Nigeria; Library Department, College of Education, Warri, Nigeria; Library Department, Delta State Maritime Polytechnic, Burutu, Nigeria; Department of Library and Information Science, Prince Abubakar Audu University, Anyigba, Nigeria},
	abstract = {The emergence of Industry 5.0 has necessitated the urgent need for new literacies among information professionals. This paper explores the intersection of prompt engineering skills and AI literacy as critical competencies for librarians operating in a post-automation era. Drawing on a PRISMA-guided narrative literature review, the paper thematically analyzes current discourse on how librarians are transitioning from traditional custodians of information to dynamic facilitators of AI-integrated services. The study reveals that prompt engineering enables more accurate information retrieval, instructional design, and metadata generation. Likewise, AI literacy encompasses conceptual understanding, ethical awareness, and applied skills necessary for navigating emerging digital ecosystems. The paper argues that continuous professional development, ethical policy frameworks, and curricular integration are essential to building AI-literate librarianship. It further identifies practical models for implementing prompt engineering in library settings and outlines a future-oriented vision for sustainable information practice. The implications for policy and practice include the need for continuing professional development, ethical AI governance frameworks, and curricular revisions to integrate prompt engineering in librarianship. © 2025 The Author(s). Published with license by Taylor & Francis Group, LLC.},
