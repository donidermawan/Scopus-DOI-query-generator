	pages = {749 - 765},
	doi = {10.1080/1206212X.2025.2531033},
	url = {https://www.scopus.com/pages/publications/105012246143?origin=resultslist},
	affiliations = {Department of Mathematics and Computer Science, Faculty of Exact Sciences, Tahri Mohamed University, Bechar, Algeria; Artificial Intelligence House, Tahri Mohamed University, Bechar, Algeria; Innovations in Informatics and Engineering Laboratory (INIE LAB), Tahri Mohamed University, Bechar, Algeria; Coding and Information Security Laboratory (LACOSI), USTO–MB, Oran, Algeria; Stanford University, CA, United States},
	abstract = {Intrusion detection in Industrial Internet of Things (IIoT) systems is critical for protecting essential infrastructure from cyber threats. This paper introduces a novel multistage optimization framework designed to enhance intrusion detection accuracy. The first stage employs a Hybrid ACO-GA/PSO algorithm for feature selection, ensuring the retention of the most relevant features to improve classification precision. In the second stage, Long Short Term Memory (LSTM) networks are optimized using a combination of the Bat Algorithm and the Whale Optimization Algorithm, enabling precise fine-tuning of hyper-parameters to maximize model performance. A Generative Adversarial Network (GAN) is incorporated in the final evaluation stage, testing the model's robustness against previously unseen data, followed by training the generated data on the optimized LSTM model. To further interpret and explain the results, we apply Explainable AI (XAI) techniques, including SHAP and LIME, providing insight into feature importance and model decision-making. Our approach is evaluated with standard performance metrics, demonstrating significant improvements in detection accuracy and validating the efficacy of our hybrid framework for advancing IIoT security mechanisms. Highlights Multi-Stage Optimization Framework Hybrid Feature Selection Fine-tuned LSTM Model GAN for Robustness Testing Explainable AI (XAI) Integration. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {explainable artificial intelligence; generative artificial intelligence; hybrid feature selection; Industrial internet of things; intrusion detection},
	keywords = {Decision making; Feature extraction; Generative adversarial networks; Integration testing; Internet of things; Long short-term memory; Network security; Optimization; Adversarial networks; Detection accuracy; Explainable artificial intelligence; Generative artificial intelligence; Hybrid feature selections; Industrial internet of thing; Intrusion-Detection; Multi-stage optimization; Optimization framework; Short term memory; Intrusion detection},
