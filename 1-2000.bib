@ARTICLE{Fareed2025429,
	author = {Fareed, Muhammad and Rehman, Shafiq Ur},
	title = {Enhancing Consumer Trust in AI-Created Goods: The Roles of Transparency, Simplicity, Familiarity and Authenticity in Market Integration},
	year = {2025},
