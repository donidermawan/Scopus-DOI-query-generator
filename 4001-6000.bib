	title = {Multimodal Ai Framework for Early Detection and Precision Management of Rheumatoid Arthritis},
	year = {2025},
	journal = {Proceedings of the 2025 3rd International Conference on Advances in Computation, Communication and Information Technology, ICAICCIT 2025},
	pages = {95 - 100},
	doi = {10.1109/ICAICCIT68829.2025.11434467},
	url = {https://www.scopus.com/pages/publications/105036154436?origin=resultslist},
	affiliations = {R.M.K. Engineering College, Department of Artificial Intelligence and Datascience, Tamilnadu, India; Saveetha Engineering College, Department of Computer Science and Engineering, Chennai, India; R.M.K College of Engineering and Technology, Department of Electronics & Communication Engineering, Chennai, India; R.M.D. Engineering College, Department of Science & Humanities (General Engineering), Thiruvallur, India},
	abstract = {Rheumatoid arthritis (RA) is a chronic autoimmune disease marked by synovial inflammation, progressive joint damage, pain, and reduced quality of life. Early identification and individualized management significantly decrease irreversible disability and systemic complications. Conventional diagnostic workflows rely on isolated clinical assessments, serology, and occasional imaging. This siloed approach misses subtle early inflammatory signals, fails to exploit temporal patterns from wearables and longitudinal records, and yields variable treatment responses due to interpatient heterogeneity. We present a multimodal AI framework that ingests longitudinal electronic health records (EHR), laboratory biomarkers (RF, anti-CCP, CRP/ESR), musculoskeletal imaging (radiographs and ultrasound), wearable sensor time-series, and patient-reported outcomes. Preprocessing harmonizes heterogeneous formats and aligns timelines. Modality-specific encoders (convolutional neural networks for images, Transformer-based encoders for textual and tabular EHR, temporal CNN/GRU modules for sensor data) produce embeddings that are fused via an attention-guided fusion module and calibrated ensembling. It supports scalable clinical deployment widely. Using a multimodal pipeline integrating imaging, laboratory, and clinical notes, the proposed method outperforms three state-of-the-art approaches (CNN-RA, Random Forest Ensemble, and BERTClinical) with an accuracy of 94.7%, precision of 93.1%, recall of 92.8%, F1-score of 92.9% and AUC-ROC of 0.96 over 100 rounds of testing. © 2025 IEEE.},
	author_keywords = {6G networks; digital precoding; Early Detection; massive Rheumatoid Arthritis; Multimodal AI; Personalized Treatment; Predictive Modeling; spectral efficiency; support vector machine},
	keywords = {Convolutional neural networks; Diagnosis; Diseases; Electronic health record; Medical computing; Medical imaging; Signal encoding; Wearable sensors; 6g network; Digital precoding; Early detection; Massive rheumatoid arthritis; Multi-modal; Multimodal AI; Personalized treatment; Precoding; Predictive models; Rheumatoid arthritis; Spectral efficiencies; Support vectors machine; Support vector machines},
