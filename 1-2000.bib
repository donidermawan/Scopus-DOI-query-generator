@ARTICLE{Schlicker2025,
	author = {Schlicker, Nadine and Baum, Kevin and Uhde, Alarith and Sterz, Sarah and Hirsch, Martin C. and Langer, Markus},
	title = {How do we assess the trustworthiness of AI? Introducing the trustworthiness assessment model (TrAM)},
	year = {2025},
	journal = {Computers in Human Behavior},
	volume = {170},
	pages = {},
	doi = {10.1016/j.chb.2025.108671},
	url = {https://www.scopus.com/pages/publications/105003992120?origin=resultslist},
	affiliations = {Philipps University of Marburg, Germany; Deutsches Forschungszentrum für Künstliche Intelligenz GmbH (DFKI), Germany; Ritsumeikan University, Japan; Saarland University, Germany; Albert-Ludwig University of Freiburg, Germany},
	abstract = {Designing trustworthy AI-based systems and enabling external parties to accurately assess the trustworthiness of these systems are crucial objectives. Only if trustors assess system trustworthiness accurately, they can base their trust on adequate expectations about the system and reasonably rely on or reject its outputs. However, the process by which trustors assess a system's actual trustworthiness to arrive at their perceived trustworthiness remains underexplored. In this paper, we conceptually distinguish between actual and perceived trustworthiness, trust propensity, trust, and trusting behavior. Drawing on psychological models of how humans assess other people's characteristics, we present the two-level Trustworthiness Assessment Model (TrAM). At the micro level, we propose that trustors assess system trustworthiness based on cues associated with the system. The accuracy of this assessment depends on cue relevance and availability on the system's side, and on cue detection and utilization on the human's side. At the macro level, we propose that individual micro-level trustworthiness assessments propagate across different trustors – one stakeholder's trustworthiness assessment of a system affects other stakeholders' trustworthiness assessments of the same system. The TrAM advances existing models of trust and sheds light on factors influencing the (accuracy of) trustworthiness assessments. It contributes to theoretical clarity in trust research, has implications for the measurement of trust-related variables, and practical implications for system design, stakeholder training, AI alignment, and AI regulation related to trustworthiness assessments. © 2025 The Authors},
	author_keywords = {Calibrated trust; Human-centered design; Trust in automation; Trustworthiness; Trustworthy AI},
	keywords = {Assessment models; Calibrated trust; Human-centred designs; Measurements of; Micro level; Psychological model; Trust in automation; Trusting behaviors; Trustworthiness; Trustworthy AI; adult; aged; article; automation; diagnosis; human; psychological model; trustworthiness; universal design; User centered design},
	correspondence_address = {N. Schlicker; Philipps-Universität Marburg, Institute for AI in Medicine, Marburg, Baldingerstraße, 35043, Germany; email: nadine.schlicker@uni-marburg.de; M. Langer; Albert-Ludwigs-Universität Freiburg, Department of Psychology, Section Work and Organizational Psychology, Freiburg, Engelbergerstraße 41, 79085, Germany; email: markus.langer@psychologie.uni-freiburg.de},
