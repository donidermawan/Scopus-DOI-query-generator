@CONFERENCE{Pavlo2025193,
	author = {Pavlo, Tanasyuk and Oleksii, Padun},
	title = {AI-Driven Assistance for Astronauts: Enhancing Decision-Making and Mission Efficiency},
	year = {2025},
	journal = {Proceedings of the International Astronautical Congress, IAC},
	pages = {193 - 202},
	doi = {10.52202/083083-0024},
	url = {https://www.scopus.com/pages/publications/105032633625?origin=resultslist},
	abstract = {This paper argues that crewed spaceflight beyond low-Earth orbit requires new paradigms of decision-making under conditions of uncertainty, latency, and cognitive stress. Traditionally, astronauts have relied on procedural training and ground-based mission control (Kanas and Manzey, 2008). However, forthcoming missions to the lunar surface and eventually Mars will demand greater autonomy due to communication delays and operational complexity (Nesnas et al., 2021; NASA, 2015). The author develops a theoretical framework for AI-driven astronaut assistance as a complement to human judgment in high-risk operational environments. The argument proceeds in three stages. First, the paper identifies the core advantages of AI integration, including the detection of interdependencies across spacecraft subsystems (Frank, 2014), predictive foresight through prognostics and trend analysis, structured guidance that mitigates cognitive overload (Clancey, 2014), and adaptive training tailored to crew performance (Manzey and Lorenz, 1998). Second, it interrogates the risks and challenges, notably the dangers of overreliance (Dekker, 2014), opacity of algorithmic reasoning (Doshi-Velez and Kim, 2017), vulnerability to system failures or adversarial inputs (Amodei et al., 2016), and the delicate balance of trust in human–machine teaming (Lee and See, 2004). Third, it outlines a roadmap for operationalisation, drawing on mixed-initiative planning (Johnson et al., 2014), explainability frameworks (Miller, 2019), and assurance regimes adapted from civil aviation safety (EASA, 2023). The contribution is explicitly theoretical. The author contends that AI assistance can be understood as a normative decision model that combines probabilistic reasoning, constraint satisfaction, and utility analysis; a formal template for explainable recommendations in time-critical scenarios; and a conceptual architecture for assured autonomy that is auditable and certifiable. In doing so, the paper integrates perspectives from human factors research, artificial intelligence safety, and aerospace systems engineering. The findings suggest that AI-driven assistance should not be conceived as a pathway to full autonomy but rather as an augmentation of human agency — a form of “crew multiplicity” that strengthens decision resilience without eroding accountability. The author emphasises that this claim applies specifically to human spaceflight, where trust and accountability remain central; for future robotic missions, by contrast, one might envision the evolution of fully autonomous AI models. By situating AI as a transparent, bounded, and human-centred partner, the paper argues that future lunar and Martian missions can achieve higher safety margins and mission efficiency while maintaining the primacy of human judgment. © 2025 International Astronautical Federation, IAF. All rights reserved.},
	keywords = {Artificial intelligence; Behavioral research; Decision making; Earth (planet); Human engineering; Lunar missions; Manned space flight; Orbits; Risk assessment; Safety engineering; Communication delays; Condition; Decisions makings; Earth orbits; Ground based; Human judgments; Lunar surface; Mission control; Operational complexity; Uncertainty; NASA},
	publisher = {International Astronautical Federation, IAF},
	issn = {00741795},
	isbn = {979-833132931-0},
	language = {English},
	abbrev_source_title = {Proc. Int. Astronaut. Congr., IAC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

