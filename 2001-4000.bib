@CONFERENCE{Bansal2025,
	author = {Bansal, Mahak and Nagal, Kritika and Sharma, Rakhee},
	title = {Ensuring Fairness in Artificial General Intelligence: A Review of Real-Time Ethical Monitoring Frameworks},
	year = {2025},
	journal = {Proceedings of the 2025 12th International Conference on Computing for Sustainable Global Development, INDIACom 2025},
	pages = {},
