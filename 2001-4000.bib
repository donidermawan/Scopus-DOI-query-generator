@CONFERENCE{Balayn2025,
	author = {Balayn, Agathe and Yurrita, Mireia and Rancourt, Fanny and Casati, Fabio and Gadiraju, Ujwal},
	title = {Unpacking Trust Dynamics in the LLM Supply Chain: An Empirical Exploration to Foster Trustworthy LLM Production & Use},
	year = {2025},
	journal = {Conference on Human Factors in Computing Systems - Proceedings },
	pages = {},
	doi = {10.1145/3706598.3713787},
	url = {https://www.scopus.com/pages/publications/105005722152?origin=resultslist},
	affiliations = {ServiceNow, Amsterdam, Netherlands; Trento University, Trento, Italy; Delft University of Technology, Delft, Netherlands; ServiceNow, Montreal, QC, Canada; University of Trento, Trento, Italy; ServiceNow, Zurich, Switzerland; Web Information Systems, Delft University of Technology, Delft, Netherlands},
	abstract = {Research on trust in AI is limited to several trustors (e.g., end-users) and trustees (especially AI systems), and empirical explorations remain in laboratory settings, overlooking factors that impact trust relations in the real world. Here, we broaden the scope of research by accounting for the supply chains that AI systems are part of. To this end, we present insights from an in-situ, empirical, study of LLM supply chains. We conducted interviews with 71 practitioners, and analyzed their (collaborative) practices using the lens of trust drawing from literature in organizational psychology. Our work reveals complex trust dynamics at the junctions of the chains, with interactions between diverse technical artifacts, individuals, or organizations. These junctions might constitute terrain for uncalibrated reliance when trustors lack supply chain knowledge or power dynamics are at play. Our findings bear implications for AI researchers and policymakers to promote AI governance that fosters calibrated trust. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {AI supply chain; calibrated trust; collaborations; large language models; trust in AI},
	keywords = {AI supply chain; AI systems; Calibrated trust; Collaboration; End-users; Language model; Large language model; Real-world; Trust dynamics; Trust in AI; Mergers and acquisitions},
	publisher = {Association for Computing Machinery},
	isbn = {979-840071394-1},
	language = {English},
