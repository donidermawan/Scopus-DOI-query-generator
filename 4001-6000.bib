	affiliations = {Universiti Putra Malaysia, Faculty of Computer Science and Information Technology, Malaysia; Vishwakarma University, Department of Computer Engineering, Pune, India; S-VYASA Deemed to be University, Faculty of Engineering and Technology, School of Advanced Studies, Bengaluru, India; S-VYASA Deemed to be University, Department of Computer Science and Applications, Bengaluru, India},
	abstract = {The emergence of 6G networks introduces unprecedented demands for ultra-reliable, low-latency communication to support mission-critical applications such as autonomous vehicles, telesurgery, and industrial automation. Efficient and trustworthy network slice management is essential to meet these requirements. However, existing AI-driven approaches often lack explainability, adaptability, and compliance with domain-specific constraints - posing risks in safety-critical environments.This paper proposes a novel Neuro-Symbolic AI framework that integrates deep learning with symbolic reasoning to enable real-time, explainable 6G network slice optimization. The system leverages neural models for traffic prediction and user mobility analysis, while a symbolic knowledge graph encodes policies, constraints, and service-level agreements (SLAs). This hybrid approach allows for dynamic slice reconfiguration with transparent, human-readable justifications.We evaluate the framework in a simulated 6G environment featuring autonomous vehicle platoons and remote surgical operations. Compared to baseline deep learning and rule-based systems, our method achieves a 38% improvement in reconfiguration speed and a 27% reduction in SLA violations. Additionally, the symbolic layer enhances interpretability, enabling operators to audit and trust AI-driven decisions.The proposed architecture bridges the gap between performance and explainability in 6G network management, offering a scalable and policy-compliant solution for intelligent resource allocation in mission-critical scenarios. © 2025 IEEE.},
