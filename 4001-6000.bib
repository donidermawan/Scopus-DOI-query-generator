@ARTICLE{Gülten2025,
	author = {Gülten, Ezgi and Derin, Okan and Arslan, Eyüp and Atasoy Tahtasakal, Ceren and Temoçin, Fatih and Memişoğlu, Funda and Aktuğ Demir, Nazlım},
	title = {From awareness to action: A nationwide survey of infectious diseases and clinical microbiology physicians’ perspectives on artificial intelligence in clinical practice},
	year = {2025},
