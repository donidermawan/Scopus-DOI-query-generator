	affiliations = {Foundation for Research and Technology - Hellas (FORTH), Heraklion, Crete, Greece; University of Crete, Heraklion, Greece; University of Central Florida, Orlando, FL, United States; Purdue University, West Lafayette, IN, United States; Tsinghua University, Beijing, China; Kyushu University, Fukuoka, Japan; Singapore Management University, Singapore; Chongqing University, Chongqing, China},
