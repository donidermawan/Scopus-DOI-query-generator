@CONFERENCE{Gladiné2025627,
	author = {Gladiné, Jan and Van Acker, Bert and Denil, Joachim},
	title = {Towards Safety in Machine Learning Using Validity Frames},
	year = {2025},
	journal = {Proceedings - 2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems Companion, MODELS-C 2025},
	pages = {627 - 635},
