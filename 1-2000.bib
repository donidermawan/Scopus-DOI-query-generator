	title = {DetectAnyLLM: Towards Generalizable and Robust Detection of Machine-Generated Text Across Domains and Models},
	year = {2025},
	journal = {MM 2025 - Proceedings of the 33rd ACM International Conference on Multimedia, Co-Located with MM 2025},
