@BOOK{Steinmann202595,
	author = {Steinmann, Jan Juhani},
	title = {The Ethos of Deifcation: On True Sovereignty in Dealing with Technology},
	year = {2025},
	journal = {Handbook of Global Philosophies on AI Ethics: Toward Sustainable Futures},
