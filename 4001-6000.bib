	keywords = {Adversarial machine learning; Computer vision; Cybersecurity; Deep neural networks; Imaging systems; Learning systems; Mathematical transformations; Network security; Robotics; Safety engineering; AI safety; Cyber security; Defensive mechanism; Fast gradient sign method variant; Machine learning research; Machine-learning; Network robustness; Neural-networks; Robust machine learning; Single-step; Medical imaging},
