@BOOK{Kumari2025287,
	author = {Kumari, Meena and Singh, Gurpreet and Pande, Sagar Dhanraj},
	title = {DepressNet-HO: An Explainable AI framework for depression detection in IIoT applications},
	year = {2025},
	journal = {Explainable Artificial Intelligence-Based Industrial Internet of Things: Technologies and Applications},
	pages = {287 - 315},
	doi = {10.1201/9781003537380-15},
	url = {https://www.scopus.com/pages/publications/105027351914?origin=resultslist},
	affiliations = {Lovely Professional University, India; Pimpri Chinchwad University, Pune, India},
	abstract = {Depression is a common occurrence affecting a massive population of people around the world. This is because depression is very often not diagnosed on time owing to the unavailability and unreliability of detecting the condition in good time. Emotions being recognized from text data are another challenge, especially because the linguistic features have to be modeled through a deep learning instrument. In order to deal with the problem, DepressNet-HO, a hybrid optimization framework based on Harris Hawks Optimization (HHO) and Whale Optimization Algorithm (WOA) that focuses on hyperparameter tuning of the CNN-LSTM model, is proposed. The CNN component extracts local features, while the LSTM captures long-term dependencies in the text. Hybrid optimization optimizes key parameters, such as convolutional filter sizes, LSTM units, and learning rates to significantly improve the performance of this model. Beyond all the above, LIME (Local Interpretable Model-agnostic Explanations) has been utilized to add transparency to this technique by showing which words positively influence the outcome produced by the model. Furthermore, the proposed approach holds promising potential for Industrial Internet of Things (IIoT) applications, where real-time emotional monitoring and mental health diagnostics can be integrated into smart environments and industrial safety systems. DepressNet-HO has achieved an impressive 97.76% overall accuracy with similar precision, recall, and F1-scores for all classes that can be interpretable in depression detection, making it suitable for out-of-the-box mental health applications. © 2026 selection and editorial matter, Surendra Reddy Vinta, Sagar Dhanraj Pande and Aditya Khamparia.},
	keywords = {Accident prevention; Linguistics; Occupational risks; Condition; Hybrid optimization; Hyper-parameter; Linguistic features; Local feature; Mental health; Optimisations; Optimization algorithms; Optimization framework; Text data; Long short-term memory},
