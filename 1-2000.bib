	title = {Recommendation and Temptation},
	year = {2025},
	journal = {RecSys2025 - Proceedings of the 19th ACM Conference on Recommender Systems},
	pages = {422 - 431},
	doi = {10.1145/3705328.3748063},
	url = {https://www.scopus.com/pages/publications/105019643702?origin=resultslist},
	affiliations = {University of Michigan, Ann Arbor, MI, United States},
	abstract = {Traditional recommender systems based on revealed preferences often fail to capture the fundamental duality in user behavior, where consumption choices are driven by both inherent value (enrichment) and instant appeal (temptation). Consequently, these systems may generate recommendations that prioritize short-term engagement over long-lasting user satisfaction. We propose a novel recommender design that explicitly models the tension between enrichment and temptation. We introduce a behavioral model that accounts for how both enrichment and temptation influence user choices, while incorporating the reality of off-platform alternatives. Building on this model, we formulate a novel recommendation objective aligned with maximizing consumed enrichment and prove the optimality of a locally greedy recommendation strategy. Finally, we present an estimation framework that leverages the distinction between explicit user feedback and implicit choice data while making minimal assumptions about off-platform options. Through comprehensive evaluation using both synthetic simulations and real-world data from the MovieLens dataset, we demonstrate that our approach consistently outperforms competitive baselines that ignore temptation dynamics either by assuming revealed preferences or recommending solely based on enrichment. Our work represents a paradigm shift toward more nuanced and user-centric recommender design, with significant implications for developing responsible AI systems that genuinely serve users' long-term interests rather than merely maximizing engagement. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Behavioral Model; Content Consumption; Online Platforms; Recommender Systems; User Engagement; User Well-being},
	keywords = {Behavioral research; Human computer interaction; Human engineering; Information management; Online systems; User centered design; Behavioral model; Content consumption; Inherent value; Long lasting; Online platforms; Revealed preference; User behaviors; User engagement; User well-being; Well being; Recommender systems},
