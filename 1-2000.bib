@CONFERENCE{Cheng2025,
	author = {Cheng, Theodore H.},
	title = {Designing Dialogic Disclaimers: Principles for Ethical Conversational Design in LLM Interfaces},
	year = {2025},
	journal = {CUI 2025 - Proceedings of the 2025 ACM Conference on Conversational User Interfaces},
	pages = {},
	doi = {10.1145/3719160.3737640},
	url = {https://www.scopus.com/pages/publications/105011589434?origin=resultslist},
	affiliations = {New York University, New York City, NY, United States},
	abstract = {Current disclaimer approaches in large language model (LLM) systems often disrupt conversational flow with static, one-shot warnings that fail to engage users in deeper ethical reflection and, as a growing body of evidence reveals, are largely ineffective at achieving their intended goals of calibrated trust and informed use. This paper examines how disclaimers can be reimagined as integrated dialogic elements that maintain conversational coherence while effectively communicating necessary ethical information. Through a theoretical synthesis drawing on research in conversational repair, dialogue structure, AI transparency, and empirical studies of user interaction with LLMs, we identify four design principles for dialogic disclaimers: Conversational Continuity, Contextual Adaptation, Layered Communication, and User Agency. We provide illustrative conversation patterns demonstrating how these principles can transform disclaimers from disruptive and often ignored statements into constructive components of ethical dialogue. This work establishes a conceptual framework intended as a theoretical foundation to guide future empirical evaluation and the design of more ethically responsible and conversationally fluent LLM interfaces. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {AI ethics; Conversational disclaimers; Conversational User Interfaces (CUIs); Dialogue design; Ethical Design; Explainable AI (XAI); Human-AI Interaction (HAI); Large language models (LLMs); Misinformation; Risk Communication; Transparency; Trust Calibration; User trust},
	keywords = {Artificial intelligence; Ethical technology; Human computer interaction; Human engineering; Interactive computer systems; Speech processing; AI ethic; Conversational disclaimer; Conversational user interface; Dialogue design; Ethical designs; Explainable AI (XAI); Human-AI interaction; Language model; Large language model; Misinformation; Risk communication; Trust calibration; User trust; User interfaces},
