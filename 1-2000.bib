	abstract = {Concerns about the social impact of new manufacturing and production technologies are not new. Long pre-dating the advent of generative AI in the 2020’s, business process reengineering (BPR) in the 1990’s became a key enabler of the widespread restructuring of manufacturing and service supply chains we now know as globalization. To this day, we live with the consequences of millions of displaced jobs, a gig economy, inadequate social welfare transfers and now, during the retreat from globalization, rising security tensions between former trading partners. In this short review article, I draw on the lessons of the “botched” regulation of the BPR era to make the case for much strengthened regulation of the social impacts of new technology in our present era of generative AI. © The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature 2025.},
