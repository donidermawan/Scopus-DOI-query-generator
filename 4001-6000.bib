	keywords = {Data aggregation; Data mining; Decision making; Differential privacy; Ethical technology; Interactive computer systems; Learning systems; Machine learning; Population statistics; Privacy-preserving techniques; Automated decision making; Collaborative artificial intelligence; Critical challenges; Decisions makings; Machine-learning; Organizational context; Performances evaluation; Privacy aware; Real-world; Responsible artificial intelligence; Economic and social effects},
