	year = {2025},
	journal = {International Conference on Electrical, Computer, and Energy Technologies, ICECET 2025},
	pages = {},
	doi = {10.1109/ICECET63943.2025.11472356},
	url = {https://www.scopus.com/pages/publications/105037107407?origin=resultslist},
	affiliations = {St.Francis College, Department of Psychology, Brooklyn, 11201, NY, United States; International American University, Department of Business Administration, Los Angeles, 90010, CA, United States; Analytics Trine University, Department of Science in Business, Angola, 46703, IN, United States; Westcliff University, Department of Business Administration, Irvine, 92614, CA, United States; Westcliff University, Department of Technology & Engineering, Irvine, 92614, CA, United States; Michigan State University, Department of Epidemiology and Biostatistics, East Lansing, 48824, MI, United States},
	abstract = {Suicide remains a pressing public health crisis, particularly in the United States, where it is one of the leading causes of death. The rise of social media has created new opportunities for early detection of suicidal intent through artificial intelligence (AI)-based predictive models. This study proposes and evaluates two machine learning models - Naïve Bayes and Random Forest - for classifying suicide-related content in online discussions. We utilized a dataset sourced from Reddit's "SuicideWatch,""depression,"and "teenagers"subreddits, collected via the Pushshift API. The dataset underwent extensive preprocessing, including text normalization, sentiment analysis, and feature engineering. After training on an 80:20 split, Naïve Bayes achieved an accuracy of 90.7% with higher recall, while Random Forest reached 90.5% with better specificity. Statistical testing (t-test: p = 0.00395; Wilcoxon: p = 0.125) showed that Naïve Bayes performed significantly better in terms of mean classification performance. While Naïve Bayes outperformed Random Forest slightly in classification efficiency, Random Forest provided better interpretability in feature importance. Our findings underscore AI's potential in suicide prevention, but ethical concerns, including privacy risks and biases in training data, remain critical. We emphasize that AI systems should augment - not replace - human expertise, particularly in mental health interventions. These predictive models can serve as early-warning systems, enhancing crisis intervention efforts and supporting mental health initiatives. Future research should focus on refining model interpretability, addressing biases, and integrating AI within clinical frameworks to maximize its societal impact. © 2025 IEEE.},
	author_keywords = {AI Ethics; Crisis Intervention; Machine Learning; Sentiment Analysis; Suicide Prevention},
	keywords = {Barium compounds; Classification (of information); Classifiers; Data mining; Data privacy; Ethical aspects; Learning systems; Machine learning; Prediction models; Social networking (online); Statistical tests; Artificial intelligence ethic; Crisis intervention; Interpretability; Machine-learning; Mental health; Naive bayes; Predictive models; Random forests; Sentiment analysis; Suicide prevention; Sentiment analysis},
