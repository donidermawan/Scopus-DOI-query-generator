	affiliations = {Tianjin University of Commerce, Tianjin, China; School of Management, Northwestern Polytechnical University, Shaanxi, Xian, China},
	abstract = {Green technology innovation is crucial for achieving sustainable development goals.However, its inherent high-risk and information asymmetry characteristics lead to systematic financing constraints that are difficult to overcome within the traditional financial system.Addressing this challenge, this paper investigates how digital finance,powered by Artificial Intelligence(AI)and viewed through the lens of AI model duality,improve the efficiency of the capital allocation can promote corporate green innovation. Based on this background, this paper puts forward a novel "AI Model Duality"theoretical analytical framework to explain how the complexity of AI algorithms influences digital finance in supporting high-risk green innovation; at the same time, it thoroughly analyzes the internal mechanism and boundary conditions for the ability of digital finance to empower green innovation. Based on this, we formulate two sets of four lemmas, namely L1 to L8. a meta-analysis of pirical tests for Chinese A-share-listed firms (from 2011 to 2020) leads us to conclude that digital finance has a significant effect on substantive green innovation. Mechanistic analysis indicates that digital finance enhances the allocation efficiency of capital and helps explain about 22.4% of the total effect of digital finance, but firm innovation risk significantly reduces this effect. extremely negative moderating effect validates the major conclusion of "AI Model Duality"theory - under the influence of conventional basic algorithms with high dependence on historical structured data in the current market environment, most mainstream basic algorithms exhibit a certain degree of "risk aversion", inhibiting high-risk disruptive innovative financing from being successfully acquired and supported by capital. Findings show that both algorithmic complexity and risk appetite are key factors determining the extent to which digital finance can facilitate green innovation, thus providing a robust theoretical basis and pragmatic evidence for the regulator and market participants to make optimized regulation policy and differentiated support targeted to provide an effective support for "responsible AI"fostering of high-risk sustainable innovation. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {AI Model Duality; Artificial Intelligence; Capital Allocation Efficiency; Digital Finance; Green Innovation},
