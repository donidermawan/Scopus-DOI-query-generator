@ARTICLE{Meadi2025,
	author = {Meadi, Mehrdad Rahsepar and Sillekens, Tomas and Metselaar, Suzanne and van Balkom, Anton and Bernstein, Justin and Batelaan, Neeltje},
	title = {Exploring the Ethical Challenges of Conversational AI in Mental Health Care: Scoping Review},
	year = {2025},
	journal = {JMIR Mental Health},
	volume = {12},
	pages = {},
	doi = {10.2196/60432},
	url = {https://www.scopus.com/pages/publications/86000442188?origin=resultslist},
	affiliations = {Department of Psychiatry, Vrije Universiteit Amsterdam, Amsterdam, Netherlands; Department of Ethics, Law, & Humanities, Vrije Universiteit Amsterdam, Amsterdam, Netherlands; GGZ Centraal Mental Health Care, Amersfoort, Netherlands; Department of Philosophy, Vrije Universiteit Amsterdam, Amsterdam, Netherlands},
	abstract = {Background: Conversational artificial intelligence (CAI) is emerging as a promising digital technology for mental health care. CAI apps, such as psychotherapeutic chatbots, are available in app stores, but their use raises ethical concerns. Objective: We aimed to provide a comprehensive overview of ethical considerations surrounding CAI as a therapist for individuals with mental health issues. Methods: We conducted a systematic search across PubMed, Embase, APA PsycINFO, Web of Science, Scopus, the Philosopher’s Index, and ACM Digital Library databases. Our search comprised 3 elements: embodied artificial intelligence, ethics, and mental health. We defined CAI as a conversational agent that interacts with a person and uses artificial intelligence to formulate output. We included articles discussing the ethical challenges of CAI functioning in the role of a therapist for individuals with mental health issues. We added additional articles through snowball searching. We included articles in English or Dutch. All types of articles were considered except abstracts of symposia. Screening for eligibility was done by 2 independent researchers (MRM and TS or AvB). An initial charting form was created based on the expected considerations and revised and complemented during the charting process. The ethical challenges were divided into themes. When a concern occurred in more than 2 articles, we identified it as a distinct theme. Results: We included 101 articles, of which 95% (n=96) were published in 2018 or later. Most were reviews (n=22, 21.8%) followed by commentaries (n=17, 16.8%). The following 10 themes were distinguished: (1) safety and harm (discussed in 52/101, 51.5% of articles); the most common topics within this theme were suicidality and crisis management, harmful or wrong suggestions, and the risk of dependency on CAI; (2) explicability, transparency, and trust (n=26, 25.7%), including topics such as the effects of “black box” algorithms on trust; (3) responsibility and accountability (n=31, 30.7%); (4) empathy and humanness (n=29, 28.7%); (5) justice (n=41, 40.6%), including themes such as health inequalities due to differences in digital literacy; (6) anthropomorphization and deception (n=24, 23.8%); (7) autonomy (n=12, 11.9%); (8) effectiveness (n=38, 37.6%); (9) privacy and confidentiality (n=62, 61.4%); and (10) concerns for health care workers’ jobs (n=16, 15.8%). Other themes were discussed in 9.9% (n=10) of the identified articles. Conclusions: Our scoping review has comprehensively covered ethical aspects of CAI in mental health care. While certain themes remain underexplored and stakeholders’ perspectives are insufficiently represented, this study highlights critical areas for further research. These include evaluating the risks and benefits of CAI in comparison to human therapists, determining its appropriate roles in therapeutic contexts and its impact on care access, and addressing accountability. Addressing these gaps can inform normative analysis and guide the development of ethical guidelines for responsible CAI use in mental health care. ©Mehrdad Rahsepar Meadi, Tomas Sillekens, Suzanne Metselaar, Anton van Balkom, Justin Bernstein, Neeltje Batelaan.},
	author_keywords = {artificial intelligence; chatbot; conversational agent; conversational agents; digital technology; ethics; mental health; mHealth; mobile health; natural language processing; psychotherapist; psychotherapy; qualitative; scoping review},
	keywords = {algorithm; artificial intelligence; artificial intelligence chatbot; beneficence; confidentiality; conversational artificial intelligence; crisis intervention; deception; dependent personality disorder; Embase; empathy; health care personnel; health disparity; human; information processing; information storage; internet literacy; justice; Medline; mental disease; nonmaleficence; patient autonomy; patient safety; privacy; PsycINFO; responsibility; Review; scoping review; Scopus; statistical bias; suicidal behavior; trust; Web of Science},
