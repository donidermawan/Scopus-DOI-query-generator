	affiliations = {Department of Mechanical Engineering, Guru Jambheshwar University of Science and Technology, Hisar, 125001, India; Department of Design and Engineering, Bournemouth University, 5BB Fern Barrow, Poole, BH12 5BB, United Kingdom; Mechanical and Aerospace Engineering, University of Missouri, Columbia, 65211, MO, United States},
	abstract = {Fused deposition modeling (FDM) is gaining significant recognition among researchers for its capability in advanced material innovation and complex design fabrication. The performance of FDM-fabricated components is heavily influenced by input parameters, which play a critical role in determining wear characteristics. This study focuses on investigating the wear behavior of FDM-printed acrylonitrile butadiene styrene (ABS) specimens. An optimal custom design approach, rooted in response surface methodology (RSM), was employed to construct an experimental matrix encompassing 17 distinct parameter combinations. These specimens were fabricated using a MakerBot Method X printer and tested for wear resistance using a pin-on-disc setup in compliance with ASTM G99 standards. To achieve optimized wear performance, a hybrid artificial intelligence (AI) framework integrating artificial neural networks (ANN) with genetic algorithm (GA) was implemented. This approach facilitated the prediction and minimization of specific wear rate (SWR), achieving an optimized value of 28.79 × 10<sup>−7</sup> mm<sup>3</sup>/Nm, experimentally validated with a high accuracy of 98.92%. The wear morphology analysis using field-emission scanning electron microscopy (FESEM) revealed a significant reduction in surface damage for the optimized specimens. The findings highlight the effectiveness of hybrid optimization techniques, such as ANN and GA, in enhancing the tribological properties of FDM components. © The Minerals, Metals & Materials Society 2025.},
	keywords = {Computer aided design; Fabrication; Genetic algorithms; Neural networks; Orthogonal frequency division multiplexing; Soft computing; Wear of materials; Wear resistance; Acrylonitrile-butadiene-styrene; Advanced materials; Artificial intelligent; Complex designs; Deposition modeling; Innovation design; Input parameter; Materials innovations; Performance; Softcomputing techniques; Scanning electron microscopy; Styrene},
