@CONFERENCE{Nur2025,
	author = {Nur, Juswaldi and Tan, Kimberly and Wiputra, Richard},
	title = {AI Agents in Mental Health Treatment: A Systematic Review},
	year = {2025},
	journal = {2025 International Conference on Innovation and Intelligence for Informatics, Computing,and Technologies, 3ICT 2025},
	pages = {},
	doi = {10.1109/3ict68299.2025.11442195},
	url = {https://www.scopus.com/pages/publications/105036345680?origin=resultslist},
	affiliations = {School of Information Systems, Bina Nusantara University, Information Systems Department, Jakarta, 11480, Indonesia},
	abstract = {The rapid integration of Agent artificial intelligence (AI) tools, such as chatbots, large language models (LLMs), and conversational agents, has demonstrated significant potential in facilitating mental health care, especially for depression and anxiety. This systematic review adheres to the PRISMA guidelines and synthesizes 21 studies published between 2020 and 2024, evaluating AI agents in terms of therapeutic efficacy, user engagement, and ethical considerations. Evidence indicates that AI-based therapies markedly improved outcomes: symptom reduction ranged from 19 % to 42 %, retention rates were, on average, 28 % higher, and therapy completion increased by 18 % compared to traditional self-help methods. Personalization and adaptive feedback were crucial to these enhancements, increasing user compliance and satisfaction. Nonetheless, significant shortcomings remain concerning long-term efficacy, data privacy, algorithmic bias, and regulatory supervision. This study highlights the transformative potential and current limitations of AI agents in mental health, stressing the necessity for comprehensive clinical trials and strong ethical frameworks to guarantee the safe and equitable deployment of these technologies. © 2025 IEEE.},
	author_keywords = {AI Ethics and regulation; Artificial Intelligence; Mental Health; Therapeutic and Systematic Review; User Experience},
	keywords = {Data privacy; Ethical technology; Feedback; Intelligent agents; User experience; Artificial intelligence agent; Artificial intelligence ethic and regulation; Artificial intelligence tools; Chatbots; Language model; Mental health; Mental health treatments; Systematic Review; Therapeutic and systematic review; Users' experiences; Artificial intelligence},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158258-6},
