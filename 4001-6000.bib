	title = {Research on Reliability Enhancement of Intelligent Systems Based on the Integration of AI and Embedded Systems},
	year = {2025},
	journal = {2025 5th International Conference on Digital Society and Intelligent Systems, DSInS 2025},
	pages = {100 - 103},
	doi = {10.1109/DSInS68311.2025.11329918},
	url = {https://www.scopus.com/pages/publications/105033154025?origin=resultslist},
	affiliations = {China University of Geosciences (Beijing), Beijing, China},
	abstract = {Intelligent systems have been widely applied in fields such as industrial control and autonomous driving. However, there are still issues with the reliability of intelligent systems, including lack of real-time performance, insufficient data accuracy, weak security protection, broken collaborative mechanisms, and poor environmental adaptability. For any intelligent system, its reliability directly depends on the performance of the embedded system. In existing research, the integration of AI and embedded systems mostly focuses on a single dimension: one type of research optimizes the performance of embedded systems through edge computing or AI chips, but does not link the full life cycle guarantee; Another type of research builds predictive maintenance systems based on the integration of the two, but fails to address the real-time performance and security issues of embedded systems themselves. To address this issue, this study for the first time integrates two types of fusion paths and proposes a dual-path synergy framework of 'system self-optimization - full life cycle guarantee'. Through the collaborative interaction of the two, the reliability of intelligent systems is enhanced in multiple dimensions. Through experimental verification on the industrial embedded test platform, the evaluation indicators include data processing delay, error rate, attack defense rate and mean time between failures. The experimental results show that the dual-path synergy proposed by me is superior to the single-dimensional solution, providing a feasible technical solution for improving the reliability of complex intelligent systems.  © 2025 IEEE.},
	author_keywords = {AI; AI chip; dual-path synergy; edge computing; embedded systems; predictive maintenance; reliability of intelligent systems},
	keywords = {Distributed computer systems; Integration; Intelligent control; Intelligent systems; Life cycle; Network security; Predictive maintenance; Real time systems; Reliability; AI chip; AI systems; Dual path; Dual-path synergy; Edge computing; Embedded-system; Predictive maintenance; Real time performance; Reliability of intelligent system; Embedded systems},
