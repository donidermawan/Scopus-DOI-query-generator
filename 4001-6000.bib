@ARTICLE{Prathyush Turaga2025210576,
	author = {Prathyush Turaga, Venkata SAI and Pahi, Timea and Tjoa, Simon and Siami-Namini, Sima and Siami Namin, Akbar},
	title = {CO2 (Co-Compliance Officer): An LLM-Based Ontology-Driven Methodology for Generating Knowledge Graphs and AI Compliance Checking},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {210576 - 210606},
	doi = {10.1109/ACCESS.2025.3639228},
	url = {https://www.scopus.com/pages/publications/105024002605?origin=resultslist},
	affiliations = {Texas Tech University, Department of Computer Science, Lubbock, 79409, TX, United States; University of Applied Sciences St. Pölten, Department of Computer Science and Security, Saint Pölten, 3100, Austria; George Mason University, Department of Economics, Fairfax, 22030, VA, United States},
	abstract = {With the advent of Artificial Intelligence (AI) technology and immense transitions to industry, it is important to regulate and establish standards for this fascinating technology. As a result, AI-powered applications need to be checked for compliance with AI regulations. Although compliance checks have been extensively discussed by the research community and industry, AI compliance checks and verification still need to be explored, and pitfalls need to be identified. This paper aims at automating the extraction of AI regulations using the knowledge graph and the ontology defined for legal documents. The paper first reports the initial effort to create knowledge graphs for legal documents (e.g., the EU AI Act) using different language models trained in general textual documents where general approaches in extracting Named-Entity Recognition (NER) are employed. Triplets in the form of <Subject-Predicate-Object> are extracted followed by enhancement achieved through augmenting NER tags by information captured using dependency parsers. The paper then presents a methodology called Co-Compliance Officer (CO2) where Large Language Models (LLMs) are employed to build knowledge graphs and NER which are solely for parsing and extracting legal documents. The LLM ontology is then used to create effective tags that are specifically designed to extract legal documents and the relationships between legal entities. The created knowledge graphs are then used to perform several verification analysis on legal documents, including inconsistency checks and violations. The results indicate that Large Language Models (LLMs) can be helpful in compliance checking of legal documents, in particular, the documents created for AI compliance checking. © 2013 IEEE.},
	author_keywords = {AI compliance; European Artificial Intelligence Act (EU AI Act); high-risk systems; knowledge graph; large language models (LLMs); legal regulations; ontology},
	keywords = {Compliance control; Computational linguistics; Graphic methods; Information use; Knowledge graph; Laws and legislation; Artificial intelligence compliance; Compliance checking; High-risk systems; Knowledge graphs; Language model; Large language model; Legal documents; Legal regulation; Ontology's; The european artificial intelligence act (the EU artificial intelligence act); Ontology},
	correspondence_address = {A. Siami Namin; Texas Tech University, Department of Computer Science, Lubbock, 79409, United States; email: akbar.namin@ttu.edu},
