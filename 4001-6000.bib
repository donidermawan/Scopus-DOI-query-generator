@CONFERENCE{Vasudevan2025410,
	author = {Vasudevan, Nijanthan and Massat, Oudayl and Sampathkumar, Padmapriya},
	title = {AI-Driven Dual-Arm Robotic Platform for Space Bioreactor Servicing: Early-Stage Hardware Development and Computational Validation},
	year = {2025},
	journal = {Proceedings of the International Astronautical Congress, IAC},
	pages = {410 - 427},
	doi = {10.52202/083083-0048},
	url = {https://www.scopus.com/pages/publications/105032637977?origin=resultslist},
	affiliations = {West Virginia University, United States; Longstride Dynamics LLC, United States; Young Imagineer, the eplane company, India},
	abstract = {Future space missions require automated maintenance systems to reduce crew workload for life support operations. This paper presents early-stage development of an AI-driven dual-arm robotic platform intended for bioreactor servicing, combining physical prototype validation with computational modeling and reinforcement learning control. We developed a proof-of-concept dual-arm system using commercial manipulators to validate workspace requirements and basic coordination principles. In parallel, we implemented an AI control framework using Proximal Policy Optimization (PPO) in simulation, integrating manipulator dynamics with simplified bioreactor process models based on Monod growth kinetics. The PPO algorithm learns coordinated control policies for dual-arm manipulation and theoretical bioreactor parameter optimization. Physical prototype testing demonstrated 72% success rate in pick-and-place operations with containers representing bioreactor components, validating workspace accessibility and basic collision avoidance. Computational validation in NVIDIA Isaac Gym, where the AI control system was fully implemented, showed the dual-arm configuration achieving 76% task completion versus 58% for single-arm baseline, with 28% reduction in operation time. The AI system demonstrated adaptive behavior in simulation, learning to coordinate arms for parallel tasks and optimizing trajectories for energy efficiency. However, significant gaps exist between current prototype capabilities and full bioreactor servicing requirements. The physical prototype lacks precision (±5mm achieved vs. ±0.1mm required), sterile handling capabilities, and sensor integration necessary for biological systems. While the AI framework shows promise in simulation, hardware limitations prevent real-world implementation of learned policies. This work establishes foundations for AI-driven dual-arm coordination while identifying critical development pathways: (1) hardware upgrades for space-rated precision, (2) sim-to-real transfer strategies for AI policies, and (3) integration of biosensors for closed-loop control. The research demonstrates both the potential of AI-driven approaches and current implementation challenges. © 2025 International Astronautical Federation, IAF. All rights reserved.},
	author_keywords = {AI-Driven Robotics; Bioreactor Systems; Dual-Arm Manipulation; Reinforcement Learning; Simulation Validation; Space Life Support},
