@CONFERENCE{Gao2025,
	author = {Gao, Di Kevin and Chen, Jingdao and Rahimi, Shahram},
	title = {AI Regulation in the U.S.: Lessons from Commodity Futures Legislative Journey and a Perspective CFTC-NFA Model for AI},
	year = {2025},
	journal = {Proceedings of 2025 International Conference on Sustainable Technology and Engineering, i-COSTE 2025},
	pages = {},
	doi = {10.1109/i-COSTE68047.2025.11467413},
	url = {https://www.scopus.com/pages/publications/105038020427?origin=resultslist},
	affiliations = {California State University, Sacramento, United States; Mississippi State University, United States; The University of Alabama, United States},
	abstract = {The emergence of ChatGPT in November 2022 and the subsequent rush to 'AI-ize' everything from scheduling to speech synthesis to surgery have decisively shifted the focus of AI regulation from 'if' to 'what' and 'how'. While other major economies, especially the European Union, have taken the lead in AI regulation, substantial disagreements on what prospective AI regulation should look like have inhibited necessary progress in the United States. It is critically important for the AI community to coalesce around a shared vision to advance AI regulation effectively. To that end, the authors examined the US legislative history for insights. After extensive research, we found an equally disruptive and controversial parallel: commodity futures. Futures contract, a 19th-century invention, was initially hailed by growers, buyers, and bankers as a breakthrough. Its legislative journey, however, was tumultuous. It was almost banned nationwide, as anti-option laws passed both chambers of Congress, but was ultimately spared when Congress failed to reconcile the House and Senate bills. In the next 100 years, Congress experimented and patch-worked various versions of futures laws and finally settled on a principles-based, central-agency-managed, and self-regulatory organization (SRO)-supported regulation, facilitating its exponential growth. Demonstrating their adaptability, commodity futures laws have become a primary vehicle for regulating emerging digital assets such as cryptocurrencies. In this article, the authors analyze the similarities between the legislative experience of AI and futures: both face an emotional and opinionated general public, a slow-moving Congress, and active state legislatures. Futures' treacherous legislative journey, near-death experiences, and subsequent astronomical growth provide AI with a cautious yet promising roadmap. At the conclusion of this article, the authors recommend a principles-based law, central-agency-led architect, and SRO-supported model to regulate AI, supported by AI regulatory enablers including AI registration and disclosure, AI monitoring, and AI enforcement.  © 2025 IEEE.},
	author_keywords = {AI regulation; artificial intelligence regulation; Central-agency Model; CFTC; CFTC-NFA Model; NFA; Principles-based Regulation; Self-regulatory Organization},
	keywords = {Contracts; Economics; Electronic trading; Financial markets; Laws and legislation; AI regulation; Artificial intelligence regulation; Central-agency model; CFTC; CFTC-NFA model; Commodity futures; NFA; Principle-based regulation; Regulatory organizations; Self-regulatory organization; Speech synthesis},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158316-3},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Sustain. Technol. Eng., i-COSTE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Parlov2025,
