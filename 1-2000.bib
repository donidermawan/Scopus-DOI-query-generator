@CONFERENCE{Hermann2025638,
	author = {Hermann, Julia and Jansen, Nadine and Dogangün, Aysegül},
	title = {Surfacing Tensions in Digital Inclusion: A World Café Synthesis},
	year = {2025},
	journal = {OZCHI 2025 - Proceedings of the 37th Australian Conference on Human-Computer Interaction},
	pages = {638 - 646},
	doi = {10.1145/3764687.3769914},
	url = {https://www.scopus.com/pages/publications/105024876921?origin=resultslist},
	affiliations = {Ruhr West University of Applied Sciences, Bottrop, Germany},
	abstract = {Digital inclusion requires more than legal compliance or isolated accessibility fixes; it depends on the meaningful, sustained participation of people with diverse access and support needs in design and decision making. Focusing on people with disabilities in our context, we report findings from an online, interdisciplinary symposium that paired short, thematically targeted keynotes with a World Café. Keynotes from research, practice, and lived experience, covering participatory design in computing education, ethical responsibilities including AI, and practice-centered accessibility, seeded the World Café tables, and the speakers co-facilitated the discussions. Using a deductive-inductive qualitative content analysis of the recorded discussions, we synthesize five practice-grounded tensions: (1) tokenism versus empowered participation, (2) features that benefit many without flattening specific needs, (3) legal mandates versus adoption in everyday work, (4) digital sovereignty as a function of competence, configurability, and control, and (5) prioritization under conflicting access needs. In our case, the symposium format helped surface situated insights and enabled inclusive agenda setting across stakeholders, including experts by experience, practitioners, educators, and HCI researchers. Our contributions are twofold: an empirical map of current tensions grounded in participant accounts, and a methodological positioning of participatory symposia as agenda-setting instruments. We outline implications for technology design, computing education, and policy. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Accessibility; Digital Inclusion; Ethics; Participation; People with disabilities; World Café},
	keywords = {Behavioral research; Education computing; Engineering education; Ethical technology; Human engineering; Laws and legislation; Accessibility; Agenda settings; Computing education; Decisions makings; Digital inclusion; Legal compliance; Participation; Participatory design; People with disabilities; World cafe; Decision making},
	editor = {Fredericks J. and Yoo S. and Minh Tran T.T. and Pantidi N. and Hoang T. and Hoggenmueller M. and Caldwell G. and Tag B. and Andres J. and Davis H. and Boden M. and Zhu H. and Harman J. and Rahman J.},
