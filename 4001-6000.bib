@CONFERENCE{Chandrakar2025782,
	author = {Chandrakar, Preeti and Prasad, Priyanka and Nayak, Vipin Kumar},
	title = {Blockchain-Enabled Explainable AI for Insurance Fraud Detection},
	year = {2025},
	journal = {2025 17th IEEE International Conference on Computational Intelligence and Communication Networks, CICN 2025},
	pages = {782 - 786},
	doi = {10.1109/CICN67655.2025.11368198},
	url = {https://www.scopus.com/pages/publications/105034653268?origin=resultslist},
	affiliations = {National Institute of Technology Raipur, Department of Computer Science and Engineering, Raipur, India},
	abstract = {This study aims to create an AI framework for insurance fraud detection systems that is ethical, fair, and responsible. The focus is on reducing gender bias in decisionmaking. The Demographic Parity Difference metric was used to see if fraud predictions were evenly spread among groups based on the attribute insured-sex (male vs. female) and age. We tested five machine learning models: Logistic Regression, Decision Tree, Random Forest, XGBoost, and KNN, not just based on accuracy they were but also on the fair decision. To make the results easier to understand, SHAP and LIME were used to give local and global explanations of model predictions. Additionally, the use of blockchain technology guarantees that both fairness and explainability results are kept as unchangeable, clear records. This makes AI-driven insurance systems more accountable. The main value of this work is that it provides a single framework that deals with accuracy, fairness across gender, interpretability, and accountability all at once. This sets a standard for responsible AI. © 2025 IEEE.},
	author_keywords = {Blockchain for Accountability; Explainable AI (XAI); Fraud Analytics; Smart Contracts},
	keywords = {Crime; Decision trees; Error detection; Ethical technology; Insurance; Learning systems; Logistic regression; Random forests; Smart contract; Block-chain; Blockchain for accountability; Explainable AI (XAI); Fraud analytic; Fraud detection; Fraud detection system; Gender bias; Group-based; Insurance frauds; Machine learning models; Blockchain},
