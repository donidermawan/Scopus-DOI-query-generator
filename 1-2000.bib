	keywords = {e-government; Multi agent systems; Network security; Pipelines; e-Government; Faithfulness evaluation; Generation systems; Generative artificial intelligence; Graphrag; Language model; Large language model; Model-based OPC; Modulars; Retrieval-augmented generation; Redundancy},
