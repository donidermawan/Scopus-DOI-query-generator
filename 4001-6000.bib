@ARTICLE{Oladunni2025202700,
	author = {Oladunni, Timothy and Aneni, Ehimen},
	title = {Explainable Deep Neural Network for Multimodal ECG Signals: Intermediate Versus Late Fusion},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {202700 - 202736},
	doi = {10.1109/ACCESS.2025.3631544},
	url = {https://www.scopus.com/pages/publications/105021666060?origin=resultslist},
	affiliations = {Morgan State University, Computer Science Department, Baltimore, 21251, MD, United States; Yale University, Computer Science Department, New Haven, 06520, CT, United States; Yale School of Medicine, Yale University, Section of Cardiovascular Medicine, Department of Internal Medicine, New Haven, 06520, CT, United States},
	abstract = {This study investigates the effectiveness of intermediate and late fusion strategies for multimodal ECG classification across time, frequency, and time–frequency domains. Multiple fusion architectures were designed and evaluated to identify the most efficient and interpretable configuration. Intermediate fusion consistently outperformed late fusion, achieving a peak accuracy of 97 %, with a large effect size (Cohen’s d > 0.8) relative to single-domain models and d = 0.4 compared with late fusion. Interpretability analyses using saliency maps revealed that model attention aligned closely with physiologic ECG regions, while Mutual Information (MI) confirmed a strong statistical dependency between discretized ECG signals and their corresponding saliency distributions. We introduce the Explainable-AI Trustworthiness (EAT) theory, which defines the foundational principles of informational grounding, robustness, and architectural faithfulness as necessary conditions for trustworthy explanations in biomedical AI. Building on this theoretical foundation, we propose the EAT framework, which operationalizes these principles into formal, measurable criteria for ECG model interpretability. The framework quantifies (i) informational grounding to expert-annotated ST–T segments through adjusted/normalized MI (AMI/NMI); (ii) robustness to physiologic and adversarial perturbations via flip-rate, (Formula presented), and saliency stability; and (iii) architectural faithfulness through branch concordance and ablation consistency. Under these criteria, EAT exhibits statistical soundness, monotonicity, and completeness, advancing explainability from subjective visualization toward falsifiable, auditable, and clinically trustworthy AI evaluation. The integration of EAT theory and framework establishes a unified foundation that bridges theoretical rigor with practical model validation, promoting reproducibility, clinical credibility, and cross-domain generalization in future biomedical AI research. © 2013 IEEE.},
	author_keywords = {cardiovascular diseases; CVD; deep learning; explainable AI; Multimodal; neural networks; trustworthy AI},
	keywords = {Architecture; Biomedical signal processing; Cardiology; Computation theory; Deep neural networks; Diseases; Electrocardiography; Fusion reactions; Information fusion; Cardiovascular disease; Deep learning; ECG signals; Explainable AI; Fusion strategies; Interpretability; Late fusion; Multi-modal; Neural-networks; Trustworthy AI; Clinical research},
	correspondence_address = {T. Oladunni; Morgan State University, Computer Science Department, Baltimore, 21251, United States; email: timothy.oladunni@morgan.edu},
