	url = {https://www.scopus.com/pages/publications/105033235167?origin=resultslist},
	affiliations = {University of Northern Colorado, Department of Mathematical Sciences, United States},
	abstract = {We introduce a cross-modality fairness audit for generalist clinical AI systems that integrate structured and unstructured EHR data. The framework combines SHAP, LIME, and counterfactual simulation to expose modality-specific bias and evaluate mitigation strategies. Experiments using MIMIC-IV show that a multimodal transformer achieves AUC 0.88 and F1 0.81, while fairness interventions (adversarial debiasing and subgroup reweighting) reduce Demographic Parity Difference (DPD) from 0.13 to 0.04 and Equalized Odds Difference (EOD) from 0.18 to 0.06 with minimal performance loss. We contribute color, single-column TikZ figures that make the audit interpretable for clinical collaborators, and we discuss deployment implications. © 2025 IEEE.},
