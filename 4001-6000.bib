	keywords = {Adaptive control systems; Blockchain; Deep learning; Digital twin; Electronic data interchange; Intelligent agents; Internet protocols; Learning systems; Dynamic optimization; Generative model; Industrial AI integration; KPI-driven control; Manufacturing optimization; Multi-agent reinforcement learning; Optimisations; Physic-informed generative model; Real-time dynamics; Work-flows; Multi agent systems},
