	correspondence_address = {İ. Kırbaş; Department of Computer Engineering, Faculty of Engineering and Architecture, Burdur Mehmet Akif Ersoy University, Burdur, 15030, Turkey; email: ismailkirbas@mehmetakif.edu.tr},
