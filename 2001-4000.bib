}

@CONFERENCE{Sayan20254144,
	author = {Sayan, M. Murtaza and Bueechl, Joerg},
	title = {Embedding AI Governance in Organizations: A Multi-Level Approach to Responsible AI Use},
	year = {2025},
	journal = {Procedia Computer Science},
	volume = {270},
	pages = {4144 - 4154},
	doi = {10.1016/j.procs.2025.09.539},
	url = {https://www.scopus.com/pages/publications/105024077683?origin=resultslist},
	affiliations = {Aalen University of Applied Sciences, Beethovenstr. 1, Aalen, 73430, Germany; ESB Business School, Reutlingen University, Alteburgstr. 150, Reutlingen, 72762, Germany},
	abstract = {Organizations now require stronger internal governance structures because artificial intelligence (AI) technologies continue to penetrate deeper into their operational processes. The GDPR and EU AI Act establish essential regulatory bases, yet organizations still face numerous practical challenges when implementing responsible AI practices. The European Commission continues to work on standardization initiatives to address this gap, but organizations must establish internal governance systems to convert external ethical standards into operational practices. This research examines organizational AI governance structures and implementation practices through twelve expert interviews representing technology, consulting and public administration sectors. This study demonstrates that organizations use a governance structure which includes strategic direction and operational execution and functional coordination and implementation through human resources and support functions. Furthermore, it also shows that internal governance operates dynamically based on specific roles and departmental collaboration and requires continuous adaptation and thus fills a knowledge gap between theoretical ethical standards and actual organizational implementation practices. Finally, this research provides operational recommendations for managers who want to establish AI governance systems in their organizations through cultural alignment and transparency and proactive change management. © 2025 The Authors. Published by Elsevier B.V.},
	author_keywords = {AI Governance; Artificial Intelligence; Organizational Implementation; Qualitative Research; Responsible AI},
	keywords = {Ethical technology; Information systems; Public administration; Artificial intelligence governance; Embeddings; Ethical standards; Governance structures; Governance systems; Implementation practices; Multilevels; Organizational implementation; Qualitative research; Responsible artificial intelligence; Artificial intelligence},
