	title = {ALGORITHMIC AUTHORITY AND THE POSTHUMAN TURN IN MANAGEMENT CULTURAL, ETHICAL, AND TECHNOLOGICAL RECONFIGURATIONS IN THE AGE OF SCIENTIFIC INNOVATION},
	year = {2025},
