@BOOK{Ouariach202586,
	author = {Ouariach, Fatima Zahra and Ahmed, Saquib},
	title = {Ethical and Legal Dimensions of AI in Healthcare: A Deep Learning Perspective},
	year = {2025},
	journal = {Computational Intelligence in Healthcare Law: AI for Ethical Governance and Regulatory Challenges},
	pages = {86 - 98},
	doi = {10.1201/9781003538462-6},
	url = {https://www.scopus.com/pages/publications/105004616153?origin=resultslist},
	affiliations = {Abdelmalek Essaadi University, Morocco; Sharda School of Law, Sharda University, Greater Noida, India},
	abstract = {The ethical aspects of AI particularly in terms such as informed consent, safety and transparency, are concerned with algorithmic fairness and biases and data privacy. This includes an informed consent, where patients must understand how AI systems will be used in their care and healthcare providers need to communicate this clearly. Safety comes first along with transparency; AI algorithms need to be tested and validated extensively before they can hit the market for patient care (to make sure they are not harming patients) as healthcare providers should understand how these algorithms take decisions. This chapter provides a high-level overview of the legislative challenges and requirements those AI technologies in healthcare need to comply with regarding legal frameworks. Because AI progresses so rapidly, in many cases, regulation is not well defined and it can be unclear where the responsibility lay when an accident takes place due to a machine learning system. This should be done in a way that they can help in advancing research and ensuring the data sharing process is Operational Technology (OT) compliant within regulation of data protection laws such as Health Insurance Portability and Accountability Act (HIPAA) (USA) and General Data Protection Regulation (GDPR) (EU). Developers are creating new and exciting AI solutions resulting in IP issues including patentability guidelines and ownership rights. This chapter highlights the need for cross-disciplinary collaboration by stakeholders policymakers, health care providers and ethicists as well as technology developers to define holistic frameworks which address these ethical and legal challenges. Putting ethical principles first and solid legal structures in place means the full potential of AI for health can be realized while also ensuring safety, equity and trust. © 2025 selection and editorial matter, Bhupinder Singh, Christian Kaunert, Balamurugan Balusamy and Rajesh Kumar Dhanaraj; individual chapters, the contributors.},
	keywords = {Ethical technology; Health insurance; mHealth; Nutrition; AI algorithms; AI systems; AI Technologies; Algorithmics; Ethical aspects; Health care providers; Legal frameworks; Legislative challenges; Legislative requirements; Patient care; Patient treatment},
	publisher = {CRC Press},
	isbn = {978-104035009-6; 978-103288566-7},
	language = {English},
	abbrev_source_title = {Computational Intelligence in Healthc. Law: AI for Ethical Gov. and Regulatory Challenges},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Doudoute2025,
	author = {Doudoute, Nixon and Garno, Zakaria},
	title = {From Kafka’s Courts to AI Tribunals: Bureaucratic Alienation and the Future of Justice},
	year = {2025},
	journal = {Law, Culture and the Humanities},
	pages = {},
	doi = {10.1177/17438721251393506},
	url = {https://www.scopus.com/pages/publications/105023185269?origin=resultslist},
	affiliations = {Euro-Mediterranean University of Fes, Morocco},
	abstract = {The Trial furnishes a diagnostic lens—opacity (epistemic), arbitrariness (normative), alienation (experiential)—for assessing AI-mediated governance in law and administration. Using literary hermeneutics, critical legal theory, and normative jurisprudence, the article maps this grid onto three emblematic systems—COMPAS (US), Chinook (Canada), and China’s social credit—showing how “black-box” procedures displace judgment, entrench structural bias, and erode due process. It evaluates partial remedies in the EU AI Act, GDPR, and UNESCO’s AI Ethics Recommendation, and specifies safeguards centered on transparency, contestability, accountability, and dignity (TCAD). The article concludes by flagging risks from large language models—fabricated citations, provenance-free drafting, and bias propagation—and by outlining TCAD-aligned controls to preserve agency and legal recognition in the age of algorithmic justice. © The Author(s) 2025},
	author_keywords = {AI regulation; algorithmic governance; artificial intelligence and law; bureaucratic alienation; Kafkaesque justice; legal opacity; procedural justice; The Trial},
	correspondence_address = {Z. Garno; Euro-Mediterranean University of Fes, Morocco; email: z.garno@ueuromed.org},
	publisher = {SAGE Publications Ltd},
	issn = {17438721},
	language = {English},
	abbrev_source_title = {Law Cult. Humanities},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

