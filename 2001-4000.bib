@BOOK{Yu20251,
	author = {Yu, Chong Ho and Chan, Sunny},
	title = {Responsible, Ethical, and Effective Use of LLMs in Higher Education},
	year = {2025},
	journal = {Future of Learning with Large Language Models: Applications and Research in Education},
	pages = {1 - 28},
	doi = {10.1201/9781003567257-1},
	url = {https://www.scopus.com/pages/publications/105023727650?origin=resultslist},
	affiliations = {Hawaii Pacific University, Hawaii, Honolulu, United States; University of West England, Bristol, United Kingdom},
	abstract = {The rapid advancement of Large Language Models (LLMs) has led to both opportunities and challenges regarding their integration into higher education. While advocates highlight the potential of LLMs to personalize learning, automate assessment, and enhance accessibility, critics warn of academic dishonesty, over-reliance on LLMs, and the erosion of critical thinking skills. This study examines the role of LLMs in education through a dual approach: A historical review of instructional technologies and an empirical survey on student perceptions and usage. Findings from past technological implementations suggest that mere adoption of advanced tools does not inherently improve learning outcomes, often due to over-optimistic assumptions about human potentials. Survey data reveal that students recognize both the benefits and risks of LLMs, with concerns centered on misinformation, ethical implications, and cognitive dependency. Based on these insights, the study proposes three strategic recommendations for responsible AI integration: (1) embedding AI ethics education within curricula, (2) emphasizing fact-checking and triangulation to mitigate misinformation, and (3) leveraging LLMs to support a flipped classroom model that prioritizes interactive learning and critical discourse. By drawing lessons from past instructional technologies and aligning AI adoption with sound pedagogical frameworks, this paper offers a balanced roadmap for harnessing LLMs effectively. © 2026 Myint Swe Khine, László Bognár and Ernest Afari.},
	keywords = {Curricula; Education computing; Engineering education; Ethical technology; Learning systems; Teaching; Academic dishonesty; Critical thinking skills; Dual approach; Empirical surveys; High educations; Historical review; Instructional technology; Language model; Over reliance; Student perceptions; Students},
	correspondence_address = {C.H. Yu; Hawaii Pacific University, Honolulu, Hawaii, United States; email: chonghoyu@gmail.com},
