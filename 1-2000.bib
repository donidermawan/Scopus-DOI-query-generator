	author = {Wei, Mengyi and Zhang, Puzhen and Chen, Chuan and Chen, Dongsheng and Zuo, Chenyu and Meng, Liqiu},
	title = {Mapping AI ethics narratives: evidence from Twitter discourse between 2015 and 2022},
	year = {2025},
