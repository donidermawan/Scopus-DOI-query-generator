	keywords = {Himalayas; India; Sikkim Himalayas; artificial intelligence; debris flow; decision making; disaster management; earthquake magnitude; earthquake prediction; ensemble forecasting; geological hazard; geomorphological response; GIS; hazard assessment; landslide; machine learning; mitigation; mountain region; rainfall; risk assessment; stakeholder; strategic approach; terrane; trigger mechanism; vulnerability},
