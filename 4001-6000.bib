@ARTICLE{Calzati2025,
	author = {Calzati, Stefano and van Loenen, Bastiaan},
	title = {The Data Republic: fostering a sustainable, inclusive and resilient digital transformation for the European Union},
	year = {2025},
	journal = {Frontiers in Political Science},
	volume = {7},
	pages = {},
	doi = {10.3389/fpos.2025.1670152},
	url = {https://www.scopus.com/pages/publications/105018810400?origin=resultslist},
	affiliations = {Delft University of Technology, Delft, Netherlands},
	abstract = {In various official documents, the European Union has declared its goal to pursue a “people-centric” digital transformation. While fuzzy in its formulation, this generally entails the defense of individual rights alongside principles such as economic competitiveness, social inclusiveness, digital sovereignty, and environmental sustainability. Hence—we claim—“people-centric” embeds and demands a “collectual” (collective + individual) equilibrium between individual and collective rights and principles. Concretely, we draw on literature to operationalize such an equilibrium in terms of socio-economic sustainability, inclusiveness, and resilience (SIR). From here, we show that the EU’s current human rights-based approach (HRBA) and its emerging digital single market (DSM) maintain an individualistic focus and economic rationale which fail to be collectual and SIR. We identify data commons as a promising collectual and SIR regime for governing the digital transformation. By addressing current barriers and limitations of data common initiatives, we conceptualize the Data Republic as a theoretical setup that can systemically tackle these limitations and barriers to provide a new way for pursuing a “people-centric” digital transformation in the EU. Copyright © 2025 Calzati and van Loenen.},
	author_keywords = {data commons; data governance; EU; inclusiveness; republic; resilience; sustainability; transdisciplinarity},
	correspondence_address = {B. van Loenen; Delft University of Technology, Delft, Netherlands; email: b.vanloenen@tudelft.nl},
	publisher = {Frontiers Media SA},
	issn = {26733145},
	language = {English},
	abbrev_source_title = {Front. Political. Sci.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Gupta2025,
	author = {Gupta, Shreyam Dutta},
	title = {Kafka as the Event Backbone for Enterprise Generative AI Assistants},
	year = {2025},
	journal = {International Conference on Software, Systems and Information Technology, SSITCON 2025},
	pages = {},
	doi = {10.1109/SSITCON66133.2025.11342135},
	url = {https://www.scopus.com/pages/publications/105033149961?origin=resultslist},
	affiliations = {Palo Alto, CA, United States},
	abstract = {Enterprise AI assistants must deliver subsecond token feedback while retrieving knowledge, invoking tools, and enforcing safety policies. Synchronous RPC pipelines couple these tasks, inflating tail latency, widening failure blast radius, and complicating governance. This architectural position paper presents a Kafka-based event backbone that decouples token streaming from background work via schema-governed contracts (start/delta/end; tool.request/result) and in-band policy controls (redact/block) with deterministic, idempotent reconciliation. This paper defines a practical reliability boundary, exactly-once within Kafka via idempotent producers, transactions, and outbox, and at least once at system edges with idempotency keys and compensation. The approach specifies multi-tenant governance (namespaces, ACLs, retention classes) and a token-time SLI methodology for enterprise validation. Synthetic testbed validation demonstrates sub- 300 ms TTFB performance, superior fault isolation, and rapid failure recovery compared to synchronous alternatives. The result is a governable, auditable, and responsive blueprint suitable for enterprise deployment across teams and tenants. © 2025 IEEE.},
	author_keywords = {Apache Kafka; Enterprise AI governance; Event-Driven Architecture; Generative AI; Token streaming latency},
	keywords = {Artificial intelligence; Information management; Apache kafkum; Enterprise AI governance; Event-driven architectures; Generative AI; Idempotent; In-band; Policy control; Position papers; Safety policies; Token streaming latency; Software architecture},
	correspondence_address = {S.D. Gupta; Palo Alto, United States; email: shreyam.duttagupta@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833152623-8},
