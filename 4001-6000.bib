@CONFERENCE{Dedu2025,
	author = {Dedu, Preetam and Lopes, Willison and Sirikonda, Nishanth},
	title = {An Observability Framework for Detecting Bias and Drift in AI-Based Student Early Alert Systems},
	year = {2025},
	journal = {Proceedings of the 2025 IEEE 5th International Conference on Advanced Learning Technologies on Education and Research, ICALTER 2025},
	pages = {},
	doi = {10.1109/ICALTER69698.2025.11355034},
	url = {https://www.scopus.com/pages/publications/105033496950?origin=resultslist},
	affiliations = {Ieee North Jersey Section, NJ, United States; Ieee Eastern North Carolina Section, NC, United States},
	abstract = {The integration of Artificial Intelligence (AI) into education has led to the widespread adoption of critical systems like student early alerts. However, the 'black box' nature of these models presents significant risks to their operational quality, reliability, and fairness. This paper introduces a novel, integrated framework that synthesizes principles from MLOps and software observability to enable the continuous, real-time validation of AI systems in educational settings. We developed a complete, containerized simulation environment featuring a Heuristic Model Service and an open-source observability stack (Prometheus, Loki, Grafana). Through a series of controlled experiments involving 1, 6 0 0 prediction instances across 1 0 0 simulated students over a 16-week semester, we demonstrate the framework's efficacy in three critical scenarios. The system successfully establishes a baseline for healthy operation (average risk scores within 0.03 points across demographic groups), provides real-time detection of data drift (identifying a 7.1-point score decline and corresponding 13.9% shift in risk distribution), and delivers quantitative evidence of algorithmic bias (detecting a 0.17 -point disparity between demographic groups. While demonstrated in education, this model-agnostic framework is generalizable to AI systems in healthcare, finance, and other high-stakes domains. This contribution provides a practical, reproducible blueprint for governing AI systems, transforming opaque models into transparent, auditable systems that can be continuously monitored for effectiveness, reliability, and equity.  © 2025 IEEE.},
	author_keywords = {AI Testing; Algorithmic Fairness; Bias Detection; Educational Technology; MLOps; Observability; Software Reliability; Student Early Alert Systems; Trustworthy AI},
	keywords = {Artificial intelligence; Continuous time systems; Education computing; Educational technology; Heuristic methods; Population statistics; Real time systems; Software testing; Students; Alert systems; Algorithmic fairness; Algorithmics; Artificial intelligence testing; Bias detection; Early alerts; MLOp; Software-Reliability; Student early alert system; Trustworthy artificial intelligence; Observability; Software reliability},
