@ARTICLE{Jonnala2025173,
	author = {Jonnala, Sridhar and Swamy, Basavaraj and Thomas, Nisha Mary},
	title = {Geopolitical Bias in Sovereign Large Language Models: A Comparative Mixed-Methods Study},
	year = {2025},
	journal = {Journal of Research, Innovation and Technologies},
	volume = {4},
