}

@ARTICLE{Erman2025,
	author = {Erman, Eva and Furendal, Markus},
	title = {The democratic role of non-state actors in the global governance of artificial intelligence},
	year = {2025},
	journal = {Critical Review of International Social and Political Philosophy},
	pages = {},
	doi = {10.1080/13698230.2025.2520037},
	url = {https://www.scopus.com/pages/publications/105008295636?origin=resultslist},
	affiliations = {Department of Political Science, Stockholm University, Stockholm, Sweden},
	abstract = {The emerging global governance of artificial intelligence (AI) is shaped by numerous political actors. Inviting non-state actors into such processes is typically assumed to address a perceived democratic deficit, by promoting increased representation, transparency, and openness. In the AI sphere, however, non-state actors include the same multinational companies that develop the technology to be regulated. Surprisingly, the task of normatively theorizing the democratic role of non-state actors in global AI governance has nevertheless been largely ignored. This paper addresses this by specifying, first, under what conditions non-state actors contribute to the actual democratization of global AI governance, as ‘democratic agents’, and second, under what conditions they instead contribute to the strengthening of the prerequisites for future democratization, as ‘agents of democracy’. We conclude that, although few non-state actors are authorized to act as ‘democratic agents’, their exercise of ‘moral’, ‘epistemic’, and ‘market authority’ could make them legitimate ‘agents of democracy’. © 2025 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Artificial intelligence; democratic agency; democratic role; epistemic authority; global governance; market authority; moral authority; non-state actors},
	correspondence_address = {E. Erman; Department of Political Science, Stockholm University, Stockholm, Sweden; email: eva.erman@statsvet.su.se},
	publisher = {Routledge},
	issn = {13698230},
	language = {English},
	abbrev_source_title = {Crit. Rev. Int. Soc. Polit. Philos.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Sourbati2025218,
	author = {Sourbati, Maria and Stypińska, Justyna},
	title = {Upskilling the Old, a Quarter Century on: Media Literacies, AI and Older People in Public Policy Discourses},
	year = {2025},
	journal = {Lecture Notes in Computer Science},
	volume = {15811 LNCS},
	pages = {218 - 227},
	doi = {10.1007/978-3-031-92712-6_14},
	url = {https://www.scopus.com/pages/publications/105007527591?origin=resultslist},
	affiliations = {University of Brighton, Brighton, United Kingdom; Berlin Social Science Center (WZB), Berlin, Germany},
	abstract = {This paper provides a critical, historically situated investigation of policy discourses surrounding the digital inclusion of older people over the past quarter of a century – from the e-society of the early 2000s to today’s AI policy visions. Drawing on data from the AGEAI research project (www.anyage.ai), we investigate emerging debates on AI literacy in Europe, focusing on the role of digital skills in the AI-driven economies of the future. Specifically, we examine the AI strategies of four European countries: Germany, Spain, Poland and the UK, through textual analysis. Our focus is on older people, a growing social demographic mostly associated with healthcare and social welfare solutions. We situate current iterations of AI literacy in their historical-technological context, spanning over two decades of media literacy and digital inclusion policies. Our analysis reveals that AI skills are predominantly conceptualised as user capabilities, and ‘users’ are addressed as members of homogenous groups, echoing earlier policy narratives in which media literacies were framed in binary terms. Individuals either ‘have’ or ‘have not’ developed their digital media skills and capabilities for internet access and use. Older people are frequently characterised using ageist tropes, such as deficiencies in learning, and vulnerabilities to technological exposure. At the same time, they are positioned at the centre of an expanding market for technological solutions. We identify a new set of challenges for research and policy, arising from the fact that AI systems do not always require the active involvement of the ‘users’ on whom they are deployed and can further exacerbate social and digital inequalities related to age. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {AI literacy; digital inclusion; media literacy; older people; public policy},
	keywords = {Economic and social effects; AI literacy; Digital inclusion; Digital skills; E-society; European Countries; Medium literacy; Older People; Policy discourse; Social welfare; Textual-analysis; Public policy},
