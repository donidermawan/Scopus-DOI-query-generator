@ARTICLE{Tan2025,
	author = {Tan, Michelle Xin Yi and Qu, Yao and Wang, Jue},
	title = {Student Perceptions of Generative Artificial Intelligence Regulations: A Mixed-Methods Study of Higher Education in Singapore},
	year = {2025},
	journal = {Higher Education Quarterly},
