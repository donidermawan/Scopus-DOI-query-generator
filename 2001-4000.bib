	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@BOOK{Huang2025168,
	author = {Huang, Rujing S. and Holzapfel, Andre and Sturm, Bob L. T.},
	title = {GLOBAL ETHICS: Reflection 2.0 (2024)},
	year = {2025},
	journal = {Artificial Intelligence and Music Ecosystem: Second Edition},
	pages = {168 - 170},
	doi = {10.4324/9781003516989-12},
	url = {https://www.scopus.com/pages/publications/105040019591?origin=resultslist},
	affiliations = {University of Hong Kong, Hong Kong; KTH Royal Institute of Technology, Sweden; KTH Royal Institute of Technology, Sweden},
	abstract = {This chapter highlights the flourishing research and industrial practice of music AI across Asia, a region with diverse cultural and philosophical traditions that can significantly reshape technology ethics historically centred on Western thought. In an earlier theoretical work, the authors proposed non-Western interpretations of three “ethically aligned design” principles-human rights, well-being, and awareness of misuse-aimed at reconceiving AI’s role in musical creation and engagement. This chapter builds upon that framework by drawing on interviews with music AI researchers, developers, and practitioners in various Asian contexts. Conversations reveal how stakeholders interpret and implement ethical guidelines: (1) bridging the potential for AI to “revive” music traditions while intensifying data and environmental challenges, (2) reevaluating “human-centred” design in relation to collective/post-humanist visions, and (3) grappling with corporate influences on data sourcing and cultural representation. The post-reflection commentary highlights new realities of AI expansion, from the surge in AI data centres in Asia to the push for culturally diverse music-generative systems and ongoing tensions surrounding model ownership, accountability, and cross-border knowledge flows. This chapter presents Asia-based perspectives and advances a pluralistic, cross-cultural approach to music AI ethics that can inform global creative practices and policies and help shape a music ecosystem thriving on local and transnational collaboration. © 2026 selection and editorial matter, Martin Clancy; individual chapters, the contributors.},
	keywords = {Computer music; Ethical technology; Corporates; Data challenges; Data sourcing; Datacenter; Design Principles; Environmental challenges; Human rights; Human-centred designs; Industrial practices; Well being; Industrial research},
	publisher = {Taylor and Francis},
	isbn = {978-104043684-4; 978-103284626-2},
	language = {English},
	abbrev_source_title = {Artificial Intelligence and Music Ecosystem: Second Edition},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Pandey2025207,
	author = {Pandey, Shalini and Agrawal, Aditya and Pandey, Shailesh Kumar and Imam, Md Mudassir},
	title = {Shifting Grounds in Exploring Diverse Approaches to AI Regulation: Comparative Analysis of Google, EU, and IFLA Perspectives on AI Policy},
	year = {2025},
	journal = {Modern Perspectives on Artificial Intelligence and Law},
	pages = {207 - 242},
	doi = {10.4018/979-8-3693-9576-9.ch011},
