	year = {2025},
	journal = {Generative AI for Software Development: Code Generation, Error Detection, Software Testing},
	pages = {293 - 314},
	doi = {10.1515/9783111677798-012},
	url = {https://www.scopus.com/pages/publications/105019156447?origin=resultslist},
	affiliations = {Department of Electronics and Communication Engineering, Vel Tech Rangarajan Dr. Sagunthala R&D Institute of Science and Technology, Tamil Nadu, Avadi, Chennai, India; Department of Networking and Communications, School of Computing, SRM Institute of Science and Technology, SRM Nagar, Kattankulathur, Tamil Nadu, Chennai, India; School of Computer Science and Engineering, Kerala University of Digital Sciences, Innovation and Technology, Digital University Kerala, Kerala, Thiruvananthapuram, India},
	abstract = {Generative artificial intelligence (AI) has turned out to be a revolutionary tool in software development scenarios by providing strategies for generating new code, detecting errors, and testing software. Integrations of GPT and large language models are significantly transforming how engineers think, write, debug, and opti mize their code. However, there are different challenges in using generative AI in the implementation of software development. These include issues related to contextcific programming requirements, bias in the generated output, and perhaps more portantly, issues of security and integrity in the generated programs. Overcoming these challenges is necessary if one is to fully realize the capabilities of generative AI while managing potential associated risks. At the same time, the benefits that tive AI provides in the software development process are also vast. The tion of software creation can contribute to a more open and progressive tech try. The ability of generative AI to train on code bases at speed makes it possible to build highly responsive systems that adapt to the needs of modern software ment. Both innovation and the over-orientation of AI’s virtues and capabilities sary for sustainability need to be managed. This chapter presents several trends and issues related to generative AI and suggests ideas on how software development can benefit from AI while addressing the risks. © 2025 Walter de Gruyter GmbH, Berlin/Boston, Genthiner Straße 13, 10785 Berlin.},
	author_keywords = {AI bias and fairness; AI collaboration with developers; AI ethics in develop ment; AI security challenges; code generation; Future Tech; generative AI; innovation in software development; large language models; programming automation},
	keywords = {Artificial intelligence; Automatic programming; Codes (symbols); Computer aided software engineering; Computer systems programming; Software testing; Artificial intelligence bias and fairness; Artificial intelligence collaboration with developer; Artificial intelligence ethic in develop ment; Artificial intelligence security challenge; Codegeneration; Future tech; Generative artificial intelligence; Innovation in software development; Language model; Large language model; Programming automation; Security challenges; Software design},
	publisher = {De Gruyter},
