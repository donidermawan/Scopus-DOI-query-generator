	pages = {},
	doi = {10.3390/healthcare13111348},
	url = {https://www.scopus.com/pages/publications/105007855553?origin=resultslist},
	affiliations = {School of Health Management, Harbin Medical University, Harbin, 150081, China; Department of Rheumatology and Immunology, The Second Affiliated Hospital of Harbin Medical University, Harbin, 150001, China; Department of General Chemistry, Bashkir State Medical University, Ufa, 450000, Russian Federation},
	abstract = {Background/Objectives: Artificial intelligence is rapidly permeating the field of psychiatry. It offers novel avenues for the diagnosis, treatment, and prediction of mental health disorders. This structured review aims to consolidate current approaches to the application of AI in telepsychiatry. In addition, it evaluates their technological maturity, clinical utility, and ethical–legal robustness. Methods: A systematic search was conducted across the PubMed, Scopus, and Google Scholar databases for the period spanning 2015 to 2025. The selection and analysis processes adhered to the PRISMA 2020 guidelines. The final synthesis included 44 publications, among which 14 were empirical studies encompassing a broad spectrum of algorithmic approaches—ranging from neural networks and natural language processing (NLP) to multimodal architectures. Results: The review revealed a wide array of AI applications in telepsychiatry, encompassing automated diagnostics, therapeutic support, predictive modeling, and risk stratification. The most actively employed techniques include natural language and speech processing, multimodal analysis, and advanced forecasting models. However, significant barriers to implementation persist—ethical (threats to autonomy and risks of algorithmic bias), technological (limited generalizability and a lack of explainability), and legal (ambiguous accountability and weak regulatory frameworks). Conclusions: This review underscores a growing disconnect between the rapid evolution of AI technologies and the institutional maturity of tools suitable for scalable clinical integration. Despite notable technological advances, the clinical adoption of AI in telepsychiatry remains limited. The analysis identifies persistent methodological gaps and systemic barriers that demand coordinated efforts across research, technical, and regulatory communities. It also outlines key directions for future empirical studies and interdisciplinary development of implementation standards. © 2025 by the authors.},
	author_keywords = {AI ethics; artificial intelligence; digital interventions; digital psychiatry; machine learning; remote diagnostics; telepsychiatry; translational research},
	correspondence_address = {Z. Kang; School of Health Management, Harbin Medical University, Harbin, 150081, China; email: kangzheng@hrbmu.edu.cn},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {22279032},
	language = {English},
	abbrev_source_title = {Healthcare (Basel)},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Addison2026234,
	author = {Addison, Letetia},
	title = {Ethical governance and artificial intelligence for climate resilience in small island developing states},
	year = {2026},
	journal = {Journal of Information, Communication and Ethics in Society},
	volume = {24},
	number = {2},
	pages = {234 - 249},
	doi = {10.1108/JICES-04-2025-0093},
	url = {https://www.scopus.com/pages/publications/105017747944?origin=resultslist},
	affiliations = {University Office of Planning, The University of the West Indies at St. Augustine, Saint Augustine, Trinidad and Tobago},
	abstract = {Purpose – This study aims to explore how artificial intelligence (AI) can ethically and effectively support climate resilience in small island developing states (SIDS). It presents a context-sensitive analysis that integrates ethical AI governance principles into regional adaptation strategies, addressing key structural and systemic barriers such as limited data infrastructure and inequitable access to climate finance. Design/methodology/approach – The study applies a qualitative thematic analysis, guided by Braun and Clarke’s (2006) six-phase framework, on a curated corpus of ten diverse documents, including peer-reviewed papers, UN policy reports, AI system overviews and technical evaluations of resilience platforms. To validate thematic patterns, natural language processing (NLP) tools such as keyword frequency and bigram analysis were applied. Findings – Four dominant themes emerged: (1) the necessity of open-access data platforms for regional resilience collaboration; (2) the integration of ethical AI governance frameworks; (3) the critical importance of community-centered adaptation approaches; and (4) persistent barriers in accessing climate finance. The convergence between manual thematic coding and NLP-supported validation reinforced the credibility of the findings. Research limitations/implications – The study is based solely on document analysis and does not include field-based engagement with SIDS communities. Future research could incorporate participatory methods (e.g. interviews and codesign workshops) or evaluate specific AI-driven initiatives to strengthen contextual validation. Practical implications – The paper offers actionable guidance for policymakers, including the establishment of regional data-sharing ecosystems, the adoption of ethical AI frameworks, investment in local technical capacity and reforms in international climate finance mechanisms to enhance equity for SIDS. Originality/value – By integrating ethical governance into AI climate resilience strategies tailored to small island contexts, this study addresses a significant gap in current scholarship and provides a scalable framework that balances technological innovation with environmental justice and regional equity. © 2025 Emerald Publishing Limited},
	author_keywords = {Artificial intelligence; Climate resilience; Disaster risk reduction; Ethical governance; Small island developing states (SIDS); Sustainable development},
