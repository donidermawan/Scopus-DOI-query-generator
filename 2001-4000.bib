@CONFERENCE{Cartier Van Dissel20252112,
	author = {Cartier Van Dissel, Mauritz N. and Martin-Gutierrez, Samuel and Espín-Noboa, Lisette and Jaramillo, Ana María and Karimi, Fariba},
	title = {HyperFA∗IR: A hypergeometric approach to fair rankings with finite candidate pool},
	year = {2025},
