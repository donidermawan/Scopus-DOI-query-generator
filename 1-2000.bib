@BOOK{Maas20251,
	author = {Maas, Matthijs M},
	title = {Architectures of Global AI Governance: From Technological Change to Human Choice},
	year = {2025},
	journal = {Architectures of Global AI Governance: From Technological Change to Human Choice},
