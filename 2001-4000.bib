@CONFERENCE{Jirathachanon2025392,
	author = {Jirathachanon, Arisa and Soodphakdee, Denpong and Tientanopajai, Kitt and Kanarkard, Wanida},
	title = {KKU Intelsphere: AI Governance by Design for Mitigating Privacy Risks in Higher Education},
	year = {2025},
	journal = {2025 7th International Workshop on Artificial Intelligence and Education, WAIE 2025},
	pages = {392 - 396},
	doi = {10.1109/WAIE67422.2025.11381045},
	url = {https://www.scopus.com/pages/publications/105034747855?origin=resultslist},
	affiliations = {Khon Kaen University, Office of the President, Thailand; Khon Kaen University, Dept. of Mechanical Engineering, Thailand; Khon Kaen University, Dept. of Computer Engineering, Thailand},
	abstract = {This study presents a rigorous institutional case analysis of KKU IntelSphere, a university-hosted generative artificial intelligence platform at Khon Kaen University (KKU), examining its role in redefining AI governance paradigms within higher education. Confronting the dual imperatives of technological innovation and data protection, this research investigates how academic institutions can mitigate the welldocumented risks associated with public AI tools through purpose-built, institutionally controlled alternatives. Employing a sequential explanatory mixed-methods design, we collected and analyzed quantitative survey data (\mathrm{N}=643) followed by in-depth qualitative interviews (\mathbf{n}=\mathbf{3 2}) across faculty, administrators, and technical staff. Multivariate regression analysis reveals significant predictors of adoption, with perceived utility emerging as the strongest determinant (β=0.72, \mathrm{p}\lt0.01, 95% CI [0.65, 0.79]). Despite 68% of respondents expressing persistent data security concerns, adoption rates exceeded initial projections by 22%, suggesting a complex reconciliation of perceived risks and benefits that warrants theoretical elaboration. Our findings position KKU IntelSphere not merely as a technological intervention, but as a transformative institutional governance mechanism establishing normative benchmarks for responsible AI adoption in academia. The paper concludes by presenting this model as a transferable strategy for other institutions seeking to foster responsible AI integration while safeguarding institutional data.  © 2025 IEEE.},
