@ARTICLE{Hellrigel-Holderbaum2025,
	author = {Hellrigel-Holderbaum, Max and Dung, Leonard},
	title = {Misalignment or misuse? The AGI alignment tradeoff},
	year = {2025},
	journal = {Philosophical Studies},
	pages = {},
	doi = {10.1007/s11098-025-02403-y},
	url = {https://www.scopus.com/pages/publications/105018727246?origin=resultslist},
	affiliations = {Friedrich-Alexander-Universität Erlangen-Nürnberg, Centre for Philosophy and AI Research, Werner-von-Siemens-Str. 61, Erlangen, 91054, Germany; Ruhr-Universität Bochum, Institute of Philosophy II, Universitätsstraße 150, Bochum, 44801, Germany},
	abstract = {Creating systems that are aligned with our goals is seen as a leading approach to create safe and beneficial AI in both leading AI companies and the academic field of AI safety. We defend the view that misaligned AGI – future, generally intelligent (robotic) AI agents – poses catastrophic risks. At the same time, we support the view that aligned AGI creates a substantial risk of catastrophic misuse by humans. While both risks are severe and stand in tension with one another, we show that – in principle – there is room for alignment approaches which do not increase misuse risk. We then investigate how the tradeoff between misalignment and misuse looks empirically for different technical approaches to AI alignment. Here, we argue that many current alignment techniques and foreseeable improvements thereof plausibly increase risks of catastrophic misuse. Since the impacts of AI depend on the social context, we close by discussing important social factors and suggest that to reduce the risk of a misuse catastrophe due to aligned AGI, techniques such as robustness, AI control methods and especially good governance seem essential. © The Author(s) 2025.},
	author_keywords = {AI alignment; AI misuse; AI safety; Existential risk; Instrumental convergence; Power concentration},
