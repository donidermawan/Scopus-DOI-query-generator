	url = {https://www.scopus.com/pages/publications/105035001792?origin=resultslist},
	affiliations = {Amity University Uttar Pradesh, Amity Business School, India; Al Kitab University, Kirkuk, Iraq; Klef Deemed to Be University, Koneru Lakshmaiah Education Foundation(KLEF), Department of Cse, AP, Vaddeswaram, India; Al-Farahidi University, Baghdad, Iraq; Knowledge University, College of Engineering, Department of Computer Engineering, Erbil, Iraq; K.Ramakrishnan College of Engineering, Department of Ece, Trichy, India},
	abstract = {AI personalization tools within e-commerce help companies connect better with customers through customized suggestions and automated services plus data predictions. Consequently, the effectiveness of e-commerce AI personalization tools is often hampered in the non-Western markets due to their lack of cultural and linguistic adaptation. To address this problem, this study employs recommendation systems and Natural Language Processing NLP tools that work with Arabic dialect variations and cultural nuances, which it faces in the Middle East. The aim is to create an AI framework incorporating personalization technology and a cultural adaptation approach in order to provide tailored and ethical suggestions. This study converted deep learning-based recommendation systems to work with Arabic datasets and improved Transformer-based NLP to get better sentiment analysis and user experience optimization. Hofstede's cultural dimensions provide a framework for advisor-tailored recommendations and the factors for Middle Eastern consumer preferences, religious issues, and shopping behavior. Finally, the proposed framework shows clear superiority in both personalization, based on the accuracy of the suggested items and their sentiment interpretation. It also introduces a bias evaluation methodology capable of decreasing 25% the level of demographic biases, establishing a benchmark for responsible AI practices. A significant conclusion of the results is that they demonstrate the growth of Middle Eastern e-commerce through improved user engagement and trust. This research demonstrates how AI systems could help users to become attached with their cultural identity and increase inclusivity and scalability in e-commerce domain. © 2025 IEEE.},
	author_keywords = {AI-driven Personalization; Arabic NLP; Cultural Adaptation in E-Commerce; Ethical AI; Recommendation Systems},
