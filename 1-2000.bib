@ARTICLE{Basty20251,
	author = {Basty, Roshanak and Kropczynski, Jess and Halse, Shane},
	title = {EMPOWERING FACULTY IN CREATIVE AND CULTURAL DISCIPLINES: AI LITERACY AND IMAGE GENERATOR INTEGRATION IN HIGHER EDUCATION},
	year = {2025},
	journal = {Journal of Information Technology Education: Innovations in Practice},
