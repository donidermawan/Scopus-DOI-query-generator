@CONFERENCE{Mike-Ewewie2025,
	author = {Mike-Ewewie, David and Lim, Panhapiseth and Sotelo, Alejandro and Kumar, Priyanka},
	title = {WIP: Data-Driven Adaptive Curriculum-Personalizing Academic Pathways for Enhanced Engineering Student Success},
	year = {2025},
	journal = {Proceedings - Frontiers in Education Conference, FIE},
	pages = {},
	doi = {10.1109/FIE63693.2025.11328295},
	url = {https://www.scopus.com/pages/publications/105033024858?origin=resultslist},
	affiliations = {The University of Texas Permian Basin, Department of Computer Science, Odessa, TX, United States},
	abstract = {This work-in-progress innovative practice paper explores a key reason why many engineering students drop out: rigid university course plans. A single failed class can derail a student for an entire year, a system especially tough for learners who struggle with long-term planning. To address this, we introduce a framework that acts as a personal academic guide. This guide faces a classic learning challenge: It must determine the best course for each student's unique situation (their 'context') by constantly and intelligently balancing what has worked for similar students in the past with trying new options to see if they might work even better. This formal learning problem is known as a contextual multi-armed bandit. Our framework applies this approach to power an adaptive course recommendation system to create a flexible roadmap for each student that adheres to ABET accreditation standards. We tested our bandit framework in an offline simulation on the Open University Learning Analytics (OULAD) dataset, a public record of 32,593 students. To solve the balancing challenge, we used a statistical approach that intelligently weighs recommending proven, successful courses (exploitation) against suggesting new, uncertain ones to discover their potential (exploration); a method known as Thompson Sampling. This strategy reduced suboptimal course recommendations by 66% compared to a standard popularity-based method. The system also maintained algorithmic fairness across gender groups and demonstrated it'a potential for real-world scalability. This work demonstrates the practical application of reinforcement learning for a more supportive and successful educational experience. © 2025 IEEE.},
	author_keywords = {Adaptive computer learning; Contextual bandits; Engineering curriculum; Student retention; Undergraduate},
	keywords = {Accreditation; Computer aided instruction; Curricula; Education computing; Engineering education; Reinforcement learning; Adaptive computer learning; Adaptive curriculums; Computer learning; Contextual banditti; Data driven; Engineering curriculum; Innovative practices; Student retention; Student success; Undergraduate; Students},
