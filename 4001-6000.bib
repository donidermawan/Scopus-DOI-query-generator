	affiliations = {University of West Florida (UWF), Department of Intelligent Systems and Robotics, United States; Dhaka University of Engineering & Technology (DUET), Department of Computer Science and Engineering, Bangladesh; College of Nursing, Wayne State University, United States; Washington University of Science & Technology, Department of Computer Science, United States; University of West Florida, Department for Cybersecurity, United States; University of Calabria, IDEA Lab, Italy; Marquette University, Department of Computer Science, United States},
