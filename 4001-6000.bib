	url = {https://www.scopus.com/pages/publications/105036487628?origin=resultslist},
	affiliations = {Texas State University, San Marcos, TX, United States},
	abstract = {As AI systems increasingly engage in ethical decision-making in sensitive applications like healthcare, autonomous systems, and legal matters, understanding and validating their moral reasoning has become critical for trustworthy deployment. While philosophical literature distinguishes between major ethical frameworks such as Deontology, Utilitarianism, Justice, Virtue Ethics, and Commonsense Morality, it remains unclear whether large language models (LLMs) generate meaningfully distinct reasoning patterns when prompted under different theoretical perspectives. We investigate this question by introducing a controlled, same-scenario, multi-framework corpus of more than 38K GPT-oss and LLaMA-4-Scout generated ethical justifications responding to identical moral dilemmas from the ETHICS dataset. We employ shared BERTopic modeling across all theories to assess cross-theory separability, and per-theory BERTopic modeling to characterize framework-specific thematic structures. Topics were evaluated using purity (majority-theory share), embedding-based coherence (semantic consistency), and alignment to canonical philosophical keywords. Our findings demonstrate that ethical theories produce identifiable linguistic signatures, validating transformer-based topic modeling as an interpretability tool to analyze AI moral reasoning and providing computational evidence for philosophical ethical framework separability.  © 2025 IEEE.},
	author_keywords = {AI ethics; BERTopic; interpretability; large language models; moral decision making},
	keywords = {Artificial intelligence; Computational linguistics; Decision making; Ethical technology; Information systems; Modeling languages; AI ethic; Bertopic; Decisions makings; Interpretability; Language model; Large language model; Modeling analyzes; Moral decision making; Moral reasoning; Topic Modeling; Semantics},
