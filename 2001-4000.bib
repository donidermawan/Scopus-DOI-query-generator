@CONFERENCE{Shalamova2025,
	author = {Shalamova, Nadya and Imas, Olga and Lembke, James and Pares-Toral, Maria and Riley, Derek David and Bergen, Daniel},
	title = {BOARD # 94: WIP: Shaping the Future of Learning: The rAIder Strategy for Applied AI-Driven Education at MSOE},
