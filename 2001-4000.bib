@ARTICLE{Critelli2025,
	author = {Critelli, Brian and Hassan, Amier and Lahooti, Ila and Noh, Lydia and Park, Jun Sung and Tong, Kathleen and Lahooti, Ali and Matzko, Nathan and Adams, Jan Niklas and Liss, Lukas and Quion, Justin and Restrepo, David and Nikahd, Melica and Culp, Stacey and Lacy-Hulbert, Adam and Speake, Cate and Buxbaum, James and Bischof, Jason and Yazici, Cemal and Evans-Phillips, Anna and Terp, Sophie and Weissman, Alexandra and Conwell, Darwin and Hart, Philip and Ramsey, Mitchell and Krishna, Somashekar and Han, Samuel and Park, Erica and Shah, Raj and Akshintala, Venkata and Windsor, John A. and Mull, Nikhil K. and Papachristou, Georgios and Celi, Leo Anthony and Lee, Peter},
