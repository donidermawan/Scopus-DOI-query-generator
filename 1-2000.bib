@CONFERENCE{Jiang2025,
	author = {Jiang, Xiaohua and Liu, Ming},
	title = {Ship Object Detection Deployment and Optimization Based on Yulong810A},
	year = {2025},
	journal = {Journal of Physics: Conference Series},
	volume = {3109},
	number = {1},
	pages = {},
	doi = {10.1088/1742-6596/3109/1/012096},
	url = {https://www.scopus.com/pages/publications/105023433003?origin=resultslist},
	affiliations = {Harbin Institute of Technology, Harbin, 150001, China; Zhuhai Aerospace Microchips Science & Technology Co. Ltd, Guangdong, Zhuhai, 519080, China},
	abstract = {Ship object detection plays a critical role in maritime security and resource management, yet traditional algorithms struggle with insufficient accuracy in complex scenarios. This paper proposes an improved YOLOv5s-based ship detection deployment and optimization scheme using the domestically developed Yulong810A embedded AI chip. First, to address the arbitrary orientation of ships, we introduce an Oriented Bounding Box (OBB) mechanism with angle regression branches and a sine-cosine encoding strategy to enhance detection precision. Second, leveraging the parallel processing unit (PPU) of Yulong810A, we optimize post-processing via hardware acceleration, reducing data transfer overhead between CPU and NPU. Experiments on the DOTA dataset demonstrate that the OBB approach achieves a mean Average Precision (mAP) of 96.5%, surpassing horizontal bounding boxes by 3.3%. Post-processing latency is reduced from 95ms to 65ms, achieving a real-time inference rate of 30 FPS with a power consumption of only 6W. Compared to platforms like NVIDIA Jetson TX2, Yulong810A exhibits superior accuracy, real-time performance, and energy efficiency, validating its practicality in edge computing scenarios.  © Published under licence by IOP Publishing Ltd.},
