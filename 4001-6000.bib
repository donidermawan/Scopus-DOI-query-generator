@CONFERENCE{García2025,
	author = {García, Beatriz Amante and García, Cristina Amante},
	title = {Artificial Intelligence as a Tool in Project Management Education},
	year = {2025},
	journal = {IEEE Global Engineering Education Conference, EDUCON},
	pages = {},
	doi = {10.1109/EDUCON62633.2025.11016536},
	url = {https://www.scopus.com/pages/publications/105008213468?origin=resultslist},
	affiliations = {Universidad Politécnica de Catalunya (UPC), Barcelona Tech, Ingeniería de Proyectos y de la Construccion, Intexter, Terrassa, Spain; Equipo Técnico de Fiscalía y Juzgados de Menores de Alicante, Valencian Community, Alicante, Spain},
	abstract = {The integration of artificial intelligence (AI) tools in project management education is profoundly transforming teaching practices, creating numerous opportunities, and introducing challenges that require systematic attention. This analysis explores the advantages, potential drawbacks, and broader implications of teaching students to use AI effectively and ethically in this field, aiming to enhance both academic and professional outcomes. One of the most significant benefits of incorporating AI in education is its ability to streamline various tasks, such as report writing and structuring, automating evaluation and analysis processes, and identifying areas for academic improvement. These capabilities allow students to focus on more strategic aspects of their projects while leveraging AI for efficiency. For instance, students can use AI to brainstorm innovative ideas, draft detailed and well-organized project plans, and conduct advanced simulations. These tools can bring theoretical concepts to life, bridging the gap between classroom learning and real-world applications. Furthermore, the use of AI fosters the development of critical digital skills that are increasingly vital in today's competitive job market, ensuring that students remain adaptable and resourceful as they enter the workforce. Nevertheless, the integration of AI also presents notable challenges. One primary concern is the potential for over-reliance on these tools, which could hinder the development of essential skills such as critical thinking, problem-solving, and analytical reasoning. Students may become dependent on AI-generated solutions, limiting their ability to approach problems independently. Additionally, inadequate technological literacy may lead to misinterpretations, inefficient use of tools, or even unintentional plagiarism, emphasizing the need for comprehensive education on the responsible use of AI. Addressing these challenges requires a deliberate focus on teaching students how to use AI tools effectively and ethically. This involves providing structured instruction on the limitations of AI, strategies for validating AI-generated information, and practical methods for integrating these tools into specific project management contexts. By understanding the strengths and weaknesses of AI, students can leverage it as a supportive resource rather than a replacement for human creativity and judgment. In conclusion, while the integration of AI in project management education offers transformative potential, its success depends on equipping students with the knowledge and skills to use these tools strategically and responsibly. This approach will help to practice and improve both transversal and specific skills, highlighting oral and written expression, ethics, planning, synthesis, among others. It ensures that AI serves as an enabler of innovation and effective problem-solving, rather than a barrier to personal and professional growth. This holistic development framework emphasizes the significance of diverse competencies, fostering a well-rounded and adaptive skill set in an evolving landscape. © 2025 IEEE.},
	author_keywords = {AI Ethics; Artificial Intelligence; Critical Thinking; Digital Skills; Educational Challenges; Learning Enhancement; Project Management Education; Report Writing; Simulation Tools},
	keywords = {E-learning; Education computing; Employment; Engineering education; Information management; Integration; Project management; Students; Teaching; Artificial intelligence ethic; Artificial intelligence tools; Critical thinking; Digital skills; Educational challenge; Learning enhancements; Problem-solving; Project management education; Report writing; Simulation tool; Artificial intelligence},
