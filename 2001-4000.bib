	author = {De Longueville, Bertrand and Sanchez, Ignacio and Kazakova, Snezha and Luoni, Stefano and Zaro, Fabrizio and Daskalaki, Kalliopi and Inchingolo, Marco},
	title = {The Proof Is in the Eating: Lessons Learnt from One Year of Generative AI Adoption in a Science-for-Policy Organisation},
	year = {2025},
	journal = {AI (Switzerland)},
	volume = {6},
	number = {6},
	pages = {},
	doi = {10.3390/ai6060128},
