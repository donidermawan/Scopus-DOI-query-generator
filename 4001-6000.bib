@ARTICLE{Muyskens2025167,
	author = {Muyskens, Kathryn and Ballantyne, Angela and Savulescu, Julian and Nasir, Harisan Unais and Muralidharan, Anantharaman},
	title = {The Permissibility of Biased AI in a Biased World: An Ethical Analysis of AI for Screening and Referrals for Diabetic Retinopathy in Singapore},
	year = {2025},
	journal = {Asian Bioethics Review},
	volume = {17},
	number = {1},
	pages = {167 - 185},
	doi = {10.1007/s41649-024-00315-3},
