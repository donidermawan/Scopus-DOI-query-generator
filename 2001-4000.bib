@CONFERENCE{Shukla2025,
	author = {Shukla, Varsha and Parker, Geoffrey G.},
	title = {On Addressing Bias and Fairness in Large Language Models for Responsible Innovation in Gender Contexts},
	year = {2025},
	journal = {2025 Gender and Technology Conference, GTC 2025},
	pages = {},
	doi = {10.1109/GTC64325.2025.11478234},
	url = {https://www.scopus.com/pages/publications/105037575188?origin=resultslist},
	affiliations = {Thayer School of Engineering, Dartmouth College, Hanover, NH, United States},
	abstract = {Large Language Models (LLMs) have become transformative tools in automating decision-making processes across critical domains such as healthcare, criminal justice, education, and social media. By enabling unprecedented advances in efficiency, insight generation, and user interaction, LLMs hold the potential to reshape societal norms and systems. How-ever, their widespread deployment also raises significant ethical concerns, particularly regarding the amplification of gender biases embedded within their training data. Such biases not only perpetuate historical inequities but also exacerbate them, resulting in unfair treatment and representation of gender-diverse groups in high-stakes applications. This paper examines the ethical implications of gender bias in LLMs and its ripple effects across societal structures. By dissecting the sources and manifestations of these biases-including their roots in skewed training datasets, historical inequities, and feedback loops-we highlight their real-world impacts in sensitive contexts like healthcare diagnostics, predictive policing, and AIcompanionship platforms. The study proposes novel approaches to mitigate these biases, including fairness metrics such as Demographic Parity, Equal Opportunity, and the Bias Impact Score, which provide robust tools for detecting and addressing disparities. Additionally, we introduce real-time bias monitoring techniques and emotional impact metrics to ensure ethical responsiveness, particularly in applications where user well-being is at risk. Our findings demonstrate the effectiveness of these methods, including 22% reduction in gender bias in healthcare diagnostics, 30% improvement in equitable outcomes in predictive policing, and enhanced psychological safety in AI companionship platforms. This research underscores the critical need for interdisciplinary approaches that prioritize fairness, transparency, and accountability in LLM design and deployment. By integrating ethical considerations into every stage of AI development, from dataset curation to real-time bias mitigation, we can foster responsible AI innovation that empowers marginalized communities, challenges societal stereotypes, and promotes equitable outcomes. Through this work, we aim to pave the way for a transformative shift in AI development - one where technology serves as a force for equity and inclusivity, aligning advancements in artificial intelligence with the values of fairness, respect, and diversity. © 2025 IEEE.},
	author_keywords = {AI Companionship; Algorithmic Accountability; Bias Mitigation; Data Ethics; Demographic Parity; Equal Opportunity; Ethical AI; Fairness Metrics; Gender Bias in AI; Health care Diagnostics; Predictive Policing; Societal Impact of AI},
