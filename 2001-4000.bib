@CONFERENCE{Rahman2025580,
	author = {Rahman, Md Mizanur},
	title = {The RAILE Framework: Guiding Ethical and Effective Use of AI in Higher Education},
	year = {2025},
	journal = {Proceedings of the 2025 17th International Conference on Education Technology and Computers, ICETC 2025},
	pages = {580 - 584},
	doi = {10.1109/ICETC66579.2025.11387191},
	url = {https://www.scopus.com/pages/publications/105035197964?origin=resultslist},
	affiliations = {Regent College London, School of Engineering & Computing, London, United Kingdom},
	abstract = {The integration of Artificial Intelligence (AI) into higher education presents both transformative learning opportunities and challenges to academic integrity. While AI-enhanced learning tools such as generative platforms, intelligent feedback systems, and adaptive learning technologies offer significant benefits - including enhanced efficiency, personalized support, and inclusivity for diverse students - their uncritical or unguided use raises concerns about academic integrity, reduced cognitive engagement, and overreliance on technology. This paper addresses these tensions by introducing the RAILE Framework - Reflect, Analyze, Interact, Learn, Evaluate - a pedagogically grounded, student-centered framework designed to guide the ethical and responsible use of AI in academic contexts, operationalizing AI literacy and supporting academic integrity. Drawing on constructivist and metacognitive theories, RAILE encourages students to reflect on learning goals, critically analyze AI-generated content, engage in meaningful interactions with peers and tools, construct deep knowledge, and evaluate both the quality and ethical implications of their AI use. A review of current literature highlights gaps in existing educational frameworks, institutional policies and pedagogical support, revealing a need for clearer, values-based guidance. The RAILE Framework responds to this need by offering a structured model for embedding AI literacy into curriculum design, assessment, and student development. Rather than banning AI-enhanced tools, the framework supports their intentional use to foster academic integrity, digital literacy, and critical thinking. It empowers students to use AI not as a shortcut, but as a tool to enhance their learning and take ownership of their self-directed learning. The paper concludes by recommending future research into the framework's integration across academic disciplines and student populations, including longitudinal studies to assess its impact on learning outcomes, ethical awareness, and educational engagement. © 2025 IEEE.},
