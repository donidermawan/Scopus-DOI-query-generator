@BOOK{Bisaillon2025220,
	author = {Bisaillon, Jean-Robert},
	title = {PHILOSOPHY: Reflection 2.0 (2024): Can We Build Ethical Handrails into the Code?},
	year = {2025},
	journal = {Artificial Intelligence and Music Ecosystem: Second Edition},
	pages = {220 - 222},
	doi = {10.4324/9781003516989-15},
	url = {https://www.scopus.com/pages/publications/105039985493?origin=resultslist},
	abstract = {This chapter examines the evolving relationship between musicians and machines that can generate music indistinguishable from that created by humans. Martin Clancy develops a theoretical model with real-world capacity to address the economic and ethical implications of AI technologies. The model will show that many accepted values based on humanist philosophical traditions are insufficient to tackle the challenges posed by AI technologies. For instance, expressions of intellectual property (IP) are formulated as economic rewards solely for human creativity. Likewise, at national and intergovernmental levels, the development of AI ethics reports (EU, OECD, and WIPO) is based on unquestioned concepts of ‘human-centred’ values and adheres to a highly interpretable definition of human well-being. Martin Clancy argues that an ecological, non-anthropocentric, posthuman framework is necessary to effectively enhance the mission of the UN Sustainable Development Goals (SDGs). Music serves as a relevant and pragmatically examinable case study for investigating AI’s provocations and considering the associated legal and ethical responsibilities. This chapter will define the ‘sustainable music ecosystem’ and deepen theoretical approaches to AI ethics. The newly added reflection deepens these discussions by examining how actor-network theory (ANT) reframes our understanding of human and nonhuman agencies within the music ecosystem. It highlights the ongoing tensions between economic threats posed by AI, such as displacing creative labour and the public’s more nuanced perception of AI-driven innovations. Drawing on Bourdieu’s Habitus theory and Lovelock’s Novacene, the reflection underscores that the human-machine dynamic unfolds differently across social classes, cultural contexts, and technological networks. Collaborative Governance Regime Theory is proposed as a framework for embedding “ethical handrails” directly into AI coding practices, emphasising that governance structures must integrate both industry profit motives and the preservation of cultural richness. Ultimately, music is reaffirmed as a “socially predictive art form, " cautioning us to build sustainability, transparency, and reciprocity into the code before we find ourselves at the mercy of automated decision-making and cultural stagnation. © 2026 selection and editorial matter, Martin Clancy; individual chapters, the contributors.},
	keywords = {Ecosystems; Ethical technology; Sustainable development; AI Technologies; Case-studies; Economic implications; Ethical implications; Human creativity; Property; Real-world; Theoretical modeling; Value-based; Well being; Decision making},
	publisher = {Taylor and Francis},
	isbn = {978-104043684-4; 978-103284626-2},
	language = {English},
	abbrev_source_title = {Artificial Intelligence and Music Ecosystem: Second Edition},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

