@CONFERENCE{Abd-Ellatif2025232,
	author = {Abd-Ellatif, Laila and Abrar, Mohammad and Ismaeel, Alaa},
	title = {Towards Trustworthy AI in IoT Security with Outlier Guided Multi-Stage Sentiment Analysis},
	year = {2025},
	journal = {2025 4th International Conference on Computing, Management and Telecommunications, ComManTel 2025},
	pages = {232 - 237},
	doi = {10.1109/ComManTel68363.2025.11368520},
	url = {https://www.scopus.com/pages/publications/105033896649?origin=resultslist},
	affiliations = {Arab Open University, Faculty of Computer Studies, Muscat, Oman},
	abstract = {The rapid development of the Internet of Things (IoT) has presented significant cybersecurity challenges, as resource-constrained devices are capable of generating large volumes of heterogeneous data that is susceptible to advanced attacks. The existing deep learning-based models, which can be single-stage BERT classifiers, have demonstrated good performance but are computationally costly, creating latency bottlenecks and hindering scalability in real-time IoT applications. This paper proposes a new multi-stage outlier-centric sentiment analysis model designed to achieve balanced accuracy, efficiency, and risk minimization in detecting threats within the IoT. The framework runs in three steps: (i) the lightweight pre-screening with the use of lexicon-based sentiment scoring and statistical outlier detection filters benign traffic, (ii) the high-fidelity verification with the use of distance-based and reconstruction-based models lowers the number of false alarms, and (iii) the final classification of confirmed outliers is done with the help of deep sentiment analysis based on BERT. Experimental results on benchmark datasets (CICIDS2017, Bot-IoT, and UNSW-NB15) reveal that the proposed model achieves a 1-point increase in accuracy and F1-score over state-of-the-art baselines, while reducing latency by up to 20% compared to single-stage BERT. The multi-objective analysis also supports the fact that the reduced risk has been realized by balancing the false positives and false negatives. The findings emphasize that the framework can make AI IoT security trustworthy, not only in technical performance terms, but also in correspondence to risk-conscious principles of AI governance.  © 2025 IEEE.},
	author_keywords = {Deep Learning; IoT Security; Multi-Stage Framework; Outlier Detection; Risk-Aware AI; Sentiment Analysis},
	keywords = {Anomaly detection; Classification (of information); Internet of things; Network security; Risk analysis; Risk assessment; Risk management; Statistics; Cyber security; Deep learning; Internet of thing security; Multi-stage framework; Multi-stages; Outlier Detection; Risk aware; Risk-aware AI; Sentiment analysis; Single stage; Deep learning; Sentiment analysis},
