@CONFERENCE{Solic20251654,
	author = {Solic, K. and Juric, I. and Paksic, B. Herceg},
	title = {The Use of AI in Healthcare: Students' Opinions on Ethical Considerations, Legal Consequences, and Future Implications},
	year = {2025},
	journal = {2025 MIPRO 48th ICT and Electronics Convention, MIPRO 2025 - Proceedings},
	pages = {1654 - 1658},
