@CONFERENCE{Kaji2025,
	author = {Kaji, Hirotaka and Kuribayashi, Jun and Ohtani, Hikaru and Ema, Arisa},
	title = {Performance or Governance? Serious Game and Workshop as a Tool for Fostering Awareness of Responsible AI},
	year = {2025},
	journal = {Conference on Human Factors in Computing Systems - Proceedings },
	pages = {},
	doi = {10.1145/3706599.3719951},
