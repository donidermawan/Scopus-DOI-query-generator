	title = {AI Governance Strategies for the Public Sector},
	year = {2025},
	journal = {Public Administration, Governance and Globalization},
	volume = {6},
	pages = {309 - 325},
	doi = {10.1007/978-3-032-00514-4_16},
	url = {https://www.scopus.com/pages/publications/105019364627?origin=resultslist},
	affiliations = {German University of Administrative Sciences Speyer, Speyer, Germany},
	abstract = {Artificial intelligence (AI) is a highly capable, cross-cutting technology. It offers many benefits to the public sector, especially with regard to efficiency and effectiveness gains. However, the use of AI in the public sector is also associated with a variety of risks that must be taken into account. Since the tasks of the public sector should be carried out in the interests of citizens and AI is a powerful and rapidly evolving technology, appropriate and agile AI governance is essential. In the public sector, governance is particularly important because it should ensure that tasks are carried out in the interests of citizens, that abuses of power are prevented, and that the activities of the state remain transparent. Furthermore, a technology that imitates human intelligence, i.e., becomes a public servant itself, should also behave like one and serve the people. Hence, this chapter introduces a public value-based agile approach to AI governance and explains different AI governance strategies for the public sector. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {AI governance; Artificial intelligence; Public sector governance; Public values; Technology governance},
	correspondence_address = {B.W. Wirtz; German University of Administrative Sciences Speyer, Speyer, Germany; email: ls-wirtz@uni-speyer.de},
