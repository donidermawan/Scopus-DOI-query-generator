	title = {Privacy-Preserving AI-Based Solutions},
	year = {2025},
	journal = {Data Privacy, Data Property, and Data Sharing: An Interdisciplinary Perspective for Post-Pandemic Transnational Scientific Research},
	pages = {172 - 176},
	doi = {10.1201/9781003475927-18},
	url = {https://www.scopus.com/pages/publications/105023718834?origin=resultslist},
	affiliations = {University of Tübingen, Tübingen, Germany},
	abstract = {AI-based solutions can be found in many different domains. In the medical domain, building a trustworthy AI-based model usually requires gathering a significant amount of patient data, which is usually not available in one place (e.g., a hospital). This data cannot be shared as easily as training data for AI-based models in other domains due to the sensitive nature of the data. For example, sensitive attributes like the disease status should be kept private to the outside world but are essential when training a model able to distinguish between patients that have the disease and patients that do not have the disease. Therefore, there has been a lot of interest in developing secure platforms and frameworks for training AI-based models for privacy-sensitive data. This chapter introduces several different concepts, like federated learning, distributed learning as well as cryptographic methods, presents examples of implementations of these concepts, and outlines future developments. © 2025 Mariavittoria Catanzariti, Francesca Incardona, Giorgio Resta and Anders Sönnerborg.},
	keywords = {Anonymity; Differential privacy; Medicine; Privacy-preserving techniques; Cryptographic methods; Different domains; Distributed learning; Learning methods; Medical domains; Patient data; Privacy preserving; Sensitive attribute; Training data; Sensitive data},
