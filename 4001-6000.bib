	url = {https://www.scopus.com/pages/publications/105033354154?origin=resultslist},
	affiliations = {Saveetha Institute of Medical and Technical Sciences (SIMATS), Saveetha University, Department of Electronics and Communication Engineering, Saveetha School of Engineering, Tamil Nadu, Chennai, India},
	abstract = {Cervical cancer continues to be a significant worldwide health issue, disproportionately impacting women from socioeconomically disadvantaged communities. To meet the WHO's eradication objectives, there is an urgent need for equitable and data-driven policies for early detection and prevention. This paper introduces a machine learning framework that utilizes Conditional Generative Adversarial Networks and Variational Autoencoders to enhance underrepresented subgroups in cervical cancer datasets. By stratifying models based on socioeconomic status (SES) indicators such as educational attainment, income, and healthcare access we analyze discrepancies in prediction performance and algorithmic bias among demographic groups. We employ fairness-aware criteria, such as Equal Opportunity Difference and Demographic Parity, to assess and alleviate bias. Using generative augmentation, the empirical results demonstrate an increase in AUC from 0.82 to 0.90, a 35% decrease in the Equal Opportunity Difference, and a 2 8 % reduction in the performance disparities between groups with high and low socioeconomic status. Our findings indicate that generative augmentation improves representation of minority groups, reduces performance gaps, and enhances overall model equity. This research highlights the potential of generative A I in mitigating socioeconomic disparities in healthcare and advocates for the creation of transparent, equitable, and inclusive cervical cancer risk prediction systems.  © 2025 IEEE.},
	author_keywords = {Algorithmic Fairness; Bias Mitigation; Cervical Cancer; Data Augmentation; Generative Adversarial Networks (GANs); Health Equity; Machine Learning; Socioeconomic Disparities; Variational Autoencoders (VAEs)},
