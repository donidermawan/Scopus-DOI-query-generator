@CONFERENCE{Jeyachandran20251532,
	author = {Jeyachandran, Jerein and Khastgir, Siddartha and Zhao, Xingyu and Barbier, Eric and Jennings, Paul},
	title = {Introducing OASISS: ODD-Based AI Safety in AutonomouS Systems},
	year = {2025},
	journal = {IEEE Conference on Intelligent Transportation Systems, Proceedings, ITSC},
	pages = {1532 - 1539},
	doi = {10.1109/ITSC60802.2025.11423137},
	url = {https://www.scopus.com/pages/publications/105037018137?origin=resultslist},
	affiliations = {University of Warwick, WMG, Coventry, United Kingdom; Wayve Technologies Ltd., London, United Kingdom},
	abstract = {The rise in automation across industries is leading to machines increasingly performing functions that render human intervention obsolete. Artificial Intelligence (AI) unlocks the machine's ability to reach higher levels of autonomy by carrying out the tasks of reasoning and planning based on its perceived surroundings. With AI becoming increasingly responsible for safety-critical functions, it is imperative for manufacturers, regulators and certification authorities to ensure these functions are performed safely. Scenario-based methods have emerged as an effective solution to train and test the AI model of autonomous systems. It allows the system to be exposed to the various operational conditions it may encounter once deployed into the real world. However, this raises the question of whether the operational conditions considered for the training and testing of the AI model are truly sufficient. OASISS (ODD-based AI Safety In autonomouS Systems) aims to quantitatively assess the adequacy of the training and testing data of an AI model in relation to its targeted area of operation. The OASISS framework uncovers the gaps that are prevalent in the current scenario-based training and testing landscape and provides an evaluation mechanism guided by the dataset-related safety properties outlined in ISO PAS 8800. © 2025 IEEE.},
	author_keywords = {AI safety; autonomous systems; completeness; representativeness; safety assurance},
	keywords = {Artificial intelligence; Safety engineering; Statistical tests; Artificial intelligence safety; Autonomous system; Completeness; Human intervention; Intelligence models; Machine ability; Operational conditions; Representativeness; Safety assurance; Training and testing; Safety testing},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21530009},
	isbn = {979-833152418-0},
	language = {English},
	abbrev_source_title = {IEEE Conf Intell Transport Syst Proc ITSC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Dasgupta20255,
	author = {Dasgupta, Prithviraj and Marriott, Damian and Li, Li and Narayanan, Priya},
	title = {Intelligent and Autonomous Systems in Government},
