	keywords = {Contrastive Learning; Data accuracy; Data consistency; Data quality; Discriminators; Generative adversarial networks; Learning systems; Data augmentation; Dynamic graph; Fairness; Graph contrastive learning; Group-based; Learning frameworks; Sensitive attribute; Skewed distribution; User groups; User levels; Recommender systems},
