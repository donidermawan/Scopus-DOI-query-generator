@ARTICLE{Wasserziehr202565,
	author = {Wasserziehr, Jan Henrik},
	title = {The Moral Ambiguity of the AI Consciousness Debate},
	year = {2025},
	journal = {Frontiers in Artificial Intelligence and Applications},
	volume = {397},
