	year = {2025},
	journal = {Proceedings - RoEduNet IEEE International Conference},
	pages = {},
	doi = {10.1109/RoEduNet68395.2025.11208334},
	url = {https://www.scopus.com/pages/publications/105022414626?origin=resultslist},
	affiliations = {Interdisciplinary School of Doctoral Studies, University of Bucharest, Bucharest, Romania; University of Reading, United Kingdom},
	abstract = {Algorithmic decision-making in recruitment promises efficiency but raises acute concerns about bias and fairness. We present a minimal, transparent audit protocol for large language models (LLMs) in a hiring context and apply it to OpenAI's ChatGPT 4.5 (Orion) and Google's Gemini 2.5 Pro. Using 10 synthetic CVs (5 per model), we measure (i) the realism of generated career trajectories via the correlation between Age and Years of Experience (YoE), and (ii) fairness of a Seniority threshold (YoE≥ 12) across Gender and Age group. We disclose the exact prompts used to generate the CVs and the rules for parsing textual YoE values (e.g., '7+') into numeric data to ensure reproducibility. Formal correlation statistics show that ChatGPT produces a strong and significant Age-YoE association (Pearson r=.91, p=.03; Spearman p=.90, p =.04), whereas Gemini shows a moderate, non-significant relationship (r=.58, p=.30; p=.50, p=.39). No CV reached the Seniority threshold, precluding fairness tests and illustrating how threshold design can mask disparities. Our results demonstrate how lightweight audits can surface model-behaviour differences and audit-design vulnerabilities before deployment, offering HR practitioners a practical on-ramp to ethical AI oversight under high-risk regulatory regimes such as the EU AI Act. © 2025 IEEE.},
	author_keywords = {algorithmic bias; fairness audit; HR analytics; LLMs; synthetic data},
