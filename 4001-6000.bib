@CONFERENCE{Gauba2025335,
	author = {Gauba, Aayush},
	title = {The Imitation Fallacy: Why Behavioral Equivalence Cannot Verify Artificial Consciousness},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 7th International Conference on Cognitive Machine Intelligence, CogMI 2025},
	pages = {335 - 340},
	doi = {10.1109/CogMI67134.2025.00045},
	url = {https://www.scopus.com/pages/publications/105036064741?origin=resultslist},
	affiliations = {Southern Illinois University Edwardsville, United States},
	abstract = {Modern language models and multimodal agents routinely pass behavioral benchmarks that once served as proxies for 'thinking.' Popular discourse increasingly treats these performances as evidence of consciousness. We argue that this inference commits the Imitation Fallacy: confusing behavioral equivalence with experiential equivalence. Building on the Subjectivity Barrier, the epistemic fact that consciousness is irreducibly first person we show that even a perfect Turing style performance leaves an agent's inner life forever uncertain. As a result, no external test, however sophisticated, can verify or falsify artificial consciousness. We formalize this limit, derive the Undetectability Corollary, and propose the Emergence Criterion as a more principled though still probabilistic framework for assessing when artificial systems might deserve moral consideration. Our analysis reframes ongoing debates about AGI, rights, and AI safety and clarifies why 'human level"intelligence is an incoherent benchmark for consciousness evaluation. This paper presents a conceptual and theoretical contribution aimed at clarifying a cognitive error in AI perception. We do not conduct new empirical work, but instead synthesize insights from cognitive science and public behavior to outline a formal framework for evaluating consciousness claims in artificial agents. © 2025 IEEE.},
	author_keywords = {artificial consciousness; emergence criterion; imitation fallacy; subjectivity barrier},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159205-9},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Cogn. Mach. Intell., CogMI},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

