	keywords = {Arts computing; Computer vision; Deep learning; Ethical aspects; Generative adversarial networks; Intellectual property; Learning algorithms; Learning systems; Natural language processing systems; Neural networks; Self-supervised learning; Supervised learning; Adversarial networks; AI creativity; Auto encoders; Autonomous data generation; Data generation; Ethical AI; Generative adversarial network; Generative model; Synthetic data; Transformer modeling; Variational autoencoder; Decision making},
