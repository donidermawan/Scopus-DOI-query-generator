@ARTICLE{Wadhwa202544,
	author = {Wadhwa, Sakshi},
	title = {Content blocking orders and status of digital rights: Assessment of two key verdicts in India},
	year = {2025},
	journal = {Information and Communications Technology Law},
	volume = {34},
