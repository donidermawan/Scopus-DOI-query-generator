@CONFERENCE{Aldarmini2025348,
	author = {Aldarmini, Sokrat and Nafea, Mohamed},
	title = {Shapley-Value Based Feature Attribution for Explainability and Algorithmic Fairness: A Model-Agnostic Benchmark},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {348 - 355},
	doi = {10.1109/ICDMW69685.2025.00046},
	url = {https://www.scopus.com/pages/publications/105035387270?origin=resultslist},
	affiliations = {Missouri S&T, Electrical & Computer Engineering, Rolla, MO, United States},
	abstract = {The Shapley value function has witnessed an increasing use for explainability and algorithmic fairness in machine learning (ML), providing insight to model understanding, responsible data governance and preemptive fairness auditing. In ML systems, Shapley value is often used as a feature attribution method to quantify the marginal contribution of dataset features either locally to an individual sample prediction or globally to an overall utility of the model. This work introduces Shaplyze (or Shapley analysis), an open source, modular, and extensible toolkit for quantifying feature contribution to global model utility metrics including predictive accuracy and group-level fairness. Unlike existing toolkits, Shaplyze allows for a model agnostic approach in which utility functions could be defined based on the empirical data distribution or data samples and not only model predictions, supporting data centric explanations. Shaplyze includes utility functions like mutual information and its partial decomposition, maximum mean discrepancy, distance covariance, Hilbert-Schmidt independence, normalized cross covariance, as well as fairness metrics like statistical parity and equalized odds differences. Our toolkit also supports asymmetric Shapley values, enabling the integration of causal constraints into attribution. Through comprehensive numerical experiments on several realworld datasets, we show how Shaplyze offers a unified toolkit for existing methods. Further, we present two case studies comparing various existing utility functions for feature attribution under distinct settings and derive novel insight about their usability. © 2025 IEEE.},
	author_keywords = {Explainable AI; Feature attribution; Machine learning fairness; Model agnostic analysis; Shapley value},
	keywords = {Benchmarking; Consensus algorithm; Learning algorithms; Machine learning; Open systems; Algorithmics; Explainable AI; Feature attribution; Machine learning fairness; Machine-learning; Model agnostic analyze; Shapley value; Utility functions; Value functions; Value-based; Learning systems},
	correspondence_address = {S. Aldarmini; Missouri S&T, Electrical & Computer Engineering, Rolla, United States; email: sokrataldarmini@mst.edu; M. Nafea; Missouri S&T, Electrical & Computer Engineering, Rolla, United States; email: mnafea@mst.edu},
