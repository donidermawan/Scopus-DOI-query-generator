@CONFERENCE{Jayanth20251095,
	author = {Jayanth, Jessy K. and Sundaram, Asha and Ganesan, Dharshini and Prabhu, Tiksha and Vaishnavi, A. and Thanigaivel, Keerthana},
	title = {Artificial Intelligence and Queer theory for Gender classification: Encoding AI Framework},
	year = {2025},
	journal = {2025 International Conference on Emerging Technologies and Innovation for Sustainability, EmergIN 2025},
	pages = {1095 - 1099},
	doi = {10.1109/EmergIN67762.2025.11450737},
	url = {https://www.scopus.com/pages/publications/105036384237?origin=resultslist},
	affiliations = {Saveetha Institute of Medical and Technical Sciences (SIMATS), Saveetha School of Law, Department of Constitutional Law, India; Saveetha Institute of Medical and Technical Sciences (SIMATS), Saveetha School of Law, Chennai, India; Saveetha University, Saveetha School of Law, Saveetha Institute of Medical and Technical Science (SIMATS), Chennai, 600-007, India},
	abstract = {Nowadays, artificial intelligence (AI) is a significant aspect of daily life and influences choices in fields including internet platforms, recruiting personnel, healthcare, and financial problems. However, the design and application of AI systems might reveal and exacerbate gender-based discrimination. Using concepts from queer theory, this paper examines how gender prejudice in AI systems impacts persons who don't neatly fall into either the male or female groups. The objective of the research includes encoding AI, a new framework of ethical and technically sound gender classification. It describes how these prejudices lead to the exclusion of those who identify as non-binary or gender nonconforming. Automated age and gender classification is a crucial step in face picture analysis that facilitates several real-time applications, including targeted ads, forensics, and human-computer interaction. However, a variety of characteristics, including background, facial emotions, viewing position, and facial appearance, make it difficult to categorise age and gender. When the photos are taken in erratic or shifting conditions, background, facial emotions, viewing position, and facial appearance, make it difficult to categorise age and gender. When the photos are taken in erratic or shifting conditions, it becomes even more difficult. This paper addresses this by introducing a facial image-based automated gender categorisation (AGC) model. The model is intended to recognise the gender and age of the subjects in the pictures. Standard datasets were cast-off to assess the model's presentation, and the outcomes were seen from several angles. The specified solution can help not only boost the reliability in predictive models, but also serves to lay out a foundation of incorporating such socio-technical governance as nondisclosure options, revocation protocols, and fairness constraints across non-dominant subgroup  © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Automated Gender Classification; Gender Classification; Queer Theory},
	keywords = {Automation; Computation theory; Ethical aspects; Group theory; Human computer interaction; Artificial intelligence systems; Automated gender classification; Condition; Daily lives; Encodings; Facial appearance; Facial emotions; Gender classification; Queer theory; Artificial intelligence},
	correspondence_address = {J.K. Jayanth; Saveetha Institute of Medical and Technical Sciences (SIMATS), Saveetha School of Law, Department of Constitutional Law, India; email: Jessyjayanth123@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833155603-7},
	language = {English},
	abbrev_source_title = {Int. Conf. Emerg. Technol. Innov. Sustain., EmergIN},
	type = {Conference paper},
	publication_stage = {Final},
