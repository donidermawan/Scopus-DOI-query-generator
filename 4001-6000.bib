}

@CONFERENCE{Jia2025391,
	author = {Jia, Jingqi and Tian, Yunzhe and Zhao, Xinyi and Shi, Xiangyu and Ye, Ping and Cui, Xiaoshu and Gu, Yanfeng and Wu, Xingyu and Cheng, Dianjing and Niu, Wenjia},
	title = {Graph Neural Network-Enhanced Semantic Invariant Robust Watermarking for Large Language Models},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 10th International Conference on Data Science in Cyberspace, DSC 2025},
	pages = {391 - 398},
	doi = {10.1109/DSC67331.2025.00057},
	url = {https://www.scopus.com/pages/publications/105033062483?origin=resultslist},
	affiliations = {Beijing Jiaotong University, Beijing Key Laboratory of Security and Privacy in Intelligent Transportation, Beijing, China},
	abstract = {While large language models (LLMs) exhibit increasingly advanced capabilities in text generation, they also bring new challenges, such as the spread of AI-generated misinformation and potential copyright issues. Consequently, detecting text generated by LLMs has become a crucial task in the domains of AI ethics and safety. Although recent watermarking approaches have made notable progress in resisting paraphrasing attacks by leveraging semantic information, their dependence on static semantic representations limits their ability to fully capture the complex contextual dependencies between tokens. To address this limitation, we propose GNN-SIR (Graph Neural Network-enhanced Semantic Invariant Robust watermarking), a method that represents text as a graph structure, where nodes correspond to tokens and edges encode both positional and semantic relationships. This design allows the model to accurately capture deep structural features that remain invariant under paraphrasing or rewriting. Our dual-connection architecture combines both positional proximity and semantic similarity connections. When these graph representations are processed using Graph Attention Networks (GATs), the model can adaptively focus on semantically important token relationships. Building on this, we propose an aggregation mechanism that generates the final semantic embedding by combining token representations with dynamically assigned attention weights. Extensive experiments across a variety of attack scenarios demonstrate that GNN-SIR achieves an average detection F1 score of approximately 0.95, representing a 4% improvement over the best existing methods. These results show that our graph-based enhancement approach significantly improves detection performance against semantically-preserving attacks while maintaining high-quality text output.  © 2025 IEEE.},
	author_keywords = {graph neural networks; large language models; semantic invariance; text watermarking},
	keywords = {Computational linguistics; Digital watermarking; Graph embeddings; Graph neural networks; Graph structures; Semantic Web; Semantics; Watermarking; Enhanced semantics; Graph neural networks; Language model; Large language model; Robust watermarking; Semantic invariance; Semantics Information; Static semantics; Text generations; Text watermarking; Graphic methods},
	correspondence_address = {W. Niu; Beijing Jiaotong University, Beijing Key Laboratory of Security and Privacy in Intelligent Transportation, Beijing, China; email: niuwj@bjtu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157924-1},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Data Sci. Cyberspace, DSC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Shankari2025,
	author = {Shankari, Mano and Singh, Seema and Balusamy, Balamurugan and Sridhar, Sunaina},
	title = {A Hybrid AI Framework for Real-Time Fault Detection and Self-Healing in Renewable-Rich Smart Grids},
	year = {2025},
	journal = {2025 IEEE 4th International Conference for Advancement in Technology, ICONAT 2025},
	pages = {},
	doi = {10.1109/ICONAT66879.2025.11362653},
	url = {https://www.scopus.com/pages/publications/105033909479?origin=resultslist},
	affiliations = {Alliance School of Advanced Computing, Alliance University, Bangalore, India; Symbiosis Centre for Corporate Education, Symbiosis International (Deemed University), Department of Electrical and Electronics Engineering, Pune, India; School of Engineering and IT, Manipal Academy of Higher Education, Dubai, United Arab Emirates; Google LLC, Chicago, United States},
	abstract = {Modern power distribution systems are increasingly integrating renewable energy sources, which introduces challenges in fault detection, grid stability, and self-healing due to their intermittent nature. This paper proposes a novel AI-driven framework that combines Convolutional Neural Networks (CNNs), Graph Neural Networks (GNNs), and Reinforcement Learning (RL) agents to detect, localize, and recover from faults in real time. The methodology employs a KL-divergence and entropy-based anomaly detection model, topology-aware GNNs for fault path inference, and a reward-optimized Q-learning strategy for adaptive control actions. Experimental evaluations on a renewable-rich 123-bus grid dataset demonstrate a fault detection accuracy of 96.8%, with recovery time reduced by 72% compared to conventional methods. This hybrid AI architecture not only enhances grid resilience and operational efficiency but also significantly improves societal outcomes by reducing outage durations, enhancing service reliability, and supporting sustainable energy adoption. The proposed system presents a scalable solution for next-generation smart grids with high renewable penetration. © 2025 IEEE.},
	author_keywords = {Fault Localization; Graph Neural Networks (GNN); Reinforcement Learning (RL); Renewable Energy Integration; Smart Grid Resilience},
	keywords = {Computer system recovery; Electric power transmission networks; Fault detection; Natural resources; Neural networks; Power distribution faults; Renewable energy; Smart power grids; Topology; Fault localization; Graph neural network; Graph neural networks; Reinforcement learning; Reinforcement learnings; Renewable energy integrations; Renewables; Self-healing; Smart grid; Smart grid resilience; Reinforcement learning},
