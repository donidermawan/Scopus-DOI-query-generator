	keywords = {Artificial intelligence; Cost benefit analysis; Cost engineering; Cost estimating; Forecasting; Patient treatment; Cost prediction; Costs estimates; Explainable AI; Health care costs; Healthcare cost prediction; Local interpretable model-agnostic explanation; Patient empowerments; Shapley; Shapley additive explanation; Xgboost; Lime},
