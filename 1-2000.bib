@ARTICLE{Ramu2025,
	author = {Ramu, Vakapalli and Murty, Paramsetti Sri Ramachandra},
	title = {Artificial neural network-based study of unsteady MHD radiative hybrid nanofluid flow with activation energy in a porous medium},
	year = {2025},
	journal = {International Journal of Thermofluids},
	volume = {30},
	pages = {},
	doi = {10.1016/j.ijft.2025.101460},
	url = {https://www.scopus.com/pages/publications/105020661246?origin=resultslist},
	affiliations = {Department of Mathematics, Rajiv Gandhi University of Knowledge Technologies, Andhra Pradesh, Nuzvid, 521201, India; Department of Mathematics, GITAM School of Sciences, GITAM (Deemed to be University), Andhra Pradesh, Visakhapatnam, 530045, India},
	abstract = {This study investigates the unsteady heat and mass transfer characteristics of water-based hybrid nanofluid flow over a stretching surface embedded in a porous medium under mixed convection conditions. The hybrid nanofluid consists of titanium dioxide (TiO₂) and copper (Cu) nanoparticles dispersed in water. The analysis incorporates the effects of activation energy, thermal radiation, Brownian motion, and thermophoresis. The governing partial differential equations are transformed into ordinary differential equations using similarity transformations and solved numerically with a fourth-order Runge-Kutta method coupled with the shooting technique. The influence of key dimensionless parameters including magnetic field strength, Prandtl number, buoyancy ratio, unsteadiness parameter, thermal radiation, chemical reaction rate, and activation energy on velocity, temperature, and concentration profiles is examined. To improve predictive capability, an artificial neural network (ANN) is employed to estimate the skin friction coefficient using SCG, LM, CGB, and CGF algorithms. Performance evaluation through mean square error (MSE), regression plots, and error analysis indicates that the Levenberg–Marquardt (LM) algorithm provides superior accuracy, making it the most efficient method for predicting heat transfer characteristics. This hybrid numerical AI framework demonstrates strong potential for accurately modeling magnetohydrodynamic hybrid nanofluid transport phenomena. The findings contribute to improved design and thermal management strategies in advanced energy and engineering systems. © 2025 The Author(s)},
	author_keywords = {Activation energy; Artificial neural network (ANN); Brownian motion and thermophoresis; Hybrid nanofluid; Levenberg–Marquardt algorithm; Porous medium},
	keywords = {Activation analysis; Error analysis; Friction; Heat radiation; Heat transfer performance; Magnetohydrodynamics; Mass transfer; Mean square error; Nanofluidics; Neural networks; Ordinary differential equations; Porous materials; Prandtl number; Radiation effects; Runge Kutta methods; Temperature control; Thermal Engineering; TiO2 nanoparticles; Artificial neural network; Brownian; Brownian motion and thermophoresis; Energy; Heat-transfer characteristics; Hybrid nanofluid; Levenberg-Marquardt algorithm; Nanofluid flow; Neural-networks; Porous medium; Activation energy; Brownian movement},
	correspondence_address = {P.S.R. Murty; Department of Mathematics, GITAM School of Sciences, GITAM (Deemed to be University), Visakhapatnam, Andhra Pradesh, 530045, India; email: dparamse@gitam.edu},
