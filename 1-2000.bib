	source = {Scopus},
	note = {Cited by: 4; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Hodaj2025156,
	author = {Hodaj, Albana and Laçka, Senada},
	title = {AI, Ethics, and Human-Centered Policy in Albanian Education},
	year = {2025},
	journal = {Interdisciplinary Journal of Research and Development},
