@ARTICLE{Jeong2025,
	author = {Jeong, Taeksoo and Hwang, Geonhwi and Kim, Doo Young},
	title = {A Generative AI Framework for Cognitive Intervention in Older Adults: An Integrated Engineering Design and Clinical Protocol},
	year = {2025},
	journal = {Healthcare (Switzerland)},
