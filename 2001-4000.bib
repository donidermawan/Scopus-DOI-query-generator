@BOOK{Patne2025195,
	author = {Patne, Akshata Yashwant and Suryawanshic, Meghraj},
	title = {Ethical considerations in artificial intelligence-powered patient counseling},
	year = {2025},
	journal = {Artificial Intelligence in Patient Counselling},
	pages = {195 - 232},
	doi = {10.1016/B978-0-443-43823-3.00011-X},
	url = {https://www.scopus.com/pages/publications/105027151611?origin=resultslist},
	affiliations = {Department of Pharmaceutical Science, Taneja College of Pharmacy, Tampa, FL, United States; Department of Internal Medicine, Center for Research and Education in Nanobioengineering, Morsani College of Medicine, University of South Florida, Tampa, FL, United States; Department of Pharmaceutics, Sandip Institute of Pharmaceutical Sciences (SIPS), Affiliated To Savitribai Phule Pune University (SPPU, Pune), Maharashtra, Nashik, India},
	abstract = {The integration of artificial intelligence (AI) in patient counseling, through chatbots and virtual health assistants (VHAs), has transformed healthcare by improving accessibility, efficiency, and personalized patient interactions. However, its broad implementation raises critical ethical concerns, such as data privacy risks, algorithmic bias, questions of accountability, and the need to uphold patient autonomy. AI-driven counseling tools provide real-time support and tailored recommendations, yet they also risk perpetuating biases embedded in training datasets, potentially exacerbating disparities in healthcare outcomes. Furthermore, accountability concerns arise when AI-generated recommendations result in misleading or harmful information, raising complex questions regarding responsibility and liability in patient care. The management of sensitive health information by AI systems necessitates stringent data security measures and regulatory compliance to protect patient confidentiality. Case studies underscore both the advantages and ethical challenges of AI in patient counseling, especially in mental health applications, where concerns about privacy, suitability, and trust have emerged. As AI continues to evolve within healthcare systems, the development of robust legal and ethical frameworks, transparent AI governance, and interdisciplinary collaboration among policymakers, healthcare professionals, and technologists is imperative. The responsible deployment of AI in patient counseling requires the integration of bias detection mechanisms, ethical oversight, and continuous monitoring to uphold trust, fairness, and equitable access to healthcare services. By addressing these ethical considerations proactively, AI technologies can be effectively integrated into patient counseling while ensuring compliance with ethical standards, fostering patient confidence, and preserving the quality of healthcare delivery. © 2026 Elsevier Inc. All rights reserved..},
	author_keywords = {Accountability and Liability; Algorithmic Bias; Artificial Intelligence (AI) in Healthcare; Data Privacy and Security; Ethical Considerations; Patient Counseling; Trust and Transparency in AI Systems; Virtual Health Assistants (VHAs)},
	keywords = {Artificial intelligence; Data privacy; Ethical technology; Health care; Information management; Medical computing; Product liability; Transparency; Accountability and liability; Algorithmic bias; Algorithmics; Artificial intelligence  in healthcare; Artificial intelligence systems; Data privacy and securities; Ethical considerations; Patient counseling; Trust and transparency in artificial intelligence system; Virtual health assistant; Regulatory compliance},
	publisher = {Elsevier},
	isbn = {978-044343823-3; 978-044343822-6},
	language = {English},
	abbrev_source_title = {Artificial Intelligence in Patient Counselling},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

