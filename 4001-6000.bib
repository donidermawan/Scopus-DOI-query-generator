	title = {Ethical Considerations in AI-Driven Surveillance Systems},
	year = {2025},
	journal = {2025 3rd International Conference on Computational Intelligence and Network Systems, CINS 2025},
	pages = {},
	doi = {10.1109/CINS67018.2025.11412167},
	url = {https://www.scopus.com/pages/publications/105035189793?origin=resultslist},
	affiliations = {Technical Systems Engineer Cisco Systems, Inc., Herndon, VA, United States; Senior Software Engineer Target Corporation, Lakeville, MN, United States; Software Development Engineer in Test Mphasis Corporation, Overland Park, KS, United States; Dr. D. Y. Patil School of Science and Technology, Dr. D. Y. Patil Vidyapeeth Tathawade, Pune, 411033, India; GLA University, Department of Computer Engineering & Applications, Mathura, India; School of Computer Science and Artificial Intelligence, SR University, Telangana, Warangal, 506371, India},
	abstract = {Surveillance technology is increasingly employed both in private and public places with enhanced surveillance capacity, but with very grave ethical concerns, one of the significant among them being invasion of privacy, discriminatory algorithms, and having no mechanism of having sufficient legal accountability. These issues are conveniently brushed under the carpet due to technological advances at a breakneck speed, and that is endangering marginalized groups and civil liberties. This paper presents a novel, measurable Ethical Risk Score (ERS) model based on ethical theory mapping, mathematical risk modeling, and case analysis. Compared to previous work on intangible ethics, this model is measurable and scalable in terms of its capacity to assess AI surveillance activity. The application of a utilitarian argument is established in empirical evidence in the world at large, the most dangerous application of facial recognition technology to policing. Analytic insights are translated into policy and design implications for policy relevance. Findings indicate that Facial Recognition in Policing had the highest Ethical Risk Score at 77.6%, and Retail Consumer Tracking had the lowest score at 45.0%, with context-specific regulation coupled with ethical protection.  © 2025 IEEE.},
	author_keywords = {AI Surveillance; Ethical Framework; Ethical Risk Assessment; Privacy and Bias; Responsible AI Design},
