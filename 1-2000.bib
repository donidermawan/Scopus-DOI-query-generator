@CONFERENCE{Sun2025488,
	author = {Sun, Ruining and Hu, Hongsheng and Luo, Wei and Zhang, Zhaoxi and Zhang, Yanjun and Yuan, Haizhuan and Zhang, Leo Yu},
	title = {When Better Features Mean Greater Risks: The Performance-Privacy Trade-Off in Contrastive Learning},
	year = {2025},
	journal = {Proceedings of the ACM Conference on Computer and Communications Security},
	pages = {488 - 500},
	doi = {10.1145/3708821.3733915},
	url = {https://www.scopus.com/pages/publications/105015980506?origin=resultslist},
	affiliations = {Xiangtan University, Hunan, Xiangtan, China; University of Newcastle, Newcastle, NSW, Australia; Deakin University, Burwood, VIC, Australia; University of Technology Sydney, Ultimo, NSW, Australia; Griffith University, Southport, QLD, Australia},
	abstract = {With the rapid advancement of deep learning technology, pre-trained encoder models have demonstrated exceptional feature extraction capabilities, playing a pivotal role in the research and application of deep learning. However, their widespread use has raised significant concerns about the risk of training data privacy leakage. This paper systematically investigates the privacy threats posed by membership inference attacks (MIAs) targeting encoder models, focusing on contrastive learning frameworks. Through experimental analysis, we reveal the significant impact of model architecture complexity on membership privacy leakage: As more advanced encoder frameworks improve feature-extraction performance, they simultaneously exacerbate privacy-leakage risks. Furthermore, this paper proposes a novel membership inference attack method based on the p-norm of feature vectors, termed the Embedding Lp-Norm Likelihood Attack (LpLA). This method infers membership status, by leveraging the statistical distribution characteristics of the p-norm of feature vectors. Experimental results across multiple datasets and model architectures demonstrate that LpLA outperforms existing methods in attack performance and robustness, particularly under limited attack knowledge and query volumes. This study not only uncovers the potential risks of privacy leakage in contrastive learning frameworks, but also provides a practical basis for privacy protection research in encoder models. We hope that this work will draw greater attention to the privacy risks associated with self-supervised learning models and shed light on the importance of a balance between model utility and training data privacy. Our code is publicly available at: https://github.com/SeroneySun/LpLA-code.  © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Contrastive learning; likelihood estimation; membership inference attack; privacy leakage; trustworthy AI},
	keywords = {Contrastive Learning; Data privacy; Deep learning; Feature extraction; Human engineering; Information leakage; Learning systems; Risk assessment; Self-supervised learning; Signal encoding; Supervised learning; Features extraction; Inference attacks; Learning frameworks; Likelihood estimation; Membership inference attack; Modeling architecture; Performance; Privacy leakages; Training data; Trustworthy AI; Economic and social effects},
	correspondence_address = {H. Yuan; Xiangtan University, Xiangtan, Hunan, China; email: yhz@xtu.edu.cn; L.Y. Zhang; Griffith University, Southport, Australia; email: leo.zhang@griffith.edu.au},
