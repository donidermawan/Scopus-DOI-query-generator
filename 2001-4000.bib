@CONFERENCE{Ipung2025164,
	author = {Ipung, Heru Purnomo},
	title = {NAEF: A Novel Framework in Evaluating Enterprise Artificial Intelligence from Insights and Decisions},
	year = {2025},
	journal = {Proceedings - 2025 9th International Conference on Information Technology, Information Systems and Electrical Engineering, ICITISEE 2025},
	pages = {164 - 169},
	doi = {10.1109/ICITISEE68184.2025.11355144},
	url = {https://www.scopus.com/pages/publications/105032947812?origin=resultslist},
	affiliations = {Master of Information Technology, Swiss German University, Tangerang, Indonesia},
	abstract = {This paper proposes a novel framework for evaluating enterprise AI, continuing from the previous NAEF Architecting Enterprise AI Framework that emphasizing the integration of three frameworks (TOGAF, BADIR, and INSIGHT) to create a robust and comprehensive methodology, in which at the end of the previous paper was acknowledging the important of Trusted AI. Building upon this architectural foundation, this work further addresses a critical impediment to realizing the strategic value of enterprise AI: the chasm between technical validation and executive trust. While technical teams concentrate on component-level correctness-measuring factual accuracy and task completion-business leaders require holistic assurance across a sociotechnical spectrum that includes governance, ethics, and transparency. This disconnect creates a 'trust blind spot,' leading to technically sound but organizationally inert AI investments. To bridge this gap, a unified, multi-layered Enterprise AI Evaluation Framework is proposed to move beyond component-level metrics. This framework introduces a holistic assessment of AI systems by integrating technical validation with the principles of organizational trust-building. It evaluates AI on three progressive levels: Technical Correctness (Is the system functionally correct?), Systemic Credibility (Can the process be trusted?), and Institutional Integrity (Does the decision align with organizational values and risk tolerance?). The framework provides a strategic roadmap for engineering credible and trustworthy AI, transforming trust from a soft goal into a measurable, manageable strategic asset. Sample previous works were cited to highlight the issues, challenges and opportunities from the framework point of view. © 2025 IEEE.},
	author_keywords = {AI Evaluation; Enterprise AI; Executive Trust; Technical Validation; Trust Blind Spot; Trust Gap; Trustworthy AI},
	keywords = {Building components; Information systems; Information use; Investments; AI evaluation; Blind spots; Component levels; Enterprise AI; Executive trust; Organisational; Technical validation; Trust blind spot; Trust gap; Trustworthy AI; Artificial intelligence},
	correspondence_address = {H.P. Ipung; Master of Information Technology, Swiss German University, Tangerang, Indonesia; email: heru.ipung@sgu.ac.id},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156012-6},
	language = {English},
	abbrev_source_title = {Proc. - Int. Conf. Inf. Technol., Inf. Syst. Electr. Eng., ICITISEE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yadav2025,
	author = {Yadav, Anjali},
	title = {AI-driven enforcement of human rights in global supply chains: enhancing transparency, accountability, and corporate compliance},
	year = {2025},
	journal = {International Review of Law, Computers and Technology},
	pages = {},
	doi = {10.1080/13600869.2025.2602108},
	url = {https://www.scopus.com/pages/publications/105024808989?origin=resultslist},
	affiliations = {Law Center-II, Faculty of Law, University of Delhi, New Delhi, India},
	abstract = {In recent years, the entry of artificial intelligence into supply-chain management has changed how corporations look at compliance and human rights. Artificial intelligence or AI is being used progressively in the global supply chains not only to enhance traceability, detect threats, and assist businesses but also to aid in adhering to human rights regulations. However, incorporation of the technologies into corporate governance presents its own set of new difficulties, even though businesses and authorities portray them as answers to long-standing problems like forced labor in industry and child labor in agriculture. This paper critically examined the ways in which AI affects human rights enforcement in complicated manufacturing networks. It argues that while algorithmic technologies increase visibility, they also provide additional levels of opaqueness, unequal regulation, and foreign control, which frequently disproportionately affect Global South suppliers. The author has examined three main ideas. First, it investigated the conflict between algorithmic opacity and accountability, wondering whether AI improves openness or merely substitutes one type of secrecy with another. Secondly, it investigated the implications of extraterritorial regulation, specifically that how AI interacts with legislative frameworks from the Global North, such as UK Modern Slavery Act 2015, the German Supply Chain Due Diligence Act 2021, and the EU Corporate Sustainability Due Diligence Directive (CSDDD), and how these laws are affecting the producers in developing economies. Lastly, it examined the erosion of legal diversity and sovereignty, examining how AI-driven compliance systems perpetuate Northern goals while potentially undermining local labor standards and regulatory autonomy in countries such as India, Bangladesh, and the Democratic Republic of Congo. Drawing on the diverse spectrum of academic and policy literature like the UN Guiding Principles on Business and Human Rights (2011), OECD and ILO publications, this research places AI into the larger global political economy of regulation. It suggested that algorithmic governance might impair structural inequities unless it is based on transparent, participative, and context-sensitive frameworks. Conclusively, this research calls for a more inclusive approach. The study contended that AI should supplement and not replace, legal responsibility, and that effective accountability must be supported in human rights principles that respect the diversity and sovereignty of the Global South. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {AI in supply chains; global supply chain transparency; human rights enforcement},
	correspondence_address = {A. Yadav; Law Center-II, Faculty of Law, University of Delhi, New Delhi, India; email: anjali@law.du.ac.in},
	publisher = {Routledge},
	issn = {13600869},
	language = {English},
	abbrev_source_title = {Int. Rev. Law Comput. Technol.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 3}
}

