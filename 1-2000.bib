@ARTICLE{Li2025,
	author = {Li, Wei-Hsuan and Yu, Hsin-Chun},
	title = {Using KeyGraph and ChatGPT to Detect and Track Topics Related to AI Ethics in Media Outlets},
	year = {2025},
	journal = {Mathematics},
