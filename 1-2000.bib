	keywords = {accuracy; adult; Article; artificial intelligence; body mass; breast cancer; cancer radiotherapy; computer assisted tomography; convolutional neural network; deep learning; dose volume histogram; female; human; major clinical study; personalized medicine; prediction; radiation dermatitis; radiomics; retrospective study; volumetric modulated arc therapy; workflow},
	correspondence_address = {P.-J. Chao; Medical Physics and Informatics Laboratory of Electronics Engineering, National Kaohsiung University of Science and Technology, Kaohsiung, 80778, Taiwan; email: pjchao99@gmail.com; Y.-W. Lin; Department of Radiation Oncology, Kaohsiung Veterans General Hospital, Kaohsiung, 81341, Taiwan; email: marklin1108@gmail.com},
