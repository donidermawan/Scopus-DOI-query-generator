	url = {https://www.scopus.com/pages/publications/105040519434?origin=resultslist},
	affiliations = {Amity University Dubai, Learning Resource Center, Dubai, United Arab Emirates},
	abstract = {The integration of artificial intelligence (AI) in academic libraries has transformed research and information literacy practices. However, global disparities remain in librarians' readiness to address AI's ethical and technical challenges. This study examines these disparities, particularly between well-resourced regions (e.g., North America) and lower-resourced areas (e.g., Africa), highlighting implications for fair access to knowledge. A systematic review of 40 peer-reviewed articles (2021-2025) reveals three main issues: (1) significant competency gaps, with librarians in resource-limited contexts lacking essential AI skills; (2) widespread ethical concerns, as AI systems reinforce gender or racial bias; and (3) insufficient training, with many libraries lacking structured AI literacy programs. Through a structured comparative analysis framework, we quantify and visualize these disparities across four dimensions: Technical Competency, Ethical Awareness, Institutional Support, and Pedagogical Integration, providing a systematic approach to understanding global AI literacy variations. The findings highlight deeper inequalities linked to historical patterns of knowledge production. The study recommends structured, practical training programs, transparent governance policies, and cross-institutional partnerships to lower training costs. It also advocates for feminist ethical frameworks and inclusive AI design practices. By implementing these strategies, libraries can actively promote ethical AI use, fostering fairness and equity in knowledge access.  © 2025 IEEE.},
	author_keywords = {academic libraries; AI literacy; algorithmic bias; and feminist AI ethics; global disparities},
	keywords = {Artificial intelligence; Ethical technology; Libraries; Structured programming; Academic libraries; Algorithmic bias; Algorithmics; And feminist artificial intelligence ethic; Artificial intelligence literacy; Competency gaps; Global disparities; Information literacy; Systematic Review; Technical challenges; Personnel training},
