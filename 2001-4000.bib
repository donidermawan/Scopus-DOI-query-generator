	keywords = {Benchmarking; Brain mapping; Deep learning; Diagnosis; Dimensionality reduction; Feature Selection; Magnetic resonance imaging; Neurodegenerative diseases; Neurons; Autoimmune disorder; Deep learning; Features selection; Hybrid artificial intelligences; Magnetic resonance imaging; Metaheuristic; Multi-views; Multiple sclerose; Multiple sclerosis; Quantum RIME; Particle swarm optimization (PSO)},
