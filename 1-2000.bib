@ARTICLE{Vann Yaroson202535,
	author = {Vann Yaroson, Emilia and Abadie, Amélie and Roux, Mélanie},
	title = {Human-artificial intelligence collaboration in supply chain outcomes: the mediating role of responsible artificial intelligence},
	year = {2025},
	journal = {Annals of Operations Research},
