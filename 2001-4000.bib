@ARTICLE{Golovachyova202535,
	author = {Golovachyova, Viktoriya N. and Bashirov, Alexander V. and Khanov, Talgat A. and Glazunova, Svetlana B.},
	title = {The innovative model for enhancing the research work of university students in the Republic of Kazakhstan within the context of technological sovereignty priorities; [Инновационная модель совершенствования научно-исследовательской работы студентов вузов Республики Казахстан в контексте приоритетов технологического суверенитета]},
	year = {2025},
	journal = {Obrazovanie i Nauka},
	volume = {27},
	number = {8},
	pages = {35 - 61},
	doi = {10.17853/1994-5639-2025-8-35-61},
	url = {https://www.scopus.com/pages/publications/105018381127?origin=resultslist},
	affiliations = {Department of Information and Computing Systems, Abylkas Saginov Karaganda Technical University, Karaganda, Kazakhstan; The Laboratory of Innovative and Scientific-Educational Technologies, Karaganda University of Kazpotrebsoyuz, Karaganda, Kazakhstan; The Research Institute of Economic and Legal Studies, Karaganda University of Kazpotrebsoyuz, Karaganda, Kazakhstan; The Department of Strategic Development, Karaganda University of Kazpotrebsoyuz, Karaganda, Kazakhstan},
	abstract = {Introduction. The relevance of this study is underscored by the necessity to address the challenges of technological development in the Republic of Kazakhstan, as outlined in the Law of the Republic of Kazakhstan dated 1 July 2024, No. 103-VIII ЗРК, “On Science and Technological Policy”. Aim. The present research aimed to develop an innovative model to enhance the research activities of students at higher education institutions in the Republic of Kazakhstan, based on the analysis and synthesis of both international and Kazakhstani experiences in organising scientific research within the context of achieving technological sovereignty. Methodology and research methods. The study employed theoretical methods, including the analysis of regulatory documents and literature related to the research problem, the generalisation of ideas concerning factors that activate research work, and the comparison of models for organising scientific research activities among students. Empirical methods used comprised observation, questionnaires, and the Delphi method. The respondents included 2, 370 students enrolled in various educational programmes, 1, 458 teachers, and 351 experts from nine leading universities in the Republic of Kazakhstan. Data processing and analysis were conducted using the SPSS software package. The official average statistical assessment of data in the Republic of Kazakhstan further reinforced the reliability of the results obtained in this comprehensive study. Results and scientific novelty. The article examines the pedagogical potential of comprehensive support for university students’ research activities within the context of the digital transformation of education. It establishes that the effectiveness of student research is largely determined by a combination of institutional mechanisms, digital tools, the level of methodological training, and the role of the teacher-mentor. The integration of research into the university’s strategic and educational frameworks is justified. An innovative model designed to enhance students’ motivation, research autonomy, and engagement has been developed and tested. The relationship between the development of digital and organisational infrastructure for student research activities and the formation of a sustainable research identity among students has been confirmed. Practical significance. The innovative model can serve as a tool for strategic and operational management in universities across various disciplines. © Golovachyova V.N., Bashirov A.V., Khanov T.A., Glazunova S.B.},
	author_keywords = {activation factors; digitalisation; innovative models; institutional environment of the university; specialisations; students’ research work; survey of respondents; teachers},
	correspondence_address = {V.N. Golovachyova; Department of Information and Computing Systems, Abylkas Saginov Karaganda Technical University, Karaganda, Kazakhstan; email: golovacheva_vn@mail.ru},
	publisher = {Russian State Vocational Pedagogical University},
	issn = {19945639},
	language = {English},
	abbrev_source_title = {Obraz. Nauka},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@BOOK{Dassel2025231,
	author = {Dassel, Katharina and Lutze, Maxie},
	title = {Digital Care-Pathways and Inter-Organizational Systems: A Perspective on Digital Sovereignty Along Shared Responsibilities},
	year = {2025},
	journal = {New Digital Work II: Digital Sovereignty of Companies and Organizations},
	pages = {231 - 246},
	doi = {10.1007/978-3-031-69994-8_14},
	url = {https://www.scopus.com/pages/publications/105024301583?origin=resultslist},
	affiliations = {Institute for Innovation and Technology (Iit), Steinplatz 1, Berlin, 10623, Germany},
	abstract = {The concept of digital sovereignty has gained attention on levels spanning from individual information sovereignty to digital sovereignty of organizations or the state level, concerning, for example, digital infrastructures. Taking into account the reality of digital work however, information and information systems are practically managed and worked with across organizations and thus, interdependencies challenge a classical notion of a sovereign authority that builds on supreme authority over a certain domain. We argue that for the conceptual understanding to allow for the realities of practical interdependencies, a perspective of sovereignty is needed that considers the shared responsibilities that emerge in these inter-organizational systems settings. We apply this idea to the context of digital care pathways for a practical exploration of the phenomenon in healthcare and suggest a conceptual understanding of inter-organizational, shared digital sovereignty which is informed by shared responsibility. We discuss open questions for further research. © 2025 VDI/VDE Innovation + Technik GmbH.},
	author_keywords = {Digital care pathways; Inter-organizational systems; Shared digital sovereignty},
	keywords = {Information use; Conceptual understanding; Digital care pathway; Digital infrastructures; Inter-organizational; Inter-organizational systems; Shared digital sovereignty; Shared responsibility; Information systems},
	correspondence_address = {K. Dassel; Institute for Innovation and Technology (Iit), Berlin, Steinplatz 1, 10623, Germany; email: dassel@iit-berlin.de},
	publisher = {Springer Science+Business Media},
	isbn = {978-303169994-8; 978-303169993-1},
	language = {English},
	abbrev_source_title = {New Digital Work II: Digital Sovereignty of Co. and Organizations},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access}
}

@CONFERENCE{Sambo-Magaji2025,
	author = {Sambo-Magaji, Amina and Adewale, Muyideen D.},
	title = {A Nigerian Artificial Intelligence Adoption Framework for Education Using the Barrett Model: A Values-Driven, Data Protection-Embedded, Language-Inclusive Blueprint for Teaching and Learning},
	year = {2025},
	journal = {2025 IEEE International Conference on Emerging Trends in Engineering and Computing, ETECOM 2025},
	pages = {},
	doi = {10.1109/ETECOM66111.2025.11319102},
	url = {https://www.scopus.com/pages/publications/105033349957?origin=resultslist},
	affiliations = {National Information Technology Development Agency, E-Government and Digital Economy Department, Abuja, Nigeria; National Open University of Nigeria, Africa Centre of Excellence on Technology Enhanced Learning, Nigeria},
	abstract = {Artificial intelligence (AI) offers significant opportunities to enhance teaching and learning in Nigeria, yet existing scholarship and policy lack a unified, values-driven adoption framework. Key gaps include the absence of a coherent policy spine, limited operationalisation of the Nigeria Data Protection Act (NDPA) and Regulation (NDPR), weak standards for language equity and accessibility, and the absence of pilot-ready guidance. This paper proposes a comprehensive adoption framework structured by the Barrett Model's seven levels of organisational consciousness. Using a design-synthesis approach, the study integrates Nigeria-focused policy analyses, higher-education governance models, multilingual pilot strategies, and Africa-wide lessons on responsible AI. The framework introduces: cross-cutting principles for data protection and teacher safeguards; a seven-level Barrett-aligned structure with decision gates and measurable KPIs; an operating model for governance, Education Management Information System (EMIS)/National Education Management Information System (NEMIS) interoperability, and vendor oversight; a pilot blueprint and compliance pack; a programme for language equity and accessibility; a monitoring and assurance plan; a phased implementation roadmap; and a risk register. To our knowledge, this is the first system-wide AI in education framework explicitly adapted to Nigeria through the Barrett Model. It provides a values-based, operational, and legally compliant pathway for ethical AI adoption, with broader relevance for low- and middle-income countries.  © 2025 IEEE.},
	author_keywords = {accessibility; Artificial intelligence in education; Barrett Model; data protection; governance; inclusion; NDPA/NDPR; Nigeria; pilots; policy framework},
	keywords = {Artificial intelligence; Blueprints; Ethical aspects; Information management; Information systems; Information use; Interoperability; Management information systems; Personnel training; Public policy; Security of data; Teaching; Accessibility; Artificial intelligence in education; Barrett model; Data Protection Act; Governance; Nigeria; Nigerium data protection act/(NDPA) and regulation; Pilot; Policy framework; Inclusions},
	correspondence_address = {A. Sambo-Magaji; National Information Technology Development Agency, E-Government and Digital Economy Department, Abuja, Nigeria; email: asambo@nitda.gov.ng},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156616-6},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Emerg. Trends Eng. Comput., ETECOM},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Jawad2025243,
	author = {Jawad, A.Y. and Shehab, R.M. and Zhumabaeva, A. and Al-Sarraf, N.M. and Alwan, G.M.},
	title = {AI ETHICS AND LEGAL REGULATION IN TEXTILE MANUFACTURING},
	year = {2025},
	journal = {Izvestiya Vysshikh Uchebnykh Zavedenii, Seriya Teknologiya Tekstil'noi Promyshlennosti},
	volume = {2025},
	number = {2},
	pages = {243 - 252},
	doi = {10.47367/0021-3497_2025_2_243},
	url = {https://www.scopus.com/pages/publications/105009850043?origin=resultslist},
	affiliations = {Al-Turath University, Baghdad, Iraq; Al-Mansour University College, Baghdad, Iraq; Osh State University, Osh, Kyrgyzstan; Al-Rafidain University College, Baghdad, Iraq; Madenat Alelem University College, Baghdad, Iraq},
	abstract = {Artificial Intelligence (AI) has been used in many forms in textile manufacturing for the advantages such as improved operational efficiency, quality, and sustain-ability. But this innovation raises the urgent challenges of data governance, legal compliance and ethical transparency. While there are elements of transparencies on performance, it is only partially born out of legal accountability, self-regulation or any sort of ethical consideration and as such is challenged whenever weighty ethical questions arise. In this work, an integrated data pipeline was built upon multi-source industrial information, advanced preprocessing techniques, feature engineering and principal component analysis dimension reduction. Various supervised learning algorithms, including random forests, gradient boosting and neural networks, were trained and optimized further by using systematic hyperparameter tuning and were validated by cross-validation schemes. The trained production model with the highest correctness was then implemented in a live environment resulting in substantial decreases of defects, throughput, energy and labor. At the same time, legal protections such as data anonymization, audit logging, and adherence to international standards of AI governance were engineered into the system design. The results demonstrate that AI tools can be deployed in a safe manner as an integral part of the manufacturing process, as long as coherent methodologies and regulatory principles are put in place. These principles constitute a repeatable framework for the ethical application of AI in industry and can help guide the creation of account-able AI systems in industries. © 2025, Ivanovo State Polytechnic University. All rights reserved.},
	author_keywords = {artificial intelligence (AI); data governance; ethical AI; legal compliance; machine learning (ML); operational efficiency; predictive modeling; textile manufacturing},
	publisher = {Ivanovo State Polytechnic University},
	issn = {00213497},
	language = {English},
	abbrev_source_title = {Izv. Vyssh. Uchebn. Zaved. Ser. Teknol. Tekst. Prom.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Bogucki2025101,
	author = {Bogucki, Artur},
	title = {Applied Trustworthy Data and Artificial Intelligence Governance in Precision Agriculture},
	year = {2025},
	journal = {Philosophy of Engineering and Technology},
	volume = {48},
	pages = {101 - 124},
	doi = {10.1007/978-3-031-83549-0_7},
	url = {https://www.scopus.com/pages/publications/105007561157?origin=resultslist},
	affiliations = {Centre for European Policy Studies (CEPS) | Warsaw School of Economics, Warsaw, Poland},
	abstract = {This chapter critically examines the ethical, legal, and socio-economic (ELSE) challenges and opportunities associated with data and AI in precision agriculture. By conducting an extensive literature review spanning publications from 2016 to 2023, the study systematically analyzes key arguments and trends, focusing on data governance issues. The review includes a meticulous analysis of over 505 distinct sources, revealing a significant shift in thematic focus towards challenges such as data ownership, security, privacy, and labor market disruptions. The findings underscore the predominance of ethical challenges, highlighting critical issues like discrimination, bias, privacy breaches, and the need for robust legal frameworks. Building on the literature review, the chapter addresses the complexities of agri-data governance, providing strategic recommendations for improving data management in the sector. The analysis emphasizes the importance of establishing a centralized European Ag-Data System to consolidate diverse datasets, enforce interoperability standards, and ensure transparent data governance. This approach aims to balance market dynamics, enhance data accessibility, and foster trust among farmers and stakeholders while ensuring adherence to the EU values in practice. Further, the chapter evaluates the European Commission’s Ethics Guidelines for Trustworthy AI using the ALTAI framework through three case studies in Spain, Finland, and Serbia/Lithuania. The assessment highlights improvements in transparency, privacy, and data governance, yet identifies ongoing challenges in technical robustness and accountability. The chapter advocates for continuous ethical evaluations and the use of tools like model cards and datasheets to enhance transparency and accountability. The findings underscore the necessity for robust data governance frameworks and ethical evaluations to ensure the responsible deployment of AI in agriculture, balancing innovation with the protection of stakeholders’ rights and interests. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {AI ethics; Artificial intelligence governance; Data governance; Digital law; Technology law},
	correspondence_address = {A. Bogucki; Centre for European Policy Studies (CEPS) | Warsaw School of Economics, Warsaw, Poland; email: artur.bogucki@ceps.eu},
	publisher = {Springer Nature},
	issn = {18797202},
	language = {English},
	abbrev_source_title = {Philos. Eng. Technol.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Wankhade2025,
	author = {Wankhade, Sandeep and Sahni, Manoj and León-Castro, Ernesto and Olazabal-Lugo, Maricruz},
	title = {Navigating AI ethics: ANN and ANFIS for transparent and accountable project evaluation amidst contesting AI practices and technologies},
	year = {2025},
	journal = {Frontiers in Artificial Intelligence},
	volume = {8},
	pages = {},
	doi = {10.3389/frai.2025.1535845},
	url = {https://www.scopus.com/pages/publications/105005262545?origin=resultslist},
	affiliations = {Department of Mathematics, Pandit Deendayal Energy University, Gandhinagar, India; Faculty of Economics and Administrative Sciences, Universidad Católica de la Santísima Concepción, Concepción, Chile; Unidad Regional Culiacán, Universidad Autónoma de Occidente, Culiacán, Mexico},
	abstract = {Introduction: The rapid evolution of Artificial Intelligence (AI) necessitates robust ethical frameworks to ensure responsible project deployment. This study addresses the challenge of quantifying ethical criteria in AI projects amidst contesting communicative practices, organizational structures, and enabling technologies, which shape AI’s societal implications. Methods: We propose a novel framework integrating Artificial Neural Networks (ANN) and Adaptive Neuro-Fuzzy Inference Systems (ANFIS) to evaluate AI project performance and model ethical uncertainties using Fuzzy logic. A Fuzzy weighted average approach quantifies critical ethical dimensions: transparency, fairness, accountability, privacy, security, explainability, human involvement, and societal impact. Results: The framework enables a structured assessment of AI projects, enhancing transparency and accountability by mapping ethical criteria to project outcomes. ANN evaluates performance metrics, while ANFIS models uncertainties, providing a comprehensive ethical evaluation under complex conditions. Discussion: By combining ANN and ANFIS, this study advances the understanding of AI’s ethical dimensions, offering a scalable approach for accountable AI systems. It reframes organizational communication and decision-making, embedding ethics within AI’s technological and structural contexts. This work contributes to responsible AI innovation, fostering trust and societal alignment in AI deployments. Copyright © 2025 Wankhade, Sahni, León-Castro and Olazabal-Lugo.},
	author_keywords = {accountability; adaptive neuro-fuzzy inference systems (ANFIS); artificial intelligence (AI); artificial neural networks (ANN); organizational structures},
	correspondence_address = {M. Sahni; Department of Mathematics, Pandit Deendayal Energy University, Gandhinagar, India; email: manoj.sahni@sot.pdpu.ac.in},
	publisher = {Frontiers Media SA},
	issn = {26248212},
	language = {English},
	abbrev_source_title = {Frontier. Artif. Intell.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@BOOK{Nieuwenhuizen2025116,
	author = {Nieuwenhuizen, Esther},
