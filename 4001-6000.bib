@CONFERENCE{Kadripathi2025,
	author = {Kadripathi, K.N. and Perrusquia, Adolfo and Ignatyev, Dmitry},
	title = {Integrating Explainable AI into Two-Tier ML Models for Trustworthy Aircraft Landing Gear Fault Diagnosis},
