	affiliations = {University of Warwick, Department of Computer Science, United Kingdom},
	abstract = {Semi-supervised learning (SSL) has emerged as a promising paradigm for leveraging large-scale unlabeled data, yet remains vulnerable to bias amplification through overconfident and miscalibrated pseudo-labels=especially in the presence of distributional shifts or class imbalance. Motivated by the urgent need for trustworthy AI systems, we introduce TrustMatch, a novel SSL framework that integrates bias-aware pseudo-label refinement with interpretable trust evaluation. Drawing inspiration from recent advances in explanation-guided reliability estimation, our method explicitly quantifies the bias tendency of each pseudo-label via a composite score that captures confidence reliability, marginal class bias, and semantic explanation disparity. This score governs a Bias-Aware Correction (BAC) strategy, which adaptively suppresses misleading supervision signals. Empirical evaluations across both normal and long-tailed benchmarks (CIFAR-10, ImageNet, CIFAR-10-LT, ImageNet-LT) demonstrate that TrustMatch achieves superior generalization while improving pseudo-label fairness and semantic alignment. Our work contributes foundational insights and practical tools toward interpretable, robust, and unbiased SSL-paving the way for reliable deployment of AI models in high-stakes real-world scenarios. © 2025 IEEE.},
