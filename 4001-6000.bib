	affiliations = {University Centre for Research and Development, Chandigarh University, Punjab, Mohali, 140413, India},
	abstract = {The growing integration of Artificial Intelligence (AI) in agriculture offers significant benefits, but also introduces ethical risks that are often overlooked. This study proposes a simulation-based Ethical Risk Index (ERI) to systematically quantify moral hazards in AI-driven agricultural decision systems. Using the Crop Recommendation Dataset from Kaggle, we simulate real-world deployment of Decision Tree, Random Forest and XG Boost models, for recommending suitable crops based on soil properties and environmental conditions. We evaluate the model's ethical performance across three key dimensions: fairness, transparency and accountability. Simulations are conducted by introducing data biases and testing model explainability using SHAP (SHapely Additive exPlanations). Results demonstrate that AI systems can exhibit varying levels of ethical risk depending on data representation and interpretability. The ERI framework provides a quantifiable and interpretable score that highlights ethical vulnerabilities in agricultural AI systems. This approach can guide responsible AI development and deployment in critical domains like agriculture. © 2025 IEEE.},
