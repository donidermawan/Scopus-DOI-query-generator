	affiliations = {Center for Bioinformatics, Saarland University, Saarbrücken, 66123, Germany; University of Plymouth, Plymouth, United Kingdom; Graduate School of Informatics, Nagoya University, Tokyo, Japan; Department of Biomedical Informatics, Emory University, Atlanta, GA, United States; Center for Ethics, Emory University, Atlanta, GA, United States},
