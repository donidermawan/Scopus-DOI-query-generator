	affiliations = {FAPEMIG–CNPq Fellow, Postgraduate Program in Management and Regional Development, Centro Universitário do Sul de Minas, Varginha, Brazil; Federal University of São João Del Rei – UFSJ, São João Del Rei, Brazil; Federal Center for Technological Education of Minas Gerais – CEFET-MG, Varginha, Brazil},
	abstract = {Artificial Intelligence (AI) has emerged as a transformative research domain, impacting various industries worldwide. Despite Brazil’s growing contributions to AI, comprehensive studies mapping its research landscape remain scarce. This study conducted a scientometric analysis of AI research in Brazil from 2021 to 2025, examining citation impact, thematic trends, institutional participation, funding distribution, and international collaborations. By analysing a dataset retrieved from the Web of Science Core Collection, we identify key research areas, assess funding agencies’ influence, and highlight Brazil’s position in the global AI research ecosystem. The findings reveal a significant growth in AI research output, with notable contributions in engineering, healthcare, and agribusiness, but also highlight challenges in funding disparities and underrepresented areas such as AI governance and education. This study provides critical insights to support strategic decision-making in AI policy and investment. © Springer Nature Singapore Pte Ltd. 2025.},
