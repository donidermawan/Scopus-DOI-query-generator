	title = {Trustworthy AI under Imperfect Web Data},
	year = {2025},
	journal = {WWW Companion 2025 - Companion Proceedings of the ACM Web Conference 2025},
	pages = {65 - 68},
	doi = {10.1145/3701716.3715859},
