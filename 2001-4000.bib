@CONFERENCE{Attanayake2025567,
	author = {Attanayake, Tharindu and Goonaratne, Gayathri},
	title = {Balancing Innovation and Integrity: Comparative Policy Frameworks for AI Governance in Australian Higher Education},
	year = {2025},
	journal = {8th International Conference on Educational Technology Management, ICETM 2025},
	pages = {567 - 570},
	doi = {10.1109/ICETM67477.2025.11413552},
	url = {https://www.scopus.com/pages/publications/105035376748?origin=resultslist},
	affiliations = {School of Business, Crown Institute of Higher Education, Sydney, Australia; School of Business, The Institute of International Studies, Sydney, Australia},
	abstract = {Artificial intelligence (AI) technologies are transforming higher education through personalised learning and automated assessment while challenging academic integrity and governance. This study examines AI policies across six Australian institutions three public universities and three private providers through a comparative analysis of policy documents, focusing on scope, principles, governance, and enforcement. Findings reveal that public institutions employ comprehensive governance structures and mandatory AI literacy training, whereas private providers emphasize breach definitions with decentralized oversight. A critical gap in regulating staff AI use was identified across both sectors. We propose a hybrid governance model combining public-sector rigor with private-sector agility, featuring tiered penalties, mandatory AI literacy programs, and an AI usage registry. The framework aligns with international standards (UNESCO, EU AI Act) and offers actionable pathways for national policy harmonisation. This work equips education leaders with strategies for ethical AI integration while preserving academic rigor. © 2025 IEEE.},
	author_keywords = {academic integrity; AI governance; educational leadership; ethical AI; higher education policy},
