@ARTICLE{Fischman-Afori2025,
	author = {Fischman-Afori, Orit},
	title = {Due process by design: Enhancing fairness and trust in AI decision-making},
	year = {2025},
	journal = {Social Sciences and Humanities Open},
	volume = {12},
	pages = {},
	doi = {10.1016/j.ssaho.2025.102178},
	url = {https://www.scopus.com/pages/publications/105024093238?origin=resultslist},
	affiliations = {Faculty of Law, College of Management, Israel},
	abstract = {This article explores the intersection of socio-normative procedural justice theory and the growing use of AI in decision-making. While AI systems offer substantial advantages, they also raise significant concerns related to discrimination, fairness, and public trust, fueling global demands for “trustworthy,” “responsible,” and “accountable” AI. However, translating these broad ideals into concrete frameworks remains a major challenge. The article argues that procedural justice theory, which emphasizes the fairness of decision-making processes as a foundation for building trust in various social institutions, offers a compelling basis for addressing these concerns. While foundational procedural principles such as transparency have been extensively addressed in the AI context, a key component of procedural justice—the right to be heard, as part of a due process—is largely overlooked. Hearings allow individuals to actively participate in the decision-making process, enhancing personalization, accuracy, perceptions of fairness, and ultimately, trust. Building on value-sensitive design and human-centered technology approaches, the article introduces the concept of “due process by design.” It advocates embedding procedural elements, notably automated hearings, into the architecture of AI decision-making systems. Drawing on insights from socio-legal legacies and public policy, it proposes adaptive, real-time input mechanisms that emulate hearings as understood in traditional due process frameworks. These mechanisms can improve the accuracy and individualization of decisions while enhancing users’ perceptions of fairness and trust in AI decision-making processes. This interdisciplinary approach, linking socio-normative theory, public policy, and technology design, aims to strengthen fairness and public trust in civil society decision-making systems. © 2025 The Author.},
	author_keywords = {AI decision-making; Due process by design; Fairness in decision-making; Human-centered AI; Human–computer interaction; Procedural justice; Trustworthy AI},
	correspondence_address = {O. Fischman-Afori; Faculty of Law, College of Management, Israel; email: forit@colman.ac.il},
	publisher = {Elsevier Ltd},
	issn = {25902911},
	language = {English},
	abbrev_source_title = {Soc. Sci. Humanit. Open},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access}
}

@CONFERENCE{Da Silva2025,
	author = {Da Silva, Rodrigo Santa Comba Coelho and Bittencourt, Joao Carlos N. and Costa, Daniel G.},
	title = {Edge-AI Framework for Fire Detection in Wildland-Urban Interface using TinyML},
	year = {2025},
	journal = {IEEE International Conference on Emerging Technologies and Factory Automation, ETFA},
	pages = {},
	doi = {10.1109/ETFA65518.2025.11205590},
	url = {https://www.scopus.com/pages/publications/105021831087?origin=resultslist},
	affiliations = {University of Porto, Meec, Faculty of Engineering, Portugal; Federal University of Recôncavo da Bahia, Cetec, Brazil; University of Porto, Pdeec, Faculty of Engineering, Portugal; University of Porto, SYSTEC-ARISE, Faculty of Engineering, Portugal},
	abstract = {Wildfires in the Wildland-Urban Interface (WUI) pose a significant threat to public safety and property, indicating the need for advanced early detection systems that are not only cost-effective and low-maintenance but also capable of operating in remote locations. This study addresses this need by developing an embedded wildfire detection system optimized for the WUI, using Convolutional Neural Network (CNN) models deployed on resource-constrained hardware. The approach involves building a balanced image dataset encompassing diverse wildfire scenarios, training and evaluating multiple CNN models on this dataset, in order to select the most effective model that adheres to the memory constraints of an Arduino Nano 33 BLE Sense platform. The models were tested and compared using metrics such as global accuracy, true positive accuracy, the area under the ROC curve (AUC-ROC), and inference time. The MobileNetV2 model was selected, achieving a global accuracy of 91.4% and an AUC-ROC of 0.93 while maintaining an inference time of 992 ms. Additionally, a custom enclosure was designed to protect the hardware from environmental factors, thereby ensuring its functionality and durability in real-world deployment scenarios. © 2025 IEEE.},
	author_keywords = {CNN; Edge computing; Image classification; Machine learning; TinyML; Wildfire detection},
	keywords = {Artificial intelligence; Computer hardware; Cost effectiveness; Edge computing; Edge detection; Fire detectors; Fires; Learning systems; Remote sensing; Convolutional neural network; Edge computing; Fire detection; Images classification; Machine-learning; Neural network model; Public safety; Tinyml; Wildfire detection; Wildland urban interface; Image classification},
