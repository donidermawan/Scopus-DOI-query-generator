@BOOK{Wong2025179,
	author = {Wong, Janis and Morgan, Deborah and Straub, Vincent J. and Hashem, Youmna and Bright, Jonathan},
	title = {Key challenges for the participatory governance of AI in public administration},
	year = {2025},
	journal = {Handbook on Governance and Data Science},
	pages = {179 - 197},
	doi = {10.4337/9781035301348.00017},
	url = {https://www.scopus.com/pages/publications/105003324877?origin=resultslist},
	affiliations = {Law Society of England and Wales, United Kingdom; AI for Public Services Team, Alan Turing Institute, United Kingdom; Leverhulme Centre for Demographic Science, University of Oxford, United Kingdom; Turing Institute, United Kingdom},
	abstract = {As artificial intelligence (AI) becomes increasingly embedded in government operations, retaining democratic control over these technologies is becoming ever more crucial for mitigating potential biases or lack of transparency. However, while much has been written about the need to involve citizens in AI deployment in public administration, little is known about how democratic control of these technologies works in practice. This chapter addresses this gap through participatory governance, a subset of governance theory that emphasizes democratic engagement, in particular through deliberative practices. We begin by introducing the opportunities and challenges that AI use in government poses. Next, we outline the dimensions and developments within the theory of participatory governance and introduce an exploratory framework which can be adopted in the AI implementation process. Finally, we explore how these considerations can be applied to AI governance in public bureaucracies. We conclude by outlining future directions in the study of AI systems governance in public administration. © The Editor and Contributing Authors Severally 2025. All rights reserved.},
	author_keywords = {AI governance; Artificial intelligence; Deliberative democracy; Participatory governance; Public administration; Technology in government},
	publisher = {Edward Elgar Publishing Ltd.},
	isbn = {978-103530134-8; 978-103530133-1},
	language = {English},
	abbrev_source_title = {Handb. on Gov. and Data Sci.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Han2025,
	author = {Han, Chengzhuo and Yang, Tingting and Sun, Xin and Cui, Zhengqi},
	title = {Secure Hierarchical Federated Learning for Large-Scale AI Models: Poisoning Attack Defense and Privacy Preservation in AIoT},
	year = {2025},
	journal = {Electronics (Switzerland)},
	volume = {14},
	number = {8},
	pages = {},
	doi = {10.3390/electronics14081611},
	url = {https://www.scopus.com/pages/publications/105003663134?origin=resultslist},
	affiliations = {School of Cyber Science and Engineering, Southeast University, Jiulonghu Campus, Nanjing, 211189, China; Peng Cheng Laboratory, Shenzhen, Baoan, 518053, China; Navigation College, Dalian Maritime University, Dalian, Ganjingzi, 116026, China},
	abstract = {The rapid integration of large-scale AI models into distributed systems, such as the Artificial Intelligence of Things (AIoT), has introduced critical security and privacy challenges. While configurable models enhance resource efficiency, their deployment in heterogeneous edge environments remains vulnerable to poisoning attacks, data leakage, and adversarial interference, threatening the integrity of collaborative learning and responsible AI deployment. To address these issues, this paper proposes a Hierarchical Federated Cross-domain Retrieval (FHCR) framework tailored for secure and privacy-preserving AIoT systems. By decoupling models into a shared retrieval layer (globally optimized via federated learning) and device-specific layers (locally personalized), FHCR minimizes communication overhead while enabling dynamic module selection. Crucially, we integrate a retrieval-layer mean inspection (RLMI) mechanism to detect and filter malicious gradient updates, effectively mitigating poisoning attacks and reducing attack success rates by 20% compared to conventional methods. Extensive evaluation on General-QA and IoT-Native datasets demonstrates the robustness of FHCR against adversarial threats, with FHCR maintaining global accuracy not lower than baseline levels while reducing communication costs by 14%. © 2025 by the authors.},
	author_keywords = {edge computing; federated learning security; large-scale AI models; poisoning attack defense; security and frivacy},
	keywords = {Adversarial machine learning; Cloud computing; Edge detection; Grid computing; Sensitive data; Distributed systems; Edge computing; Federated learning security; Large-scale AI model; Large-scales; Poisoning attack defense; Poisoning attacks; Privacy preservation; Security and frivacy; Security and privacy; Federated learning},
	correspondence_address = {C. Han; School of Cyber Science and Engineering, Southeast University, Nanjing, Jiulonghu Campus, 211189, China; email: 230208965@seu.edu.cn},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20799292},
	language = {English},
	abbrev_source_title = {Electronics (Switzerland)},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8; All Open Access; Gold Open Access}
}

