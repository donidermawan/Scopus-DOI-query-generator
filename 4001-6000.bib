@CONFERENCE{Moharir2025486,
	author = {Moharir, Akshata Kishore and Prakash Thakur, Jay and Deshpande, Aditya and Phadnis, Apoorva},
	title = {A Comparative Survey of Trust-Building Methods in Multi-Agent AI Systems},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 7th International Conference on Cognitive Machine Intelligence, CogMI 2025},
	pages = {486 - 491},
	doi = {10.1109/CogMI67134.2025.00063},
	url = {https://www.scopus.com/pages/publications/105036092017?origin=resultslist},
	affiliations = {OR, United States; CA, United States; Washington, DC, United States},
	abstract = {Multi-agent systems have grown into a fundamental means of addressing problems in a distributed manner in fields that are as diverse as blockchain networks and self-driving robots. Yet, using these types of system in situations with significant stakes is often challenging as it is hard to build and keep trust between the autonomous agents which function without central oversight. This survey looks at computational trust mechanisms for multi-agent environments in a systematic manner, focusing on the following four primary categories: (1) explainable methods that attempt to make things clearer, (2) consensus-based approaches which establish trust through agreement protocols, (3) reputation-based frameworks which utilize past agent behavior, and (4) verification-based techniques that use formal methods. The survey shows a comparison method to demonstrate the most important trade-offs between security, scalability, and computational efficiency. The survey suggests an approach to group trust mechanisms into categories, looks at the fundamental structure and trade-offs, and points out areas where more research is needed, as well as where there are challenges. This survey paper demonstrates that no single mechanism is most effective for all criteria, which indicates that hybrid approaches might serve as a good way to make multi-agent systems that are strong and reliable. By advancing trust in autonomous interactions, these mechanisms are essential for the development of responsible AI in decentralized environments. © 2025 IEEE.},
