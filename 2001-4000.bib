	affiliations = {Center for Technology & Society, FGV Rio Law School, Rio de Janeiro, Brazil; Electronic Governance Unit (UNU-EGOV), United Nations University, Guimarães, Portugal},
	abstract = {This concluding chapter draws conclusions from the analyses of this volume, with regard to the different policies, regulations, and initiatives adopted by Brazil, Russia, India, China, and South Africa (BRICS) to promote their digital transformation. The chapter emphasises the heterogeneity of policy and political structures that characterise the bloc’s “competitive multilateralism,” while also stressing the different strategic approaches of the countries to the governance and regulation of technology. Importantly, such approaches denote an increasing attention of the bloc members to the development of digital public goods, digital public infrastructures as an essential element of their digital sovereignty, as their capacity to understand, develop, and regulate digital technologies. To conclude this volume, this final chapter highlights what are the main elements adopted by the BRICS to shape their digital transformations. We contend that BRICS approaches denote their success or failure to connect key dimensions of digital transformation, such as governance, regulation, organization of financial resources, capacity to develop emerging technologies and provide digital public infrastructures, in order to leverage them to build their digital sovereignty and long-term sustainability. © The Editor(s) (if applicable) and The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	keywords = {Digital transformation; Essential elements; Multilateralism; Policy initiatives; Policy regulations; Political structure; Public goods; Public infrastructures; South Africa; Strategic approaches; Sustainable development},
	correspondence_address = {L. Belli; Center for Technology & Society, FGV Rio Law School, Rio de Janeiro, Brazil; email: luca.belli@fgv.br},
