@CONFERENCE{Hasan2025710,
	author = {Hasan, Md Mehedi and Rahman, Md Mujibur and Mamun, Quazi and Wu, Jun and Rana, Mohammad},
	title = {Addressing Algorithmic Bias in Diabetes Care: A Multi-Modal Machine Learning Framework for Equitable Readmission Prediction},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {710 - 719},
	doi = {10.1109/ICDMW69685.2025.00086},
	url = {https://www.scopus.com/pages/publications/105035380181?origin=resultslist},
	affiliations = {School of Comp, Maths and Engg, Charles Sturt University, 2640, NSW, Australia; School of Information, Production and Systems, Waseda University, Tokyo, Japan; School of Comp, Maths & Engg, Charles Sturt University, 2678, NSW, Australia},
	abstract = {Diabetes readmissions affect 14.4-22.7% of patients, disproportionately impacting minority populations and costing $3.8 billion annually. Existing prediction models suffer from algorithmic bias and limited clinical interpretability. Develop a fairness-optimized multi-modal machine learning framework for equitable diabetes readmission prediction with actionable clinical insights. We designed a novel architecture integrating four specialized neural networks: clinical data processing through deep neural networks, medication interactions via graph neural networks, demographic factors through fairness-aware models, and temporal patterns using LSTM networks. Adversarial debiasing and multi-objective optimization ensured equitable performance across demographic groups. The framework was validated using 101,766 diabetes encounters from 130 US hospitals and pilottested in three healthcare systems. Results: The multi-modal framework achieved AUC-ROC of 0.923, representing 18.5% improvement over Random Forest baselines. Bias mitigation reduced demographic disparities by 85%, with all fairness metrics below 5% thresholds. SHAP analysis identified 15 key risk factors, 60% being clinically modifiable. Six-month pilot implementation demonstrated 23.7% readmission reduction and $2.3 million healthcare savings. This framework successfully integrates predictive accuracy, algorithmic fairness, and clinical interpretability, establishing a new paradigm for equitable healthcare AI that transforms diabetes care from reactive treatment to proactive prevention. © 2025 IEEE.},
	author_keywords = {algorithmic fairness; clinical decision support; diabetes readmission prediction; healthcare disparities; multi-modal machine learning},
	keywords = {Health care; Learning systems; Population statistics; Algorithmic fairness; Algorithmics; Clinical decision support; Diabetes care; Diabetes readmission prediction; Healthcare disparity; Learning frameworks; Machine-learning; Multi-modal; Multi-modal machine learning; Deep neural networks},
