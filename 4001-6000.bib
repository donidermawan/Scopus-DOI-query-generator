	year = {2025},
	journal = {2025 IEEE 3rd International Conference on Image Processing and Computer Applications, ICIPCA 2025},
	pages = {339 - 343},
	doi = {10.1109/ICIPCA65645.2025.11139006},
	url = {https://www.scopus.com/pages/publications/105017003260?origin=resultslist},
	affiliations = {School of Intelligent Technology and Engineering, Chongqing University of Science and Technology, Chongqing, China; Chongqing Carbon Energy Technology Co., Ltd., Sichuan Aizhong Comprehensive Energy Technology Service Co., Ltd., Chongqing, China; China Resources Microelectronics Limited, Purchasing Department, Chongqing, China},
	abstract = {With the rapid development of artificial intelligence and edge computing technologies, their integrated applications in safety monitoring have become a research hotspot. This study focuses on concrete crack detection. Three pretrained lightweight convolutional neural networks - ResNet18, MobileNetV3-Large, and GoogLeNet (Inception V1) - are fine-tuned via a transfer learning strategy and trained on the SDNET2018 concrete crack dataset. To address the resource constraints of deploying deep learning models on edge devices, the RKNN toolkit is employed for architectural optimization and deployment. Experimental results demonstrate that MobileNetV3-Large achieves the best overall performance after deployment. Its precision, recall, and F1-score reach 90.68%, 95.43%, and 92.99%, respectively. The model maintains high accuracy while occupying only 11.36 MiB of memory and achieving an inference speed of 6.527 ms. The practicality of MobileNetV3-Large for edge-based concrete crack detection is validated, and the advantages of the domestic RK3588 chip in low-power, high-performance AI deployment are highlighted. The proposed framework provides a reliable edge solution for safety monitoring of concrete structures such as bridges, dams, and buildings. © 2025 IEEE.},
	author_keywords = {Concrete crack detection; Domestic AI Chip; Edge computing; Model optimization; Transfer learning},
	keywords = {Anomaly detection; Bridges; Convolutional neural networks; Deep learning; Edge detection; High performance concrete; Large datasets; Learning systems; Mobile edge computing; Transfer learning; Anomaly-detection algorithms; Computing technology; Concrete crack detection; Concrete cracks; Domestic AI chip; Edge computing; Model optimization; Performance; Safety monitoring; Transfer learning; Crack detection},
	correspondence_address = {J. Wen; School of Intelligent Technology and Engineering, Chongqing University of Science and Technology, Chongqing, China; email: jiewen@cqust.edu.cn},
