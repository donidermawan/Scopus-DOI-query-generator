@CONFERENCE{Sechi20251371,
	author = {Sechi, Fabien and Noori, Nadia Saad},
	title = {Conceptual framework for testbed design: Specific to cybersecurity and operational safety anomalies in DER-rich Smart Grid},
	year = {2025},
	journal = {Conference Proceedings - IEEE International Conference on Systems, Man and Cybernetics},
	pages = {1371 - 1378},
