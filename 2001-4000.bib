@CONFERENCE{Tuape2025325,
	author = {Tuape, Micheal and Gabrielmichael, Yishak and Kasurinen, Jussi},
	title = {Architecting Trust: Designing Human Oversight and Accountability for AI-Driven Software Engineering under the EU AI Act},
	year = {2025},
	journal = {Proceedings - 2025 13th International Conference in Software Engineering Research and Innovation, CONISOFT 2025},
	pages = {325 - 331},
	doi = {10.1109/CONISOFT66928.2025.00048},
	url = {https://www.scopus.com/pages/publications/105034779891?origin=resultslist},
	affiliations = {Lappeenranta-Lahti University of Technology, Dept. of Software Engineering, Lappeenranta, Finland},
	abstract = {The dawn of AI-driven Software Engineering, particularly with the emergence of Agentic AI systems, promises transformative advancements in software development. However, this shift occurs amidst a growing global emphasis on responsible AI governance, exemplified by stringent regulations like the EU AI Act, which mandate robust human oversight, transparency, and accountability. A critical barrier to the trustworthy and compliant adoption of Agentic AI in SE is the inherent unpredictability and non-determinism of these systems. This creates significant loopholes and practical implementation gaps in current human oversight and accountability mechanisms, making it challenging to meet the stringent, yet often ambiguous, requirements set forth by the EU AI Act. Existing research often lacks concrete solutions for operationalizing human control over such autonomous and evolving AI. This paper presents a foundational step in a long-term research endeavor to bridge this critical gap. We make three key contributions: (1) We systematically identify and categorize the specific challenges and practical implementation gaps that arise in designing Human Oversight and Accountability for Agentic AI in SE under the EU AI Act. (2) We critically analyze the current state of research in Human-in-the-Loop and AI governance, pinpointing the open research areas and knowledge gaps hindering effective compliance. (3) We propose a comprehensive research road map outlining principled conceptual frameworks and actionable design guidelines for HITL architectures, aimed at developing trustworthy, compliant, and effectively controlled Agentic AI systems in SE that align with EU AI Act mandates.  © 2025 IEEE.},
	author_keywords = {AI in software engineering; Human in the loop; Human oversight; Software engineering; Trustworthy AI},
	keywords = {Artificial intelligence; Compliant mechanisms; Human engineering; Laws and legislation; 'current; AI in software engineering; AI systems; Human control; Human oversight; Human-in-the-loop; Non Determinism; Stringent regulations; Stringents; Trustworthy AI; Software design},
