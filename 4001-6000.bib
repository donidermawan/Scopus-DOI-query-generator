@ARTICLE{Salah202565839,
	author = {Salah, Suhaib and Elbatanouny, Hagar and Sobuh, Abrar and Almajali, Eqab and Khan, Wasiq and Alaskar, Haya and Binbusayyis, Adel and Hassan, Taimur and Yousaf, Jawad and Hussain, Abir},
	title = {Explainable AI for Unraveling the Significance of Visual Cues in High Stakes Deception Detection},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {65839 - 65862},
	doi = {10.1109/ACCESS.2025.3558875},
	url = {https://www.scopus.com/pages/publications/105003111329?origin=resultslist},
	affiliations = {Khalifa University, Department of Computer and Information Engineering, Abu Dhabi, United Arab Emirates; University of Sharjah, Electrical Engineering Department, Sharjah, United Arab Emirates; University of Ottawa, School of Electrical Engineering and Computer Science, Ottawa, K1N 6N5, ON, Canada; Liverpool John Moores University, School of Computer Science and Mathematics, Faculty of Engineering, Liverpool, L3 3AF, United Kingdom; Prince Sattam Bin Abdulaziz University, Department of Computer Sciences, Al-Kharj, 11942, Saudi Arabia; Abu Dhabi University, Department of Electrical, Computer, and Biomedical Engineering, Abu Dhabi, United Arab Emirates},
	abstract = {Deception, a widespread aspect of human behavior, has significant implications in fields like law enforcement, security, judicial proceedings, and social areas. Detecting deception accurately, especially in high-stakes environments, is critical for ensuring justice and security. Recently, machine learning has significantly enhanced deception detection capabilities by analyzing various behavioral and visual cues. However, machine learning models often operate as opaque "black boxes,"offering high predictive accuracy without explaining the reasoning behind the decisions. This lack of transparency necessitates the integration of Explainable Artificial Intelligence to make the models' decisions understandable and trustworthy. This study proposes the implementation of existing model-agnostic Explainable Artificial Intelligence techniques - Permutation Importance, Partial Dependence Plots, and SHapley Additive exPlanations - to showcase the contributions of visual features in deception detection. Using Real-Life Trial dataset, recognized as the most valuable high-stake dataset, we demonstrate that Multi-layer Perceptron achieved the highest accuracy of 88% and a recall of 92.86%. Along with the aforementioned existing techniques, Real-Life Trial dataset inspired us to develop a novel technique: 'set-of-features permutation importance'. Additionally, this study is novel in the sense of that it extensively applies XAI techniques in the field of deception detection on Real-Life Trial dataset. Experimental results shows that the visual cues related to eyebrow movements are most indicative of deceptive behavior. Along with the new findings, our work underscores the importance of making machine learning models more transparent and explainable, thereby enhancing their utility for human-in-loop AI and ethical acceptability.  © 2013 IEEE.},
	author_keywords = {black-box models; Deception detection; explainable machine learning; human-in-loop AI; model-agnostic techniques; multi-layer perceptron; partial dependence plots; permutation importance; shap; trustworthy AI},
	keywords = {Black-box testing; Contrastive Learning; Economic and social effects; Law enforcement; Machine learning; Black box modelling; Deception detection; Explainable machine learning; Human-in-loop AI; Machine-learning; Model-agnostic technique; Multilayers perceptrons; Partial dependence plot; Permutation importance; Shap; Trustworthy AI; Adversarial machine learning},
	correspondence_address = {S. Salah; Khalifa University, Department of Computer and Information Engineering, Abu Dhabi, United Arab Emirates; email: eng.suhaib.salah@gmail.com; E. Almajali; University of Sharjah, Electrical Engineering Department, Sharjah, United Arab Emirates; email: ealmajali@sharjah.ac.ae; A. Hussain; University of Sharjah, Electrical Engineering Department, Sharjah, United Arab Emirates; email: abir.hussain@sharjah.ac.ae},
