@BOOK{Donia2025173,
	author = {Donia, Joseph},
	title = {Algorithmic Accountability},
	year = {2025},
	journal = {Understanding Accountability: New Perspectives on a Fractured World},
	pages = {173 - 190},
	doi = {10.4324/9781003457961-10},
	url = {https://www.scopus.com/pages/publications/105018156856?origin=resultslist},
	affiliations = {University of Milan, Italy},
	abstract = {The relevance of algorithms in contemporary life is often appreciated when they fail—either because they did not perform as expected, or because they led to outcomes that were later determined to be unacceptable. As a result, academic, policy, and public discourse hass increasingly emphasized accountability as a desirable, if not elusive, feature of system design, and component of effective governance. Accountability, however, is a versatile concept that has been approached in a number of ways across different use contexts, policy settings, and research communities. While accountability is often framed as a normative good, it is unclear exactly what kind of normative work it is expected to do, and how it is expected to do it. Informed by perspectives from critical data studies and science and technology studies, this chapter reviews five normative logics underpinning discussions of algorithmic accountability that appear in the academic research literature: accountability as verification, accountability as participation, accountability as social license, accountability as fiduciary duty, and accountability as legal compliance. These normative logics are especially discussed in terms of the presumed agency of the actors they involve, where implicit assumptions characterizing each of ‘algorithms’ and ‘accountability’ are highly significant for each other. More explicit acknowledgment of this can lead to an improved understanding of the diverse knowledge claims and practical goals associated with different logics of algorithmic accountability, and relatedly, the agency of different actors to pursue it in its different forms. © 2026 selection and editorial matter, Matthew Flinders, Gergana Dimova and Chris Monaghan; individual chapters, the contributors.},
	keywords = {Public policy; Academic research; Algorithmics; Critical data; Legal compliance; Policy researches; Policy setting; Research communities; Science and technology studies; System components; Use context; Consensus algorithm},
	publisher = {Taylor and Francis},
	isbn = {978-104040176-7; 978-103258848-3},
