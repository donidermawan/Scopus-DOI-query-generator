	doi = {10.1007/s11098-023-02006-5},
	url = {https://www.scopus.com/pages/publications/85168905641?origin=resultslist},
	affiliations = {University of Toronto, St. George, Toronto, Canada; Harvard University, Cambridge, United States},
	abstract = {In this paper we develop a general theory of algorithmic fairness. Drawing on Johnson King and Babic’s work on moral encroachment, on Gary Becker’s work on labor market discrimination, and on Strawson’s idea of resentment and indignation as responses to violations of the demand for goodwill toward oneself and others, we locate attitudes to fairness in an agent’s utility function. In particular, we first argue that fairness is a matter of a decision-maker’s relative concern for the plight of people from different groups, rather than of the outcomes produced for different groups. We then show how an agent’s preferences, including in particular their attitudes to error, give rise to their decision thresholds. Tying these points together, we argue that the agent’s relative degrees of concern for different groups manifest in a difference in decision thresholds applied to these groups. © The Author(s), under exclusive licence to Springer Nature B.V. 2023.},
