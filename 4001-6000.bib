@ARTICLE{Bozbaş2025199,
	author = {Bozbaş, Gökhan},
	title = {Dual-Use Technologies in Türkiye’s Defense Sector: Pathways to Agricultural Modernization and Strategic Autonomy},
	year = {2025},
	journal = {Insight Turkey},
	volume = {27},
