	title = {Automated Discovery of Trade-Off Between Utility, Privacy and Fairness in Machine Learning Models},
	year = {2025},
	journal = {Communications in Computer and Information Science},
	volume = {2133 CCIS},
	pages = {127 - 144},
	doi = {10.1007/978-3-031-74630-7_9},
