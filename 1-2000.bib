@ARTICLE{Hu2025,
	author = {Hu, Guanlan and Gross, Ofek and Ziraldo, Emily and Mulligan, Christine and Soberman, David and Dewan, Moesha and Lewis, Kyana and Nomani, Raneem and Lu, August and L'Abbé, Mary R.},
	title = {Using artificial intelligence and computer vision to detect and monitor unhealthy child-directed food and beverage marketing: a data-driven study},
	year = {2025},
	journal = {eClinicalMedicine},
	volume = {89},
