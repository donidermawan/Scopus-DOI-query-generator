@BOOK{Schroth2025165,
	author = {Schroth, Jörg},
	title = {Consequentialism and AI},
	year = {2025},
	journal = {A Companion to Applied Philosophy of AI},
	pages = {165 - 177},
	doi = {10.1002/9781394238651.ch12},
	url = {https://www.scopus.com/pages/publications/105015821999?origin=resultslist},
	affiliations = {Department of Philosophy, Georg-August University of Göttingen, Germany},
	abstract = {This chapter explores the applicability and challenges of consequentialism, particularly utilitarianism, as an ethical framework for artificial intelligence (AI). Consequentialism's focus on the outcomes of actions aligns with AI's potential to evaluate and implement complex decision-making processes aimed at optimizing welfare. However, the chapter highlights significant concerns with the theory's “negative dimension,” which permits instrumental harm to achieve optimal outcomes, creating tension with conventional morality. The distinction between direct and indirect act-consequentialism is examined, emphasizing how AI might overcome human cognitive and emotional limitations in applying direct consequentialist principles. Yet, ethical dilemmas such as balancing welfare with values like dignity, justice, and autonomy pose challenges to implementing utilitarianism in machine ethics. The chapter argues that no single ethical theory, including consequentialism, can serve as a universally accepted framework for AI, given its polarizing nature and the intrinsic controversies surrounding its principles. Consequently, while consequentialism offers valuable insights, its suitability for guiding AI ethics remains limited, requiring integration with other ethical considerations to address the diverse range of moral questions posed by AI systems. © 2025 by John Wiley & Sons, Inc. All rights reserved.},
	author_keywords = {Act-consequentialism; Autonomous vehicles; Consequentialism; Direct act-consequentialism; Indirect act-consequentialism; Rule-consequentialism; Utilitarianism},
	keywords = {Decision making; Ethical technology; Act-consequentialism; Autonomous Vehicles; Complex decision; Consequentialism; Decision-making process; Direct act-consequentialism; Ethical dilemma; Indirect act-consequentialism; Rule-consequentialism; Utilitarianism; Autonomous vehicles},
	publisher = {wiley},
	isbn = {978-139423865-1; 978-139423863-7},
	language = {English},
	abbrev_source_title = {A Companion to Appl. Philosophy of AI},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

