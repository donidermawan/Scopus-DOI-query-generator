@ARTICLE{Kirshner20261073,
	author = {Kirshner, Samuel N. and Lawson, Jessica},
	title = {Under pressure: how widespread vs severe competitor unethical practices shape responsible artificial intelligence deployment},
	year = {2026},
	journal = {Internet Research},
	volume = {36},
