	title = {Infrastructural Perspectives on Artificial Intelligence—on the Implications of AI Infrastructures for Global (In)Justice},
	year = {2025},
	journal = {RaumFragen: Stadt - Region - Landschaft},
	volume = {Part F11642},
	pages = {81 - 96},
	doi = {10.1007/978-3-031-74846-2_6},
