	year = {2025},
	journal = {Proceedings of International Conference on Sustainable Communication Networks and Application, ICSCN 2025},
	pages = {1812 - 1817},
	doi = {10.1109/ICSCN67106.2025.11308225},
	url = {https://www.scopus.com/pages/publications/105032727812?origin=resultslist},
	affiliations = {Knowledge Institute of Technology, Department of Artificial Intelligence and Data Science, Salem, India; Sona College of Arts and Science, Department of Computer Applications, Salem, India; Kongu Engineering College, Department of Computer Technology, Erode, India; Mahendra College of Engineering, Department of Information Technology, Salem, India; Knowledge Institute of Technology, Department of Information Technology, Salem, India; Sona College of Technology, Department of Information Technology, Salem, India},
	abstract = {The growth in the use of digital learning environments requires adaptive, intelligent, and ethically responsible AI systems. The existing AI-driven educational tools do not consider the socio-emotional conditions of learners and are not transparent with their decision-making processes. As a solution to this, we present Ethicore AI, a Federated Framework of Neuro-Symbolic blockchain to facilitate trustful multimodal cognitive systems. The framework incorporates 3 innovations: (1) Multimodal Emotion Analysis, which involves processing of facial, vocal, and textual inputs based on deep neural nets; (2) Neuro-Symbolic Reasoning, which involves statistical learning and rule-based ethical reasoning to ensure an explanation and accountability of decisions; (3) Blockchain-enforced Transparency, which involves the recording of all interactions through tamper-proof smart contracts to preserve data integrity and accountability. The results showed that the emotion recognition accuracy is 91.8 percent, interpretation increases significantly compared to black-box models, and no trust violations in ethical audits. With the ability to inject ethical reasoning into the data processing pipeline, the system is capable of anticipating bias and fairness violations beforehand and maintains privacy of data via federated learning. The AI architecture Ethicore AI is superior to traditional architectures in three aspects trust, fairness and responsive to circumstances and provides scaled, responsible, and responsive solutions to the next-generation digital learning system. Its uses are not limited to the educational sector, but also to healthcare, workplace training and human-computer interface, where AI ethics, transparency and emotion sensitivity are paramount.  © 2025 IEEE.},
	author_keywords = {Blockchain Transparency; Ethical Decision-Making; Explainable AI (XAI); Federated Learning; Multimodal Emotion Recognition; Neuro-Symbolic AI; Trustworthy Artificial Intelligence},
	keywords = {Behavioral research; Cognitive systems; Computer aided instruction; Data privacy; Deep learning; E-learning; Emotion Recognition; Ethical technology; Human computer interaction; Interactive computer systems; Learning systems; Neural networks; Psychology computing; Transparency; Block-chain; Blockchain transparency; Cognitive intelligence; Decisions makings; Ethical decision making; Explainable AI (XAI); Multi-modal; Multimodal emotion recognition; Neuro-symbolic AI; Trustworthy artificial intelligence; Blockchain; Decision making},
