@BOOK{Azoury2025317,
	author = {Azoury, Nehme and El Hajj, Cynthia},
	title = {AI in corporate governance: Perspectives from the MENA},
	year = {2025},
	journal = {AI in the Middle East for Growth and Business: A Transformative Force},
	pages = {317 - 326},
	doi = {10.1007/978-3-031-75589-7_18},
	url = {https://www.scopus.com/pages/publications/105005818936?origin=resultslist},
	affiliations = {UBS, Holy Spirit University of Kaslik (USEK), Jounieh, Lebanon},
	abstract = {This chapter examines the emerging role of AI in transforming corporate governance within the Middle East. It highlights AI's contributions to enhancing decision-making in the boardroom through real-time data analysis, improving risk management with predictive analytics, and ensuring regulatory compliance via automated monitoring systems. The chapter addresses crucial ethical issues such as data privacy, algorithmic bias, and accountability in AI-driven decisions, underscoring the importance of ethical frameworks and guidelines for responsible AI use. It emphasizes AI's potential to make corporate governance more transparent, efficient, and accountable across the region. However, it also stresses the necessity for ongoing education, ethical oversight, and regulatory updates to maximize AI's benefits in governance while addressing its challenges. This chapter aims to provide a nuanced understanding of AI's impact on corporate governance in the Middle East, balancing its advantages with the need for ethical and regulatory safeguards. © Springer Nature Switzerland AG 2025. All rights reserved.},
	keywords = {Risk management; Algorithmics; Automated monitoring systems; Corporate governance; Decisions makings; Ethical issues; Middle East; Real time data analysis; Risks management; Risk perception},
	correspondence_address = {N. Azoury; UBS, Holy Spirit University of Kaslik (USEK), Jounieh, Lebanon; email: nehmeazoury@usek.edu.lb},
	publisher = {Springer Nature},
	isbn = {978-303175589-7; 978-303175588-0},
	language = {English},
	abbrev_source_title = {AI in the Middle East for Growth and Bus.: A Transform. Force},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Mayeesha2025260,
	author = {Mayeesha, Tasmiah Tahsin and Islam, Farzana and Ahmed, Nova},
	title = {AI4Bangladesh: AI Ethics for Bangladesh - Challenges, Risks, Principles, and Suggestions},
	year = {2025},
	journal = {ICTD 2024 - Proceedings of the 2024 International Conference on Information and Communication Technologies and Development},
	pages = {260 - 272},
	doi = {10.1145/3700794.3700820},
	url = {https://www.scopus.com/pages/publications/105002273075?origin=resultslist},
	affiliations = {North South University, Dhaka, Bangladesh},
	abstract = {In recent times, the term AI ethics caught the attention among the academics, legislators, developers, and among AI users to promote ethical AI development. While countries in the North have led the way in discussions about the direction of ethical and responsible artificial intelligence development and deployment, perspectives from developing countries like Bangladesh are underrepresented. Based on 32 qualitative interviews with different stakeholders, including machine learning practitioners, academic researchers, and policymakers in the emerging AI ecosystem in Bangladesh, this work closely examines the ongoing challenges and opportunities to ensure AI ethics in Bangladesh with emerging AI usage. In Bangladesh, the government has not yet fully implemented measures to empower citizens with AI-related skills, policies, resources, and data ethics, and a significant portion of the population lacks knowledge in AI. In this paper, we are presenting the findings of AI4Bangladesh project that intend to create the roadmap for ethical AI in Bangladesh. We outline the core challenges, present situation, and risks of AI for Bangladesh; propose seven AI ethics principles, and offer suggestions to ensure a transparent, accountable, and fair AI ecosystem for Bangladesh.  © 2024 Copyright held by the owner/author(s).},
	author_keywords = {AI Ethics; AI Governance; Ethics principles; Human Centered AI},
	keywords = {AI ethic; AI governance; Bangladesh; Ethic principle; Human centered AI; Machine-learning; Policy makers; Present situation; Qualitative interviews; Roadmap},
	correspondence_address = {T.T. Mayeesha; North South University, Dhaka, Bangladesh; email: tasmiahtahsinmayeesha@gmail.com},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840071041-4},
	language = {English},
	abbrev_source_title = {ICTD - Proc. Int. Conf. Inf. Commun. Technol. Dev.},
	type = {Conference paper},
	publication_stage = {Final},
