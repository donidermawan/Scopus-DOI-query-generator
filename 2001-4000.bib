	title = {A Framework for Safe AI: Data Governance and Ecosystem Structure},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Artificial Intelligence Testing, AITest 2025},
	pages = {11 - 23},
	doi = {10.1109/AITest66680.2025.00008},
	url = {https://www.scopus.com/pages/publications/105016250299?origin=resultslist},
	affiliations = {Arizona State University, AZ, United States; Research Center of Social Security and Enterprise Finance, University of International Business and Economics, Beijing, China; State Key Lab of Complex&Critical Software Environment, Beihang University, Beijing, China},
	abstract = {Large Language Models have become a foundational component of modern artificial intelligence, but their development is often hindered by inadequate data governance, resulting in challenges such as hallucinations, intellectual property violations, and security vulnerabilities. In light of emerging regulatory requirements, this paper presents a Collaborative Safe AI Framework (CSAIF) for building safe AI systems through robust data lifecycle management and ecosystem collaboration. This paper analyzes governance principles drawn from the U.S. Blueprint for an AI Bill of Rights and the EU AI Act, emphasizing transparency, traceability, explainability, and auditability. Existing industry practices are reviewed to identify current strengths and limitations. This paper then introduces an approach that treats data as verifiable digital assets and a Data Container architecture to encapsulate both content and governance metadata. This design enables version control, access management, data sovereignty, and usage logging across the AI model lifecycle. The CSAIF defines the responsibilities of data providers, validation entities, application developers, and regulatory actors, and outlines a process that ensures data integrity, lawful use, and accountability. By integrating technical safeguards with operational oversight, the proposed CSAIF establishes a trustworthy foundation for developing and deploying AI models in compliance with legal and ethical standards. © 2025 IEEE.},
	author_keywords = {blockchain; data governance; large language models; regulatory compliance},
	keywords = {Access control; Artificial intelligence; Ecosystems; Ethical aspects; Government data processing; Information management; Life cycle; Block-chain; Data governances; Ecosystem structure; Governance structures; Inadequate data; Language model; Large language model; Property; Regulatory requirements; Security vulnerabilities; Regulatory compliance},
