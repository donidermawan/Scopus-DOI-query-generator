	year = {2025},
	journal = {Proceedings - 9th International Conference on Information Technology, InCIT 2025},
	pages = {146 - 151},
	doi = {10.1109/InCIT66780.2025.11276059},
	url = {https://www.scopus.com/pages/publications/105031048599?origin=resultslist},
	affiliations = {Chung-Ang Univerisity, Dep.of Artificial Intelligence, Seoul, South Korea},
	abstract = {As the military application of AI expands, the issue of autonomous ethical decision-making by AI in weapon systems such as fighter aircraft has emerged as a critical challenge. This study proposes a mathematical model that quantitatively integrates national military AI ethical principles, the Law of Armed Conflict (LOAC), and battlefield variables to assess AI ethical decisions. Based on simulations of 38 combat scenarios, the scenarios were classified into three groups according to their ethical decision structures and sensitivity characteristics. The integrated model showed lower volatility and higher consistency compared to single-standard models based solely on LOAC or national ethics, indicating that the balance between national ethical standards and tactical context is a key factor. This research provides a foundational framework for quantifying ethical decision-making in military AI and offers practical contributions to defense AI ethics policy, human-AI collaboration, and system design.  © 2025 IEEE.},
