	year = {2025},
	journal = {2025 25th Conference of the Electric Power Supply Industry, CEPSI 2025},
	pages = {1097 - 1102},
	doi = {10.1109/CEPSI66359.2025.11403214},
	url = {https://www.scopus.com/pages/publications/105036526070?origin=resultslist},
	affiliations = {Tenaga Nasional Berhad, System Planning & Industry Market, Kuala Lumpur, Malaysia},
	abstract = {The growing demand for cloud computing, artificial intelligence (AI), and big data analytics have driven an unprecedented surge in Data Centre (DC) development worldwide. On the supply side, advancements in AI chip processors and other enabling technologies have further accelerated DC growth. Given these trends, forecasting future electricity demand may seem straightforward, with DC expected to drive rapid electricity consumption growth. In Malaysia, which has rapidly emerged as a key DC hub due to its strategic location, competitive resource costs, and favourable business environment has experienced similar trajectory. Over the past two years, electricity demand from DC has shifted from being a negligible component compared to other bulk loads to a distinct and rapidly growing demand driver. As of Dec 2024, Malaysia's DC electricity consumption has reached 434.5 MW [1] and the government has estimated that this demand will surge to 12.9 GW by 2030 [2]. However, experiences from established DC markets such as the United States, Ireland, and Singapore highlight challenges posed by this energy-intensive industry [3]. As power availability becomes constrained, restrictive policies have been introduced in these countries to regulate DC expansion. This raises a key challenge for electricity demand forecasting: should load projections reflect unrestricted DC growth, or should they account for regulatory limitations and supply constraints? To navigate these uncertainties, this paper proposes integrating DC into scenario-based power system planning. By treating DC as a distinct load category, the study examines variations in energy consumption driven by factors such as efficiency improvements, cooling technologies, AI workload shifts, and regulatory uncertainties. Three scenarios, which are Business-as-Usual (BAU), Progressive Realization DC Demand Growth, and Explosive DC Demand Growth are analysed to assess their implications for generation planning, grid stability, and infrastructure investment. Based on these scenarios, DC demand is projected to range between 10.1 GW and 15.9 GW by 2030, with increased uncertainty around the longer-term trajectory placing the demand to range between 16.7 GW and 25.0 GW by 2040. The findings highlight the need for adaptive scenario planning approaches that go beyond traditional forecasting, ensuring grid reliability, optimizing investment strategies, and supporting sustainability goals. As DC continues to evolve as a dominant electricity consumer, integrating them into power system planning through scenario analysis will be essential to build a resilient and efficient energy ecosystem. © 2025 IEEE.},
	author_keywords = {data centre; load forecasting methodology; power system planning; scenario analysis},
	keywords = {Advanced Analytics; Big data; Data centers; Electric load forecasting; Electric power utilization; Green computing; Investments; Sustainable development; Uncertainty analysis; Datacenter; Electricity demands; Growing demand; Load forecasting; Load forecasting methodology; Malaysia; Power systems planning; Scenario Planning; Scenarios analysis; Uncertainty; Electric power system planning},
	correspondence_address = {J.R. Mojingkui; Tenaga Nasional Berhad, System Planning & Industry Market, Kuala Lumpur, Malaysia; email: juseyreccla.mojingkui@tnb.com.my},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
