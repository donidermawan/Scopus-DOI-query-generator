@CONFERENCE{Deng2025143,
	author = {Deng, Changtao and Li, Xiaowei},
	title = {Integrating Artificial Intelligence and Hydro-Hydraulic Models for Flood Simulation and Disaster Assessment: Applications in Urban Waterlogging and Water Resources Management},
	year = {2025},
	journal = {Proceedings of 2025 3rd International Conference on Internet of Things and Cloud Computing Technology, IoTCCT 2025},
	pages = {143 - 152},
	doi = {10.1145/3776865.3776890},
	url = {https://www.scopus.com/pages/publications/105026343000?origin=resultslist},
	affiliations = {Pearl River Water Resources Research Institute, Guangdong, Guangzhou, China; Hainan Provincial Institute of Modern Emergency Management, Hainan, Haikou, China},
	abstract = {Under the background of global climate change and rapid urbanization, water disasters such as urban waterlogging and flow flooding are becoming more and more frequent, while the traditional hydrological and hydraulic models have the limitations of low calculation efficiency and weak uncertainty processing ability. Taking the central urban section of Suzhou River basin in Shanghai (with a total area of about 82 km²), a typical representative of high-density urbanization river basins in China, as the research area, this study aims to develop an artificial intelligence (AI) framework that integrates physical mechanism and data-driven to improve the accuracy and speed of flood simulation, and realize dynamic disaster assessment and review. In terms of research methods, multi-source data such as satellite remote sensing (such as Sentinel-1 SAR), radar, IoT sensors, and social media are integrated (covering the full time scale of "history-realtime-future"and the full space dimension of "point-line-plane"). Dual-track coupling mode of "physically-driven model + AI-enhanced model"is adopted: Short-term rainfall prediction (0-6 hours) and river flow prediction were realized through Long Short-Term Memory network (LSTM), Transformer and other models. A multi-modal U-Net deep learning architecture was used to construct an alternative model to accelerate two-dimensional hydrodynamic simulation, and GIS technology was combined to carry out disaster assessment. The effectiveness of the framework is verified by the measured data of Shanghai Suzhou River basin and historical events (such as the heavy rain in 2021 and the rain of Typhoon "Can Do"in 2023). The main results show that the determination coefficient R^2=0.92 and the Nash efficiency coefficient NSE=0.90 of the AI hydrological forecasting module for the simulation of Suzhou River main flow, which is significantly higher than the accuracy of the traditional model. The AI-accelerated flood simulation module compressed the simulation time of a single 24-hour rainfall event from 1.5 hours in the traditional model to 4 minutes, increasing the efficiency by 22 times, and the peak flow error was only 3.1% (21.3% in the traditional model). At the application level, under the D1 scheduling scenario, the number of waterlogging points in the study area was reduced from 43 to 25 (reduction rate of 41.9%), and the over-alarm time of the main stream of Suzhou River was shortened from 18 hours to 10 hours (reduction rate of 44.4%). In the D2 scenario (considering the use of rain and flood), the rainwater resource is 28 million m³ in the flood season in 2021 (4.6 times higher than that in the non-regulation scenario), and the water level of the river in the dry season is maintained at 2.6-2.8m (meeting the demand of the ecological base flow of 2.5m) through ecological water recharge in the non-flood season, and the COD is reduced by 15%-20%. The conclusion shows that the AI integration framework breaks the limitation of the traditional model of "high precision but high time consumption", realizes the multi-objective collaboration of "flood control and disaster reduction, water resources optimization and ecological protection", and provides a scientific decision support tool for flood prevention, water resources allocation and resilient city construction in the field of water conservancy and water utilities. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Alternative model; Artificial intelligence; Digital twin; Disaster assessment; Flood simulation; Hydrological and hydraulic model; Machine learning; Shanghai; Suzhou River Basin; Urban waterlogging; Water resources management},
	keywords = {Climate change; Climate models; Disasters; E-learning; Flood control; Floods; Forecasting; Geographic information systems; Hydraulic machinery; Hydraulic models; Hydrodynamics; Learning systems; Long short-term memory; Rain; Rivers; Space-based radar; Storms; Water management; Water resources exploration; Alternative model; Disaster assessment; Flood simulation; Hydrological and hydraulic model; Machine-learning; River basins; Shanghai; Suzhou river basin; Urban waterlogging; Water resources management; Watersheds},
	correspondence_address = {C. Deng; Pearl River Water Resources Research Institute, Guangzhou, Guangdong, China; email: 181352864@qq.com},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840072114-4},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Internet Things Cloud Comput. Technol., IoTCCT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
