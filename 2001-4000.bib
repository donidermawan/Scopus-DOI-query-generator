@CONFERENCE{Wood20253326,
	author = {Wood, Alexandra and Edenberg, Elizabeth},
	title = {Epistemic Injustice in Algorithmic Systems and the Limits of Civil Rights Law},
	year = {2025},
	journal = {ACMF AccT 2025 - Proceedings of the 2025 ACM Conference on Fairness, Accountability,and Transparency},
	pages = {3326 - 3335},
	doi = {10.1145/3715275.3732213},
	url = {https://www.scopus.com/pages/publications/105010819057?origin=resultslist},
	affiliations = {Berkman Klein Center for Internet & Society, Harvard University, Cambridge, MA, United States; Department of Philosophy, Baruch College, CUNY, New York, NY, United States},
	abstract = {Mathematical definitions of algorithmic fairness have become central to efforts to address potential discriminatory effects from machine learning and artificial intelligence applications. These quantitative measures carry significant weight, derived in large part from their purported grounding in legal conceptions of nondiscrimination, and they are increasingly deployed in a wide range of highly consequential settings. This paper critically examines how these mathematical constructs diverge from their legal foundations, with a focus on the anticlassification and antisubordination principles underpinning US civil rights law. It argues that applying an epistemic lens on algorithmic fairness previously introduced in the literature provides an opportunity for better aligning technical definitions of fairness with legal notions of nondiscrimination. In particular, it offers a theoretical foundation for affirming the antisubordination principle and thereby extending the protections of antidiscrimination law to classes of algorithmic harm that have yet to be formally recognized.  © 2025 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
