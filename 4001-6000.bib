@CONFERENCE{Kumar2025678,
	author = {Kumar, Santosh},
	title = {EdgeCareRT: A Real-Time Federated Generative AI Framework for Clinical Decision Support in Mobile and Remote Healthcare Settings},
	year = {2025},
	journal = {2025 IEEE 16th Annual Information Technology, Electronics and Mobile Communication Conference, IEMCON 2025},
	pages = {678 - 683},
