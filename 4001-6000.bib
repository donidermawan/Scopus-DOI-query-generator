@BOOK{Panattoni2025392,
	author = {Panattoni, Beatrice},
	title = {Generative AI and Criminal Guilt: When No One Meant to Harm},
	year = {2025},
	journal = {The Cambridge Handbook of Generative AI and the Law},
	pages = {392 - 404},
	doi = {10.1017/9781009492553.027},
	url = {https://www.scopus.com/pages/publications/105035052937?origin=resultslist},
	affiliations = {University of Verona, Italy},
	abstract = {Several criminal offences can originate from or culminate with the creation of content. Sexual abuse can be perpetrated by producing intimate material without the subject’s consent, while incitement to criminal activity can begin with a simple conversation. When the task of generating content is entrusted to artificial agents, it becomes necessary to delve into the associated risks posed by this technology. Generative AI changes criminal affordances because it simplifies access to harmful or dangerous content, amplifies the range of recipients, creates new kinds of harmful content, and can exploit cognitive vulnerabilities to manipulate user behaviour. Given this evolving landscape, the question that arises is whether criminal law should be involved in the policies aimed at fighting and preventing Generative AI-related harms. The bulk of criminal law scholarship to date would not criminalise AI harms on the theory that AI lacks moral agency. However, when a serious harm occurs, responsibility needs to be distributed considering the guilt of the agents involved, and, if it is lacking, it needs to fall back because of their innocence. Legal systems need to start exploring whether and how guilt can be preserved when the actus reus is completely or partially delegated to Generative AI. © Cambridge University Press & Assessment 2025.},
	author_keywords = {AI regulation; content-related offences; criminal law; Generative AI; Generative AI-related harms; LLMs; mens rea},
	keywords = {Artificial intelligence; Behavioral research; Cognitive systems; Computational methods; AI regulation; Content-related offense; Criminal activities; Criminal laws; Criminal offences; Generative AI; Generative AI-related harm; LLM; Man rea; Simple++; Crime},
