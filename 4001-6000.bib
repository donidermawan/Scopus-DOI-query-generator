	affiliations = {University of Illinois Urbana Champaign, Dallas, United States; University of the Cumberlands, KY, United States; Google Search, Google, Mountain View, CA, United States},
	abstract = {Current AI model evaluation approaches employ uniform weighting schemes that fail to capture context-specific requirements and stakeholder priorities, leading to suboptimal model selection decisions in real-world deployments. Traditional methods prioritize raw performance metrics while neglecting critical dimensions such as fairness, privacy, and robustness, resulting in misaligned model choices for safety-critical, creative, and social applications. We introduce ARIA (AI Responsibility and Impact Assessment), a novel context-adaptive evaluation framework that dynamically weights five responsibility dimensions - performance, fairness, robustness, privacy, and sustainability - based on application context and stakeholder profiles. ARIA incorporates uncertainty quantification, cascading penalty mechanisms for critical weaknesses, and multi-objective optimization to provide comprehensive model assessment beyond traditional accuracy-focused approachesOur empirical evaluation across three state-of-the-art language models (LLaMA 3.3 70B, Claude 3.5 Sonnet, GPT-4o) in critical systems, creative tools, and social platform contexts demonstrates ARIA's superiority over conventional methods. Results show low correlations (Kendall's τ = -0.67 to 0.67) between ARIA and traditional rankings, indicating that uniform approaches misrepresent model suitability in up to 60% of scenarios. Statistical analysis confirms significant performance differences with 95% confidence intervals and robust rank stability (>0.89) underweight perturbationsARIA provides actionable decision support through context-stakeholder matrices, enabling organizations to align model selection with specific requirements and risk tolerance. The framework addresses critical gaps in responsible AI deployment, offering practitioners a scientifically rigorous methodology for context-appropriate model selection that balances performance excellence with multi-dimensional responsibility considerations, supporting more informed and ethical AI system deployment decisions. © 2025 IEEE.},
	author_keywords = {AI Governance Framework; Context-Adaptive AI Evaluation; Large Language Model Evaluation; Multi-Dimensional Model Selection; Responsible AI Assessment},
	keywords = {Artificial intelligence; Ethical technology; Multiobjective optimization; Risk assessment; Safety engineering; Uncertainty analysis; AI governance framework; Context-adaptive AI evaluation; Impact assessments; Language model; Large language model evaluation; Model evaluation; Model Selection; Multi-dimensional model; Multi-dimensional model selection; Responsible AI assessment; Decision support systems},
