@ARTICLE{Kumar20251,
	author = {Kumar, Dinesh and Suthar, Nidhi and Rodriguez, Raul Villamarin and K., Hemachandran},
	title = {Distributing ethical responsibility in hybrid human–AI systems: a conceptual framework and evaluation model},
	year = {2025},
	journal = {Journal of Information, Communication and Ethics in Society},
	pages = {1 - 18},
	doi = {10.1108/JICES-07-2025-0174},
	url = {https://www.scopus.com/pages/publications/105024475122?origin=resultslist},
	affiliations = {Department of Business Analytics, Woxsen University, Hyderabad, India; Department of Entrepreneurship, Woxsen University, Hyderabad, India; Department of Artificial Intelligence, Woxsen University, Hyderabad, India; Department of Business Analytics, Woxsen University, Hyderabad, India},
	abstract = {Purpose – This paper aims to introduce a conceptual and diagnostic model. This model evaluates how ethical responsibility is distributed in hybrid human–AI systems operating in high-stakes domains. Design/methodology/approach – This study develops a multi-dimensional framework of responsibility and proposes the ethical responsibility distribution evaluation model (ERDEM). It is drawn on science and technology studies (STS), postphenomenology and ethics of care. The framework outlines three responsibility dimensions: agency attribution, responsibility types and interaction modes. ERDEM evaluates ethical design based on five criteria – transparency, accountability, fairness, role clarity and human control. Findings – This paper identifies four system configurations that shape responsibility flows in hybrid arrangements. It demonstrates the practical value of ERDEM by illustrative cases. It shows how system design and institutional settings influence moral clarity and blame attribution. Research limitations/implications – This study shifts attention from individual blame to systemic responsibility. It contributes to emerging theories in AI governance. These include design ethics and relational agency. Practical implications – ERDEM gives system designers and regulators a structured way to assess ethical robustness. It turns abstract principles into practical criteria. The framework also guides the development of governance practices that remain sensitive to responsibility. It provides a structured method to assess ethical robustness in AI-supported decisions. It also supports the development of responsibility-sensitive AI governance practices. Originality/value – This study advances the debate on AI responsibility. The focus shifts from individual culpability to distributed responsibility across socio-technical systems. Such responsibility is designable and embedded within socio-technical systems. It contributes to a novel conceptual model and actionable tool for ethics-by-design in hybrid decision-making contexts. © 2025 Emerald Publishing Limited},
	author_keywords = {AI ethics; AI explainability; ERDEM framework; Human–AI collaboration; Hybrid decision systems; Responsibility attribution; Socio-technical system},
	publisher = {Emerald Publishing},
	issn = {1477996X},
	language = {English},
	abbrev_source_title = {J. Inf. Commun. Ethics Soc.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 4}
}

@BOOK{Najar2025295,
	author = {Najar, Aabid Mushtaq and Kumar, Devender and Dua, Sakshi and Dua, Sonu},
	title = {Ethical and Legal Implications of AI in Entrepreneurship},
	year = {2025},
	journal = {Transforming Business Education through Artificial Intelligence},
	pages = {295 - 319},
	doi = {10.1201/9781998511471-15},
	url = {https://www.scopus.com/pages/publications/105023778567?origin=resultslist},
	affiliations = {Lovely Professional University, Punjab, India; Lyallpur Khalsa College Technical Campus, Jalandhar, Punjab, India},
	abstract = {The entrepreneurial landscape is being reshaped by the emergence of artificial intelligence (AI). While AI promises immense potential for efficiency, innovation, and growth, its integration raises critical ethical and legal considerations that entrepreneurs must navigate. One primary concern lies in the potential for bias within AI algorithms. Trained on existing data, these algorithms can perpetuate societal prejudices, leading to unfair discrimination in areas like hiring, loan approvals, and product recommendations. This necessitates building diverse data sets, implementing fairness metrics, and continuously monitoring and evaluating AI models to mitigate bias. Transparency surrounding AI decision-making is another crucial aspect. Often, AI systems operate as “black boxes,” making it difficult to understand how they arrive at conclusions. This lack of transparency can erode trust and raise concerns about accountability, particularly when AI-powered systems make critical decisions that impact individuals or society. Entrepreneurs also face a complex legal landscape with AI. Data privacy regulations like GDPR require careful handling of personal information used to train and operate AI systems. Additionally, questions of intellectual property ownership and liability in the case of AI-related errors or malfunctions remain largely uncharted territory. Addressing these ethical and legal challenges is essential for responsible and sustainable AI adoption in entrepreneurship. © 2026 by Apple Academic Press, Inc.},
	author_keywords = {AI bias; AI ethics; AI privacy; AI regulations; AI startups; artificial intelligence; entrepreneurship; ethical concerns in AI; legal challenges for AI entrepreneurs; legal implications of AI; transparency in AI},
	keywords = {Data privacy; Decision making; Ethical technology; Laws and legislation; Transparency; Artificial intelligence bias; Artificial intelligence ethic; Artificial intelligence privacy; Artificial intelligence regulation; Artificial intelligence startup; Entrepreneurship; Ethical concern in artificial intelligence; Ethical concerns; Legal challenge for artificial intelligence entrepreneur; Legal implication of artificial intelligence; Legal implications; Transparency in artificial intelligence; Artificial intelligence},
	publisher = {Apple Academic Press},
