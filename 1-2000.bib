	correspondence_address = {E. Boulougouris; Department of Naval Architecture, Ocean and Marine Engineering, Maritime Safety Research Centre (MSRC), University of Strathclyde, Glasgow, G4, 0LZ, United Kingdom; email: evangelos.boulougouris@strath.ac.uk},
