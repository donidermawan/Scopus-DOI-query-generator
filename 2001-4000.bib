	affiliations = {Universidad Privada Del Norte, Faculty of Law, Lima, Peru; Universidad Privada Del Norte, Innovation Research & Social Responsibility Directorate, Lima, Peru; Universidad Católica Del Perú, Faculty of Engineering Pontificia, Lima, Peru},
	abstract = {The incorporation of artificial intelligence (AI) in legal education is transforming traditional teaching models by shifting them towards constructivist and ethical-technological approaches that integrate digital competencies and values of transparency, responsibility, and human control. This systematic review, based on the PRISMA 2020 model and 29 international studies published between 2020 and 2025, analyzes how the teaching of A I in law programs contributes to the development of these competencies and identifies curricular gaps and good practices. The study proposes improvements in autonomy, critical thinking, and learning experience, although gaps persist in teacher training, infrastructure, and digital ethics, especially in Latin America. An educational model that articulates innovation, integrity and algorithmic governance is proposed, in line with Sustainable Development Goals 4 and 16, aimed at training jurists capable of supervising, auditing and correcting automated systems with ethical and critical criteria.  © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Competences; Digital LegalTech; Ethics; Governance; Legal Education},
	keywords = {Automation; E-learning; Ethical technology; Personnel training; Public policy; Teaching; Competence; Critical thinking; Digital legaltech; Good practices; Governance; Human control; International studies; Legal educations; Systematic Review; Teaching model; Artificial intelligence},
