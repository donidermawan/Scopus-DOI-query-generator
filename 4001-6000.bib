@ARTICLE{Ferrara20252727,
	author = {Ferrara, Massimiliano and Isgrò, Valeria},
	title = {Explainable Multi-Criteria Decision Analysis for Supply Chain Risk Management: An Integrated FRAM-AHP-XAI Framework with Theoretical Foundations},
	year = {2025},
	journal = {WSEAS Transactions on Business and Economics},
	volume = {22},
	pages = {2727 - 2732},
	doi = {10.37394/23207.2025.22.214},
