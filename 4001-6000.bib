	author = {Hammerschmidt, Teresa and Hafner, Alina and Stolz, Katharina and Passlack, Nina and Posegga, Oliver and Gerholz, Karl-Heinz},
	title = {A Review of How Different Views on Ethics Shape Perceptions of Morality and Responsibility within AI Transformation},
	year = {2025},
