@BOOK{Clancy2025124,
	author = {Clancy, Martin},
	title = {LAW: Reflection 2.0 (2024): Interview with David Hughes},
	year = {2025},
	journal = {Artificial Intelligence and Music Ecosystem: Second Edition},
	pages = {124 - 128},
	doi = {10.4324/9781003516989-10},
	url = {https://www.scopus.com/pages/publications/105040046431?origin=resultslist},
	affiliations = {Dublin City University, Insight Centre for Data Analytics, Ireland},
	abstract = {This chapter explores the fragile intersection of music copyright and AI, highlighting how legal arguments could create the opportunity for a nonhuman legal entity-an AI-to challenge the long-standing, human-centric foundations of intellectual property (IP). The analysis begins by tracing the global effort to harmonise IP law and establish music copyright’s crucial role in the economic structures of the music industry. After outlining the historical evolution of core legal concepts such as originality, creativity, and fair use, the discussion emphasises the disruptive implications of self-learning AI (e.g., DeepMind’s WaveNet). WaveNet’s ability to assemble micro-samples (well below human perceptual thresholds) emphasises how traditional copyright doctrines (e.g., de minimis, substantial similarity) may be ill-suited for the modern era. Building on these legal complexities, an updated interview with David Hughes (CTO, RIAA 2006-2021) contextualises current industry thinking about AI’s expansion and potential “threat of replacement” scenarios. Hughes underscores emerging solutions like AI:OK, a Trustmark system that aims to certify “responsible AI usage” for creative works, and discusses how high-profile lawsuits, rapid model versioning, and new “guardrail” functionalities in generative AI all shape the shifting legal landscape. Cases like Anthropic’s alleged misuse of “American Pie” lyrics reveal how fair use, input licensing, and the nontransparent “black box” nature of model training drive ongoing conflicts-and the question remains whether an AI can (and should) claim full legal personhood in music. As these tensions escalate, this chapter concludes that the existing framework of human-origin copyright law, rooted in a pre-digital era, may be insufficient to address the wave of AI-generated music-ultimately requiring ethically informed, sector-specific legal reform to maintain an equitable and sustainable music ecosystem. © 2026 selection and editorial matter, Martin Clancy; individual chapters, the contributors.},
