	year = {2025},
	journal = {Proceedings of 5th International Conference on Soft Computing for Security Applications, ICSCSA 2025},
	pages = {998 - 1006},
	doi = {10.1109/ICSCSA66339.2025.11170858},
	url = {https://www.scopus.com/pages/publications/105018457465?origin=resultslist},
	affiliations = {Som, Graphic Era Hill University, Bhimtal, India; Fom Invertis University, Bareilly, India; Som Iftm University, Moradabad, India; Invertis University, Faculty of Law, Bareilly, India},
	abstract = {The proliferation of Artificial Intelligence (AI) technologies has transformed numerous industries, providing unprecedented efficiency and innovation. Nevertheless, this rapid progress has prompted substantial ethical and legal concerns that necessitate cautious contemplation. In the context of artificial intelligence systems becoming more prevalent in daily life, concerns about privacy, bias, accountability, transparency, and societal impact have arisen. This paper uses the ISM-MICMAC approach to systematically examine and establish the interdependence of determinants influencing AI's ethical and legal practices. Identifying and evaluating these factors creates a structured model to illuminate their complex relationships. According to the study, legal compliance and regulations are the most important determinants, having the greatest impact on other ethical and legal factors. Furthermore, the MICMAC analysis classifies these determinants into autonomous, dependent, linkage, and independent clusters based on their driving and reliance capabilities. The findings underscore the critical importance of prioritizing legal compliance and regulations in enhancing ethical and legal AI practices. The developed model provides valuable insights for decision-makers, aiding in the anticipation of crucial ethical and legal considerations to foster responsible AI development and usage. This systematic approach enhances understanding of AI's ethical and legal implications, promoting the development of ethical and legally compliant AI practices across various fields. © 2025 IEEE.},
	author_keywords = {Artificial intelligence; Ethics; ISM; Legal; MICMAC},
	keywords = {Decision making; Ethical technology; Laws and legislation; Artificial intelligence systems; Artificial intelligence technologies; Daily lives; Ethical concerns; ISM; Legal; Legal compliance; Legal concern; Legal regulation; MICMAC; Artificial intelligence},
	correspondence_address = {S. Sharma; Som, Graphic Era Hill University, Bhimtal, India; email: somesh.sharma1982@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159491-6},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Soft Comput. Secur. Appl., ICSCSA},
	type = {Conference paper},
