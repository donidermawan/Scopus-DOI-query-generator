@CONFERENCE{Camporeale2025,
	author = {Camporeale, Mauro Giuseppe and Kaymak, Uzay and Dimauro, Giovanni},
	title = {Prototype Trees to Develop an Interpretable Automated Pipeline for Nasal Cytology},
	year = {2025},
	journal = {IEEE International Conference on Fuzzy Systems},
	pages = {},
	doi = {10.1109/FUZZ62266.2025.11152079},
	url = {https://www.scopus.com/pages/publications/105017422088?origin=resultslist},
	affiliations = {Università Degli Studi di Bari 'Aldo Moro', Dept. of Computer Science, Bari, Italy; Eindhoven University of Technology, Jheronimus Academy of Data Science, Eindhoven, Netherlands},
	abstract = {Explainable Artificial Intelligence (XAI) seeks to enhance transparency, accountability, and trust in computer systems. In healthcare, ensuring regulatory compliance and fostering user confidence are critical objectives. Nasal cytology is a promising yet underutilized diagnostic technique for rhinitis and allergies, primarily due to the labor-intensive nature of manual cell counting. Moreover, it remains one of the few medical subfields where XAI has yet to be widely explored. To address these challenges, we propose a novel automated pipeline for nasal cytology analysis that combines object detection with interpretable and fuzzy-enhanced cell classification. The system follows a divide-and-conquer approach, utilizing YOLOv8 for cell detection and ProtoTree, an intrinsically interpretable model, for cell classification. To improve decision-making under uncertainty, we investigated three fuzzy t-norm operators to select the best path in the tree at prediction time, enhancing interpretability and robustness. Experimental evaluations showed YOLOv8 achieving an AP50 of 0.861, while the ProtoTree classifier, tested with various CNN backbones - including a novel YOLOv8-based variant - achieved an F1-score of 0.534. Despite challenges with rare cell types due to dataset imbalance, the system demonstrated strong performance in identifying common cell types such as epithelial cells and neutrophils. By incorporating fuzzy logic into an explainable AI framework, our approach advances the accessibility and efficiency of nasal cytology while ensuring interpretability. This fusion of symbolic reasoning and deep learning highlights the potential of fuzzy-enhanced XAI for trustworthy medical diagnostics.  © 2025 IEEE.},
	author_keywords = {Explainable Artificial Intelligence; Nasal Cytology; Object Detection; Prototype-Based Learning},
	keywords = {Cells; Cytology; Decision making; Deep learning; Diagnosis; Fuzzy logic; Object recognition; Pipelines; Regulatory compliance; Respiratory mechanics; Cell classification; Cell counting; Cell types; Diagnostics techniques; Explainable artificial intelligence; Interpretability; Labour-intensive; Nasal cytology; Objects detection; Prototype-based learning; Object detection},
