@CONFERENCE{Niloy2025,
	author = {Niloy, Md. Robiul Islam and Islam, Md. Jahirul and Farhat, Md. Emon Kondaker and Akimoto, Youhei},
	title = {Balancing Transparency and Safety: A Framework for Responsible Disclosure of Adversarial Vulnerabilities in Aligned Language Models},
	year = {2025},
	journal = {2025 IEEE International Conference on Quantum Photonics, Artificial Intelligence, and Networking, QPAIN 2025},
	pages = {},
	doi = {10.1109/QPAIN66474.2025.11171629},
	url = {https://www.scopus.com/pages/publications/105019039069?origin=resultslist},
	affiliations = {United College of Aviation Science and Management, Department of Computer Science and Engineering, Dhaka, 1230, Bangladesh; Jahangirnagar University, Department of Computer Science and Engineering, Dhaka, 1342, Bangladesh; United College of Aviation Science and Management, Department of Aeronautical Engineering, Dhaka, 1230, Bangladesh; University of Tsukuba, Faculty of Engineering, Information and Systems, Center for Ai Research, Tsukuba, 305-8577, Japan},
	abstract = {Despite their remarkable progress in producing text that resembles that of a person, large language models (LLMs) remain susceptible to adversarial prompts that can circumvent alignment mechanisms and yield undesirable outputs. Although the dual-use dangers of adversarial tools have been addressed in previous studies, including our earlier work on the PAIR tool and its governance implications, a crucial gap remains in the responsible disclosure of transferable vulnerabilities, those that can harm multiple models. To responsibly disclose transferable adversarial vulnerabilities in LLMs, we present a technically sound governance system in this study. Through the use of PAIR, we empirically assess prompt transferability between GPT-4 and Vicuna-13B, demonstrating that even queries optimized for one model frequently succeed in transferring to the other. Our architecture differs from current standards, such as CVSS and CERT, in that it addresses this danger through modular disclosure phases, risk triage methodologies, and stakeholder-specific incentives. Additionally, we suggest dual-use risk taxonomies and gentle enforcement strategies that complement new AI safety guidelines. In the era of foundation models, our study offers a novel, practical approach to bridging the gap between technological vulnerability studies and ethical governance. © 2025 IEEE.},
	author_keywords = {Adversarial Vulnerabilities; AI Safety; Coordinated Vulnerability Disclosure; Cybersecurity; Dual-use Risk; Governance Framework; Large Language Models; Model Alignment; Responsible Disclosure; Transferable Jail-breaks},
	keywords = {Artificial intelligence; Cybersecurity; Risk management; Transparency; Adversarial vulnerability; AI safety; Coordinated vulnerability disclosure; Cyber security; Dual use; Dual-use risk; Governance framework; Language model; Large language model; Model alignment; Responsible disclosure; Transferable jail-break; Vulnerability disclosure; Safety engineering},
	editor = {Shah M.S.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159693-4},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Quantum Photonics, Artif. Intell., Netw., QPAIN},
