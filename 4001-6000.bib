@CONFERENCE{Wu202517026,
	author = {Wu, Meng-Chen and Chin, Si-Chi and Wood, Tess and Goyal, Ayush and Sadagopan, Narayanan},
	title = {Incorporating Diverse Perspectives in Cultural Alignment: Survey of Evaluation Benchmarks Through A Three-Dimensional Framework},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {17026 - 17061},
	doi = {10.18653/v1/2025.emnlp-main.862},
	url = {https://www.scopus.com/pages/publications/105040266809?origin=resultslist},
	affiliations = {Amazon.com, United States},
	abstract = {Large Language Models (LLMs) increasingly serve diverse global audiences, making it critical for responsible AI deployment across cultures. While recent works have proposed various approaches to enhance cultural alignment in LLMs, a systematic analysis of their evaluation benchmarks remains needed. We propose a novel framework that conceptualizes alignment along three dimensions: Cultural Group (who to align with), Cultural Elements (what to align), and Awareness Scope (how to align: majority-focused vs. diversity-aware). Through this framework, we analyze 105 cultural alignment evaluation benchmarks, revealing significant imbalances: Region (37.9%) and Language (28.9%) dominate Cultural Group representation; Social and Political Relations (25.1%) and Speech and Language (20.9%) concentrate Cultural Elements coverage; and an overwhelming majority (97.1%) of datasets adopt majority-focused Awareness Scope approaches. In a case study examining AI safety evaluation across nine Asian countries (Section 5), we demonstrate how our framework reveals critical gaps between existing benchmarks and real-world cultural biases identified in the study, providing actionable guidance for developing more comprehensive evaluation resources tailored to specific deployment contexts. © 2025 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Asian countries; Case-studies; Cultural groups; Group representation; Language model; Real-world; Safety evaluations; Systematic analysis; Three dimensions; Three-dimensional frameworks; Alignment},
	editor = {Christodoulopoulos C. and Chakraborty T. and Rose C. and Peng V.},
