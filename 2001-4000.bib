}

@ARTICLE{Nurmagambetov2025119,
	author = {Nurmagambetov, Anuar and Nurmagambetov, Anet and Nurmagambetov, Amanzhol and Zhumabayeva, Aigerim},
	title = {ARTIFICIAL INTELLIGENCE AND LAW: PROCEDURAL SAFEGUARDS AND REGULATORY CHALLENGES IN KAZAKHSTAN; [ШТУЧНИЙ ІНТЕЛЕКТ І ПРАВО: ПРОЦЕСУАЛЬНІ ГАРАНТІЇ ТА РЕГУЛЯТОРНІ ВИКЛИКИ В КАЗАХСТАНІ]},
	year = {2025},
