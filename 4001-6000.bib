@CONFERENCE{Georgiou2025279,
	author = {Georgiou, Konstantinos and Liu, Longjian and Qi, Hairong and Zhao, Xiaopeng},
	title = {Trustworthy AI for Early Dementia Detection: Robust Feature Masking and Clinical Interpretability},
	year = {2025},
	journal = {Proceedings - 2025 IEEE/ACM International Conference on Connected Health: Applications, Systems and Engineering Technologies, CHASE 2025},
	pages = {279 - 283},
	doi = {10.1145/3721201.3721410},
	url = {https://www.scopus.com/pages/publications/105016212036?origin=resultslist},
	affiliations = {The University of Tennessee, Department of Electrical Engineering and Computer Science, Knoxville, TN, United States; Drexel University Dornsife School of Public Health, Department of Epidemiology and Biostatistics, Philadelphia, PA, United States; The University of Tennessee, Department of Biomedical Engineering, Knoxville, TN, United States},
	abstract = {Early dementia detection is pivotal for timely clinical interventions that can delay cognitive decline and improve patient quality of life. However, many machine learning models exhibit fragility by depending too heavily on a small subset of features, reducing both robustness and interpretability-particularly when data quality or completeness varies. To address this issue, we introduce a random feature masking strategy that deliberately obscures some inputs during training to encourage broader and more balanced feature usage. This approach improves resilience to missing or degraded data and enhances clinical trustworthiness by producing more interpretable outputs. We demonstrate our method on the Women's Health Initiative Memory Study (WHIMS) dataset using Transformer and Neural Ordinary Differential Equation (Neural ODE) models under two dataset configurations. Evaluations based on Macro F1 and SHAP-based feature importance show that random masking notably improves both robustness and interpretability, reducing dependence on dominant features while maintaining or boosting predictive performance. These results highlight the clinical potential of random feature masking in creating reliable, interpretable models for early dementia detection, pointing toward more trustworthy AI-driven healthcare solutions.  © 2025 ACM.},
	author_keywords = {Early Dementia Detection; Feature Importance; Interpretability; Neural ODE; SHAP; Transformer},
	keywords = {Learning systems; Neurodegenerative diseases; Patient treatment; Brain; Human engineering; Clinical interventions; Cognitive decline; Early dementia detection; Feature importance; Feature masking; Interpretability; Neural ordinary differential equation; Random features; SHAP; Transformer; Neural ODE; Feature extraction},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
