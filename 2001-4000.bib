	title = {PERAI: Privacy Enhancing & Responsible AI Framework for Data & AI Lifecycle},
	year = {2025},
	journal = {Proceedings - 2025 IEEE Symposium on Privacy Expectations, ISoPE 2025},
	pages = {32 - 37},
	doi = {10.1109/ISoPE67098.2025.00026},
	url = {https://www.scopus.com/pages/publications/105038338362?origin=resultslist},
	affiliations = {PrivaSapien, Bengaluru, India},
	abstract = {The rise of generative AI and large language models has transformed digital ecosystems but surfaced privacy, safety, and security concerns. Organizations must align privacy regulations and expectations with AI lifecycle complexity. Existing solutions are reactive and fragmented, failing to embed privacy by design across the AI pipeline. We present PERAI (Privacy Enhancing & Responsible AI), a framework that integrates privacy and governance into five stages of the data and AI lifecycle. In the data collection stage, PERAI applies Privacy Threat Modeling and Agentic DPIA to quantify privacy risks in structured and unstructured data, ensuring collection is purpose-specific, consent-aligned, and risk-scoped. In the data-in-use protection stage, PERAI mitigates privacy risks through context-aware anonymization and pseudonymization, with automated quantification workflows that balance privacy and utility. During model training and assessment, PERAI incorporates Privacy-Enhancing Technologies (PETs) such as differential privacy and synthetic data generation to reduce memorization and leakage risks, while Agentic Red Teaming introduces AI-driven adversarial evaluation to score risks across privacy, safety, and fairness. At inference, PERAI enables responsible inference via runtime privacy enforcement (prompt-level PII detection, privacy budgeting, and de-identification) and supports inference-time attack detection with governance-aligned audit trails. For agentic systems, PERAI adds protocol-level guardrails to detect tool and context attacks and to support trustworthy collaboration. By embedding risk quantification, mitigation, and policy enforcement across the lifecycle, PERAI provides a unified reference architecture for organizing privacy and governance controls for generative and agentic AI in enterprise settings. ©2025 IEEE.},
	author_keywords = {Agentic Systems; AI Agents; AI Governance; AI Red Teaming; Differential Privacy; Large Language Models; Privacy Threat Modeling; Privacy-Enhancing Technologies; Responsible AI; Synthetic Data},
	keywords = {Artificial intelligence; Budget control; Differential privacy; Life cycle; Modeling languages; Privacy by design; Privacy-preserving techniques; Public policy; Agentic system; AI agent; AI governance; AI red teaming; Differential privacies; Language model; Large language model; Privacy enhancing technologies; Privacy threat modeling; Privacy threats; Red teaming; Responsible AI; Synthetic data; Threat modeling; Risk assessment},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
