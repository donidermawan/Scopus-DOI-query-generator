@ARTICLE{Gupta2025,
	author = {Gupta, Shashank and Jaiswal, Rachana},
	title = {How can we improve the insurance industry decision-support system: integrating predictive analytics and behavioral insights through the INSPIRE framework},
	year = {2025},
	journal = {Information Discovery and Delivery},
	pages = {},
	doi = {10.1108/IDD-09-2024-0142},
	url = {https://www.scopus.com/pages/publications/105006409846?origin=resultslist},
	affiliations = {Department of Non-Financial Risk Technology, Morgan Stanley Advantage Services Private Limited, Mumbai, India; Department of Business Management, Hemvati Nandan Bahuguna Garhwal University, Srinagar, India},
	abstract = {Purpose: The purpose of this study is to address the persistent challenge of low insurance penetration by proposing a hybrid machine learning (ML) model to predict insurance purchase behavior and introducing the INSPIRE framework (INsurance Stakeholder-informed Predictive and Inclusive REcommendation). This framework bridges predictive analytics with stakeholder-informed behavioral insights to promote inclusive innovation aligned with multiple Sustainable Development Goals (SDGs). Design/methodology/approach: A mixed-methods design is used. The quantitative phase uses recursive feature elimination and LightGBM to develop a high-performing predictive model using an anonymized data set from a US-based insurer. The qualitative phase involves semi-structured interviews, thematic analysis and causal loop diagrams to explore the psychological, cultural and institutional factors influencing insurance adoption and resistance. The findings of this study were integrated to form the INSPIRE framework. Findings: The hybrid model demonstrated superior accuracy (AUC = 0.962), enabling effective segmentation and targeting. Qualitative findings revealed that trust, communication quality, risk awareness and peer influence adoption behavior. The INSPIRE framework consolidates these findings into a structured model that includes cognitive and structural enablers, mediating perceptions (transparency, engagement and reliability) and moderating variables (literacy, income, geography and gender) to explain adoption outcomes. Research limitations/implications: The study’s findings are based on data from a U.S. insurer, which limits their generalizability across different regions and regulatory settings. The qualitative insights are derived from a modest participant pool, which may not accurately reflect broader stakeholder perspectives. While the hybrid model is highly accurate, its interpretability remains limited, posing challenges for non-technical stakeholders. Future research should validate the model in diverse markets, enhance transparency using tools such as SHAP or LIME, and investigate long-term deployment outcomes. Additional work is needed to integrate behavioral insights into predictive logic and assess real-world impact on financial inclusion and policy effectiveness. Practical implications: This study provides a robust decision-support tool for insurers by integrating machine learning and behavioral insights through the INSPIRE framework. The hybrid model enhances targeting, improves customer segmentation, and supports the delivery of personalized insurance offerings. It enables ethical deployment of predictive analytics by addressing trust, literacy, and access barriers. Insurers can invest in simplified communication, digital infrastructure, and community engagement to increase adoption. The model enhances operational efficiency and aligns with several Sustainable Development Goals (SDGs) by promoting financial inclusion and equitable service delivery, particularly in underserved regions. This approach is beneficial for firms seeking scalable, responsible, and data-driven insurance innovation. Social implications: By identifying underserved groups and understanding behavioral barriers, the model supports SDG 1 (No Poverty), SDG 3 (Good Health), SDG 5 (Gender Equality), SDG 8 (Economic Growth), SDG 9 (Industry and Innovation), SDG 10 (Reduced Inequality) and SDG 16 (Justice and Strong Institutions). Through human-centered design, this study promotes inclusive access to financial safety nets and fosters trust in digital financial systems. Originality/value: This study contributes a novel conceptual framework that combines ML with human-centered insights to enable responsible and inclusive insurance innovation. The INSPIRE framework operationalizes behavioral drivers within a predictive model, bridging technical accuracy with stakeholder needs and expanding the application of predictive analytics within management and insurance research. This study also operationalizes multiple management theories and aligns technological advancement with practical strategies to enhance financial inclusion, responsible artificial intelligence use and stakeholder trust. © 2025, Emerald Publishing Limited.},
