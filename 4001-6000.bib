	pages = {161 - 188},
	doi = {10.1201/9781003564621-11},
	url = {https://www.scopus.com/pages/publications/105024173650?origin=resultslist},
	affiliations = {Balaji Institute of Management and Human Resource Management, Shri Balaji University, Pune, India; Department of Physiotherapy, Chandigarh University, Mohali, India; Department of Business Administration, Chaudhary Devi Lal University, Sirsa, India; Center of Online Learning, Manipal University, Manipal, India},
	abstract = {The rapid integration of artificial intelligence (AI) and data-driven decision-making in business management has revolutionized organizational efficiency, strategic planning, and competitive positioning. This study explores the intersection of AI-driven business intelligence and FemTech, focusing on the adoption of AI-powered pelvic floor muscle training tools among women. The research employs a mixed-methods approach, incorporating both qualitative and quantitative methodologies to analyze the behavioral, statistical, and managerial implications of AI-driven technologies in these domains. By examining AI’s role in predictive analytics, machine learning, and cognitive computing, this study underscores the transformation from intuition-based decision-making to algorithmic precision in modern business environments. It also highlights the rising prevalence of pelvic floor disorders among women in India and the potential of AI-enhanced FemTech solutions to bridge healthcare accessibility gaps. Through structured surveys, in-depth interviews, and case studies, the research evaluates technology acceptance patterns based on the Unified Theory of Acceptance and Use of Technology (UTAUT) framework. Findings indicate that AI-driven business intelligence significantly enhances operational efficiencies, while FemTech adoption remains influenced by digital literacy, accessibility, and regulatory frameworks. The study emphasizes the necessity for ethical AI governance, data privacy, and strategic ecosystem collaboration to maximize AI’s benefits in both business management and healthcare. This research provides critical insights for policymakers, business leaders, and healthcare professionals, advocating for AI-driven innovations to foster sustainable growth, improve healthcare accessibility, and enhance data-driven decision-making across industries. © 2026 selection and editorial matter, Swati Gupta, Sanjay Taneja, and J. Paulo Davim; individual chapters, the contributors.},
	keywords = {Artificial intelligence; Behavioral research; Competitive intelligence; Computation theory; Data privacy; Decision making; Enterprise resource management; Health care; Strategic planning; Business management; Business-intelligence; Competitive positioning; Data driven decision; Decisions makings; Mixed method; Organizational efficiency; Qualitative methodologies; Quantitative methodology; Training tools; Predictive analytics},
	publisher = {CRC Press},
	isbn = {978-104043583-0; 978-103291091-8},
	language = {English},
	abbrev_source_title = {Transforming Bus. Management with AI, BI, and Data-Driven Decision-Mak.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Rajesh202570,
	author = {Rajesh, J. Irudhaya and McMurray, Adela and Hordacre, Ann-Louise},
	title = {The Scope of Leader Involvement in Responsible Artificial Intelligence (rAI) Practices: A Conceptual Framework},
	year = {2025},
	journal = {Leadership and Leadership Development: Critical Perspectives and Contemporary Approaches},
	pages = {70 - 91},
	doi = {10.4324/9781032624976-5},
	url = {https://www.scopus.com/pages/publications/105001905456?origin=resultslist},
	affiliations = {Human Resource Management & Program, College of Business, Government and Law, United Kingdom; RMIT University, Australia; Swinburne University Australia, Australia; Flinders University, Australia},
	abstract = {Despite greater emphasis on leadership’s role in responsible artificial intelligence (rAI), a systematic understanding of the extent to which leaders engage in rAI practices is lacking. In this chapter, we aim to close this gap and develop a conceptual framework that explains the roles that leaders can play while they are engaged in rAI practices. Using Quinn’s competing values leadership model, we identified that leaders have a greater scope for involvement in human relations, open systems, internal processes, and rational goals, and thus the capability to play eight different roles in rAI. Additionally, we present an integrative framework by COMexploring the individual-level determinants of leader involvement in rAI practices against the backdrop of the theories of reasoned action and planned behavior. The conceptual framework offers key antecedents of leader involvement behavior in rAI to assist top management in artificial intelligence-enabled organizations in identifying and developing leaders who can champion rAI practices. © 2025 selection and editorial matter, Christian Harrison; individual chapters, the contributors.},
	publisher = {Taylor and Francis},
