	journal = {Modern Perspectives on Artificial Intelligence and Law},
	pages = {27 - 36},
	doi = {10.4018/979-8-3693-9576-9.ch002},
	url = {https://www.scopus.com/pages/publications/105015291245?origin=resultslist},
	affiliations = {University of Western Macedonia, Greece},
	abstract = {In the rapidly evolving landscape of artificial intelligence (AI), governance, legislation, and regulation have become crucial yet increasingly ambiguous. This chapter introduces the concept of “AI legislationship,” a term coined to describe the current state of AI governance, where the boundaries between regulation and innovation are blurred. Governance, legislation, and regulation—each essential for societal function—are studied here both independently and in relation to one another, focusing on how these abstract concepts are reshaped in response to AI. We explore the challenges of regulatory lag, compliance costs, resistance to change, and enforcement issues, highlighting the transitional phase where AI technologies are advancing more rapidly than legal frameworks can accommodate. This chapter argues that addressing these issues requires a multi-faceted approach combining legal, ethical, and collaborative efforts to ensure AI development is both innovative and responsible. © 2025, IGI Global Scientific Publishing. All rights reserved.},
	keywords = {Artificial intelligence; Ethical technology; 'current; Abstract concept; Artificial intelligence technologies; Compliance costs; Legal frameworks; Multi-faceted approach; Resistance to change; Societal functions; Transitional phase; Regulatory compliance},
