@CONFERENCE{Barford2025,
	author = {Barford, Lee},
	title = {Compliance is Necessary but Not Sufficient in AI},
	year = {2025},
	journal = {ETHICS 2025 - 2025 IEEE International Symposium on Ethics in Engineering, Science, and Technology: Emerging Technologies, Ethics, and Social Justice},
	pages = {},
	doi = {10.1109/ETHICS65148.2025.11098397},
	url = {https://www.scopus.com/pages/publications/105014504245?origin=resultslist},
	affiliations = {Dept. of Computer Science and Engineering, University of Nevada, Reno, Reno, NV, United States},
	abstract = {Many artificial intelligence (AI) developers, managers, and other professionals in positions related to bringing AI applications and autonomous systems to market express the desire to have laws and regulations governing AI established quickly so that they can comply with these and not have to do the labor and emotional work of ethics, shouldering “the burden of AI ethics.” However, the vast majority of firms surveyed do not take a compliance-only approach to ethics. This paper examines some of the reasons why firms have adopted values-based ethics as integral parts of their compliance with laws and regulations rather than having compliance policies alone. It will be argued that these reasons become more, not less, compelling in the context of the swift evolution of the ethical landscape around AI. In particular, it is argued that organizations that provide AI products and services that embrace integrity-based or values-based ethics are better able to navigate the rapidly changing AI landscape, deal with catastrophic failures of autonomous systems, and develop in some of their people the sort of practical, integrated, technical, business, and ethical wisdom needed to bring the benefits of AI to humanity while minimizing its harms. In part, this is due to the mutual reinforcement that values-based ethics has with Values-Based Engineering of AI. ©2025 IEEE.},
	author_keywords = {artificial intelligence; autonomous systems; Ethics; philosophical considerations; safety management},
	keywords = {Behavioral research; Ethical technology; Laws and legislation; Autonomous system; Catastrophic failures; Integral part; Intelligence products; Intelligence services; Laws and regulations; Philosophical consideration; Product and services; Safety management; Value-based; Artificial intelligence},
	editor = {Cheong M. and Herkert J. and Zhu Q. and Love H.A.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
