@ARTICLE{Wang2025,
	author = {Wang, Hao and Blok, Vincent},
	title = {Why putting artificial intelligence ethics into practice is not enough: Towards a multi-level framework},
	year = {2025},
	journal = {Big Data and Society},
	volume = {12},
	number = {2},
	pages = {},
	doi = {10.1177/20539517251340620},
