	affiliations = {Frontier Research Center, Toyota Motor Corporation, Susono, Japan; The University of Tokyo, Bunkyo-ku, Japan},
	abstract = {The increasing prominence of AI ethics and governance has led to an increase of principles and guidelines. Consequently, AI developers and users require not only technical expertise but also a robust understanding of responsible AI and its governance. To effectively promote AI governance, it is crucial to facilitate knowledge acquisition and motivate stakeholders. Serious games have proven valuable tools for fostering an understanding of complex social issues. This study presents the design and implementation of a card game and accompanying workshop aimed at cultivating awareness of responsible AI. Within the game, participants assume the roles of members of a company’s AI strategy team, tasked with balancing AI performance goals with ethical considerations while responding to dynamic events and managing resources. Our experimental results demonstrate the effectiveness of the workshop in raising awareness of responsible AI through active engagement with the card game. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {AI governance; Responsible AI; serious games},
	keywords = {Game design; AI governance; Card games; Design and implementations; Dynamic events; Ethical considerations; Managing resources; Performance; Responsible AI; Social issues; Technical expertise; Ethical technology},
