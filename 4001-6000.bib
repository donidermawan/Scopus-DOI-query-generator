@CONFERENCE{Kang2025138,
	author = {Kang, Byeong and Yang, Wenli and Amin, Muhammad Bilal and Huang, Ziqiu},
	title = {Orchestrating Trust: A Framework for Safe and Auditable AI through Governance by Design},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Agentic AI, ICA 2025},
	pages = {138 - 143},
	doi = {10.1109/ICA67499.2025.00040},
	url = {https://www.scopus.com/pages/publications/105033362855?origin=resultslist},
	affiliations = {University of Tasmania, School of Ict, Hobart, Australia},
	abstract = {AI has reached a pivotal moment where advances due to the usage of LLMs and autonomous systems offer unprecedented opportunities while amplifying risks of opacity, system failures, and ethical misalignment. Current approaches, from monolithic AI architectures to generative AI systems, face growing criticism for risks within systems that systematically evade auditing and governance. This paper introduces 'orchestrated intelligence' as an alternative paradigm and presents a technical framework that extends beyond abstract principles towards machine-enforceable architecture. Our approach is based on nine foundational criteria establishing comprehensive requirements for safe and auditable AI. This framework implements a two-layered approach that separates the governance from execution through distinct control and integration planes, effectively containing risks whilst ensuring decision transparency. Building on foundations from cognitive science and symbolic AI, the framework converts ethical principles into practical safeguards through three key mechanisms: (i) symbolic gatekeeping that prevents system regression; (ii) blockchain anchored records that create permanent audit trails; and bidirectional human-in-the-loop processes that ensure auditing. Our approach differentiates between the abstract principles of AI orchestration and their concrete realisation, offering a blueprint that employs existing AI technologies to develop a supervisory technological layer for coordination and governance. Through this approach, we establish that generative AI risks arise from inadequate architectural design rather than fundamental technological limitations, thereby repositioning AI from autonomous operator to collaborative partner and defining a concrete pathway towards auditable general AI that remains robust, human-centered, and societally aligned.  © 2025 IEEE.},
	author_keywords = {AI Safety; Audit Traceability; Control Plane; Governance; Orchestrated Intelligence},
	keywords = {Architectural design; Artificial intelligence; Ethical technology; Systems analysis; 'current; AI safety; AI systems; Audit traceability; Control planes; Governance; Monolithics; Orchestrated intelligence; System failures; Technical frameworks; Concretes},
	correspondence_address = {B. Kang; University of Tasmania, School of Ict, Hobart, Australia; email: byeong.kang@utas.edu.au},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833155634-1},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Agentic AI, ICA},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

