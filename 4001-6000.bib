	affiliations = {SR University, School of Computer Science & Artificial Intelligence, Telangana, Warangal, 506371, India},
	abstract = {The research given introduces a Hybrid Explainability Framework that aims to strike a balance between predictive performance and explainability within the realm of high-stakes decisions (compliance with various regulations and law enforcement). Albeit correct, the traditional black-box models are not transparent enough and therefore represent a risk to sensitive uses. The proposed model would use a combination of several classifiers, including Random Forest, Gradient Boosting, SVM and Logistic Regression, as a soft-voting hybrid ensemble, to which the SHAP and LIME-based feature attributions of post-hoc explanation would be added. The model is used on the Adult Income data set implemented using Google Colab and shows a better result in both accuracy (87.2), precision (0.81), recall (0.70) and error (lowest MAE, RMSE, MAPE, and highest R 2). Its consistency and reliability are proved with visualization tools such as heatmaps and lines graphs. The results clarify that the suggested framework does not only enhance the robustness of predictions, but also offers clear and readable explanations because of which, it may be considered a solid and responsible AI solution to regulated settings.  © 2025 IEEE.},
	author_keywords = {Explainable AI; Hybrid Ensemble; Law Enforcement; Regulatory Compliance; SHAP},
	keywords = {Artificial intelligence; Decision trees; Law enforcement; Learning systems; Lime; Logistic regression; Visualization; Black box modelling; Decision supports; Explainable AI; Gradient boosting; Hybrid ensemble; Logistics regressions; Predictive performance; Random forests; SHAP; Soft voting; Decision support systems; Regulatory compliance},
