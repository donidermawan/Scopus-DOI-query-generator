@BOOK{Mahi2025271,
	author = {Mahi, Ensieh and Crawford, Jason and Strand, Magnus},
	title = {Regulation, governance, and AI systems},
	year = {2025},
	journal = {Leading Digital Transformation: Management, Governance and Control},
	pages = {271 - 288},
