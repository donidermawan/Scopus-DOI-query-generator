	year = {2025},
	journal = {2025 9th International Conference on System Reliability and Safety, ICSRS 2025},
	pages = {87 - 94},
	doi = {10.1109/ICSRS68021.2025.11422167},
	url = {https://www.scopus.com/pages/publications/105036299701?origin=resultslist},
	affiliations = {DHBW Ravensburg, Friedrichshafen, Germany; University of Siegen, Siegen, Germany; ifm electronic gmbh, Tettnang, Germany; ifm electronic gmbh, Essen, Germany},
	abstract = {Traditional safety standardization, as given by IEC 61508 and ISO 26262, is based on the V-model paradigm. It ensures, that requirements are fulfilled and the resulting system is ready for its dedicated use. This is particularly important in the certification process. Autonomous systems, such as mobile robots and self-driving cars, rely on AI and are considered safety critical systems, as they are used in safety relevant contexts. The key question is how to develop an AI-based safety-critical system. The development process of AI-based models shows an iterative structure. This process is repeated until a trained model passes all prescribed tests. However, this approach is inverse to the standard V-model and thus, incompatible for safety engineering. In this context, standardization can assist in making emerging technologies, such as AI, possible, by defining a development framework, demonstrating AI and functional safety compliance. In this document we investigate ISO/IEC TR 5469, the first step towards standardizing AI for FuSa on an international level. We discover that the central question is still unresolved. Hence, this manuscript motivates further endeavors to provide solutions that make AI-based safety-critical systems possible.  © 2025 IEEE.},
	author_keywords = {AI safety framework; artificial intelligence (AI); certification; Functional safety (FuSa); IEC 61508; ISO 26262; machine learning (ML); safety-critical system (SCS); standardization},
	keywords = {Automobile safety devices; Autonomous vehicles; Computer vision; Intelligent robots; ISO Standards; Iterative methods; Learning systems; Mobile robots; Regulatory compliance; Safety engineering; Security systems; Artificial intelligence; Artificial intelligence safety framework; Certification; Functional Safety; IEC 61508; ISO 26262; Machine learning; Machine-learning; Safety critical systems; Safety-critical system; Standardization},
