	year = {2025},
	journal = {2025 2nd International Conference on Artificial Intelligence and Teacher Education, ICAITE 2025},
	pages = {349 - 354},
	doi = {10.1109/ICAITE68636.2025.11442309},
	url = {https://www.scopus.com/pages/publications/105036288872?origin=resultslist},
	affiliations = {School of Foundational Studies and Education, Mapua University, Department of Liberal Arts, Manila, Philippines; School of Foundational Studies and Education, Mapua University, Center for Teaching and Learning, Manila, Philippines; Centro Escolar University, Social Work Department, Manila, Philippines},
	abstract = {This study explores how psychological safety influences students' engagement with generative artificial intelligence (GenAI) in higher education. Drawing on Edmondson's psychological safety framework [1], a qualitative research design was employed to capture the nuanced experiences of 17 university students aged 18-23 who had used GenAI tools for over one year. Data were collected through an open-ended survey validated by experts in AI education and academic ethics and analyzed using a systematic thematic analysis approach. Five themes emerged: strategic use amid ethical tension, where students balanced AI's benefits with academic integrity concerns, often concealing usage to avoid detection; social navigation, reflecting supportive peer networks alongside judgment and stigma; institutional ambivalence, highlighting inconsistent policies that generated uncertainty; error navigation and learning from mistakes, where constructive feedback fostered growth while punitive responses reinforced secrecy; and voice in academic dialogue, emphasizing the role of inclusive classroom cultures in enabling open discussion. The findings indicate that high psychological safety promotes transparent, ethical, and reflective engagement with GenAI, whereas low psychological safety encourages covert and risk-laden use. Institutional clarity, peer support, and respectful pedagogical environments emerged as critical enablers of responsible AI adoption. This study contributes to the growing discourse on the socio-emotional dimensions of GenAI integration in higher education and underscores the need for policies and practices that balance innovation with ethical safeguards.  © 2025 IEEE.},
	author_keywords = {academic integrity; generative AI; higher education; psychological safety; student engagement},
	keywords = {Artificial intelligence; Education computing; Ethical technology; Safety engineering; Teaching; Academic integrity; Artificial intelligence tools; Generative AI; High educations; Psychological safety; Qualitative research; Research designs; Student engagement; Thematic analysis; University students; Students},
	correspondence_address = {J.C.D. Castillo; School of Foundational Studies and Education, Mapua University, Department of Liberal Arts, Manila, Philippines; email: jcdccastillo@mapua.edu.ph},
