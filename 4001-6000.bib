	title = {Student 'Centaur' Competencies: Human-AI Synergy as the Foundation for Success in the Digital University of the Future},
	year = {2025},
	journal = {Proceedings of the 2025 International Conference on Quality Management, Transport and Information Security, Information Technologies, QM and TIS and IT 2025},
	pages = {158 - 160},
