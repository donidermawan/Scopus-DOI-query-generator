@BOOK{Mukherjee2025201,
	author = {Mukherjee, Baidya Nath},
	title = {Navigating AI Governance: National and International Legal and Regulatory Frameworks},
	year = {2025},
	journal = {Navigating the Intersection of AI Policy, Technology, and Governance},
	pages = {201 - 224},
	doi = {10.4018/979-8-3373-1210-1.ch008},
	url = {https://www.scopus.com/pages/publications/105013924656?origin=resultslist},
	affiliations = {AURO University, India},
	abstract = {The rapid growth of Artificial Intelligence (AI) has driven global discussions on regulatory frameworks to ensure ethical and responsible use. Nationally, AI governance varies: the European Union’s AI Act prioritizes transparency and accountability, while the United States adopts a sector- specific approach balancing innovation and risk management. Internationally, organizations like the United Nations, OECD, and GPAI aim to harmonize AI governance, addressing risks such as bias, privacy violations, and misuse while fostering global collaboration. This article examines these regulatory strategies, highlighting convergence and divergence across jurisdictions. It underscores the need for a balanced approach that promotes AI innovation while safeguarding ethical standards and public interest. Ultimately, it advocates for a collaborative global effort to develop adaptable regulatory strategies that evolve with AI technologies, ensuring responsible and effective governance. © 2025 by IGI Global Scientific Publishing. All rights reserved.},
