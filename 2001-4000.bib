@ARTICLE{Lowman2025104,
	author = {Lowman, Rodney L.},
	title = {CONSULTANTS’ AND MANAGERS’ ETHICAL AND LEGAL RESPONSIBILITIES IN ARTIFICIAL INTELLIGENCE APPLICATIONS},
