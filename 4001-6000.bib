@ARTICLE{ANDREANGELI2025251,
	author = {ANDREANGELI, Arianna},
	title = {Pricing Algorithms and the Artificial Intelligence Act: Navigating Unchartered Waters between Competition Law and the Mainstream Regulation of Autonomous Technologies},
	year = {2025},
	journal = {Legal Issues of Economic Integration},
	volume = {52},
	number = {3},
