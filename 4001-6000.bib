	title = {The Role of Robotic Response Speed in De-anthropomorphisation of AI Chatbots},
	year = {2025},
	journal = {International Symposium on Technology and Society, Proceedings},
	pages = {},
	doi = {10.1109/ISTAS65609.2025.11269646},
	url = {https://www.scopus.com/pages/publications/105030543373?origin=resultslist},
	affiliations = {Heriot-Watt University, Edinburgh, United Kingdom},
	abstract = {As AI-driven chatbots become increasingly sophisticated, users become more likely to attribute human-like qualities to them, overestimating their intelligence or emotional understanding, with implications for trust and transparency of the systems. To counter this, we investigate the impact of variations in response speed to different queries on deanthropomorphisation, i.e. the deliberate design of chatbot interactions to highlight their artificial nature. We present two contrasting models: a Standard Chatbot with uniform response timing, and a Dynamic Chatbot that adapts its response latency based on query type. Specifically, factual queries are answered swiftly to reinforce computational efficiency, while emotional or opinion-based queries are met with intentional delays and disclaimers to indicate the chatbot’s artificial nature. A user study employing survey-based evaluation revealed that delayed emotional responses combined with clear disclaimers reduced anthropomorphic misattributions. These findings underscore how design elements like timing and transparency shape user perception of AI, suggesting that intentional deanthropomorphism can support more ethical, transparent, and accountable AI-human interaction. We conclude with future design considerations, advancing the broader conversation around responsible AI design and its social implications. ©2025 IEEE.},
	author_keywords = {AI Transparency; Anthropomorphism; Chatbots; Ethical AI Design; Human-AI Interaction; Response Timing},
	keywords = {Behavioral research; Computational efficiency; Ethical aspects; Human computer interaction; Query processing; Robotics; Transparency; AI transparency; Anthropomorphism; Chatbots; Ethical AI design; Human like; Human-AI interaction; Query types; Response speed; Response timings; User study; Chatbots},
	correspondence_address = {A. Manoj; Heriot-Watt University, Edinburgh, United Kingdom; email: am4067@hw.ac.uk},
