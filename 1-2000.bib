@ARTICLE{Lafta2025888,
	author = {Lafta, Nabeel A. and Hreshee, Saad S. and Abdul-Rahaim, Laith A.},
	title = {Hybrid Model for Real-Time 3D Localization of Drones from a Single Camera via YOLO and ResNet-Transformer},
	year = {2025},
	journal = {International Journal of Intelligent Engineering and Systems},
	volume = {18},
	number = {10},
	pages = {888 - 900},
	doi = {10.22266/ijies2025.1130.56},
	url = {https://www.scopus.com/pages/publications/105019543266?origin=resultslist},
	affiliations = {Department of Electrical Engineering, University of Babylon, Iraq},
	abstract = {The increasing use of Drone in civilian and security environments pose new and difficult challenges to their timely detection and precise localization in the case of unknown or hostile Drone. This paper presents a vision-based AI framework for the real time estimation of the 3D spatial coordinates (x, y, z) of a drone using a sole monocular camera. The hybrid framework aims to utilize best-in-class deep learning components for the detection and localization of unknown or hostile Drones. The proposed framework includes three important modules. YOLOv8 achieves drone detection on the video frame, ResNet18 extracts deep visual features from the cropped drone picture, and a Transformer encoder improves depth (z-axis) estimation by modeling visual context. Finally, a geometric transformation based on the related camera field of view (FOV) parameters is used to convert pixel-based coordinates in to real metric units. A unique real-world dataset was collected using a DJI Phantom 3 drone at varying distances and angles, with a properly recorded ground-truth depth value for supervised learning. Experimental results showed that the developed model achieved a mean 3D localization error lower than 0.5 m, showing promising accuracy and applicability in smart surveillance systems, without the use of additional sensors. © This article is licensed under a Creative Commons Attribution-ShareAlike 4.0 International License. License details: https://creativecommons.org/licenses/by-sa/4.0/},
	author_keywords = {Drone detection; Localization; ResNet18; Transformer encoder; YOLOv8},
