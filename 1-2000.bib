@ARTICLE{Kirch2025,
	author = {Kirch, Nathalie Maria and Hebenstreit, Konstantin and Samwald, Matthias},
	title = {Medical triage as an AI ethics benchmark},
	year = {2025},
	journal = {Scientific Reports},
	volume = {15},
