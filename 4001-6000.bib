	year = {2025},
	journal = {Proceedings of the 2025 14th International Conference on System Modeling and Advancement in Research Trends, SMART 2025},
	pages = {48 - 57},
	doi = {10.1109/SMART66937.2025.11389227},
	url = {https://www.scopus.com/pages/publications/105035375104?origin=resultslist},
	affiliations = {Teerthanker Mahaveer University, Department of Computer Science Engineering, Moradabad, India},
	abstract = {Recent developments in Large Language Models (LLMs) have shown extraordinary development in reasoning, symbolic abstraction, and language comprehension. Nonetheless, these models are still not grounded in sequential decisionmaking, and this limits their effectiveness in exploration of long-horizon, feedback-driven environments. Conversely, Reinforcement Learning (RL) delineates a principled framework for maximizing a reward through trial and error, but does not have the structured reasoning or language-based systems interpretability. This study presents RL-LLM, a unified theoretical framework that incorporates LLM-based semantic priors, verifier-driven horizon partitioning, and bounded symbolic rollouts in a KLregularized RL objective. The framework supports verifiable and interpretable reasoning while retaining familiar convergence and bias bounds from classical RL results. This paper presents, rather than heuristic or empirical blends, a formal RL structure that supports safe and efficient long-horizon reasoning by combining these two approaches- the semantic power of LLMs with the grounded optimization of RL. This approach results theoretically in improvements across efficiency, verifiability, and interpretability, opening a door as a foundation for scalable, verifiable, and trustworthy AI systems to be self-reflective and auditable. This work remains conceptual and theoretical as it is, and provides potential directions for scalable, verifiable, and trust oward intelligent agents for future empirical work and utilization. © 2025 IEEE.},
	author_keywords = {KL Regularization; Large Language Models; Long-Horizon Reasoning; Policy Optimization; Reinforcement Learning; Safe and Interpretable AI; Symbolic Reasoning; Verifier-Driven Learning},
	keywords = {Computation theory; Decision making; Heuristic methods; Machine learning; Optimization; Semantics; KL regularization; Language model; Large language model; Long-horizon reasoning; Policy optimization; Regularisation; Reinforcement learnings; Safe and interpretable AI; Symbolic reasoning; Verifier-driven learning; Intelligent agents},
