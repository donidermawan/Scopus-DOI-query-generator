@ARTICLE{Waqas2026237,
	author = {Waqas, Muhammad and Qadri, Usman Ahmad},
	title = {When Consumer Autonomy is Compromised: Adopting a Dual-Type View to Understand AI-Driven Marketing and Its Impact on Young Consumers’ Ethical Behavior},
	year = {2026},
	journal = {Journal of Business Ethics},
	volume = {206},
