	keywords = {Artificial intelligence; Commerce; Diseases; Ethical technology; Information management; Information systems; Marketing; Patient treatment; AI ethic; Black boxes; Chronic disease management; Customized information; Explainable AI (XAI); Health industry; Healthcare marketing; Intelligence models; Patient engagement; Trust; Transparency},
