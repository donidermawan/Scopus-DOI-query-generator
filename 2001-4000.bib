	title = {CASE: An Agentic AI Framework for Enhancing Scam Intelligence in Digital Payments},
	year = {2025},
	journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
	number = {2025},
	pages = {2177 - 2183},
